@page "/scan/product/{ProductId}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using BootManager.Application.Inventory.Contracts
@using BootManager.Application.Inventory.DTOs
@using BootManager.Application.Storage.Services
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims

@inject IProductService ProductService
@inject IStockService StockService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Product scannen</PageTitle>

<div class="scan-product-container">
    <h2>Productwerkcontext</h2>

    @if (_loading)
    {
        <div class="alert alert-info">Product laden...</div>
    }
    else if (_product == null)
    {
        <div class="alert alert-danger">Product niet gevonden.</div>
        <button class="btn btn-secondary" @onclick="GoBack">Terug naar scannen</button>
    }
    else
    {
        <!-- Product identity card: primary focus -->
        <div class="scan-product-card card scan-product-header">
            <div class="card-body">
                <h3 class="card-title">@_product.Name</h3>
                @if (_product.Code != null)
                {
                    <p class="text-muted">Code: <code>@_product.Code.Value</code></p>
                }
                <p class="text-muted">Eenheid: @_product.DefaultUnitName</p>
            </div>
        </div>

        <!-- Stock per location card: main content - clickable for direct mutation -->
        @if (_stockLocations != null && _stockLocations.Count > 0)
        {
            <div class="scan-product-card card scan-product-stock">
                <div class="card-body">
                    <h5 class="card-title">Voorraad per locatie</h5>
                    <div class="stock-list">
                        @foreach (var stock in _stockLocations)
                        {
                            <button type="button" class="btn btn-outline-primary w-100 text-start p-3 mb-2 stock-item-button" @onclick="() => NavigateToMutateLocation(stock)">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong>@stock.StorageAreaName</strong><br />
                                        <span class="text-muted">@stock.StorageLocationName</span>
                                    </div>
                                    <span class="badge bg-primary">@stock.Quantity @stock.DefaultUnitName</span>
                                </div>
                            </button>
                        }
                    </div>
                </div>
            </div>

            <!-- Secondary action: add stock to another location -->
            <div class="scan-product-secondary">
                <button class="btn btn-outline-primary d-grid" @onclick="OpenAddStockFlow">
                    Voorraad op andere locatie toevoegen
                </button>
            </div>
        }
        else
        {
            <div class="scan-product-card card alert-warning">
                <div class="card-body">
                    <h5>Geen actieve voorraad</h5>
                    <p class="text-muted">Dit product is bekend maar momenteel niet op voorraad.</p>
                </div>
            </div>

            <!-- Primary action: add stock when no stock exists -->
            <div class="scan-product-actions">
                <button class="btn btn-primary btn-lg d-grid" @onclick="OpenAddStockFlow">
                    Voorraad toevoegen
                </button>
            </div>
        }

        <!-- Back and help area -->
        <div class="scan-product-footer">
            <button class="btn btn-outline-secondary" @onclick="GoBack">
                Terug naar scannen
            </button>
        </div>
    }
</div>

@code {
    [Parameter]
    public string ProductId { get; set; } = string.Empty;

    private ProductDto? _product;
    private List<StockDto>? _stockLocations;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated != true)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        if (!Guid.TryParse(ProductId, out var productId))
        {
            _product = null;
            _loading = false;
            return;
        }

        try
        {
            var productResult = await ProductService.GetByIdAsync(productId);
            if (productResult.Success && productResult.Data != null)
            {
                _product = productResult.Data;

                // Load stock for this product
                var stockResult = await StockService.GetActiveStocksByProductAsync(productId);
                _stockLocations = stockResult.Success && stockResult.Data != null
                    ? stockResult.Data.ToList()
                    : new();
            }
        }
        catch
        {
            _product = null;
        }
        finally
        {
            _loading = false;
        }
    }

    private void NavigateToMutateLocation(StockDto stock)
    {
        if (_product == null)
            return;

        NavigationManager.NavigateTo($"/scan/product/{_product.Id}/mutate/{stock.StorageLocationId}");
    }

    private void OpenAddStockFlow()
    {
        if (_product == null)
            return;

        NavigationManager.NavigateTo($"/scan/product/{_product.Id}/add-stock");
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/scan");
    }
}
