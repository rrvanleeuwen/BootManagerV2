@page "/logbook/entries/{EntryId:int}/details"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Owner")]
@using BootManager.Application.Logbook.DTOs
@using BootManager.Application.Logbook.Services
@using BootManager.Web.Helpers
@inject ILogbookEntryDetailService DetailService
@inject NavigationManager Navigation

<div class="mb-4">
    <button class="btn btn-sm btn-outline-secondary mb-3" @onclick="TerugNaarLogboek">← Terug naar logboek</button>
    <h1 class="mb-1">Logboekregel accordering</h1>
</div>

@if (_loading)
{
    <p>Laden…</p>
}
else if (_detail == null)
{
    <div class="alert alert-warning">Logboekregel niet gevonden.</div>
}
else
{
    <!-- Context-header: titel, reis, status, logboektijd, logtijdvak -->
    <div class="card mb-4 border-secondary">
        <div class="card-body">
            <div class="row g-4">
                <div class="col-md-6">
                    <div class="mb-3">
                        <span class="text-muted small">Reisnaam</span>
                        <div class="h5 mb-0">@_detail.TripName</div>
                    </div>
                    <div class="mb-0">
                        <span class="text-muted small">Status</span>
                        <div>
                            @if (_detail.IsDraft)
                            {
                                <span class="badge bg-warning text-dark">Concept</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Akkoord</span>
                            }
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <span class="text-muted small">Logboektijd (lokaal)</span>
                        <div class="h5 mb-0">@BoordtijdHelper.NaarLokaal(_detail.EntryTimeUtc).ToString("dd-MM-yyyy HH:mm")</div>
                    </div>
                    <div class="mb-0">
                        <span class="text-muted small">Logtijdvak (lokaal)</span>
                        <div>
                            @if (_detail.PeriodStartUtc.HasValue)
                            {
                                @BoordtijdHelper.NaarLokaal(_detail.PeriodStartUtc.Value).ToString("HH:mm")
                                <span class="text-muted">—</span>
                                @BoordtijdHelper.NaarLokaal(_detail.PeriodEndUtc).ToString("HH:mm")
                            }
                            else
                            {
                                <span class="text-muted">Onbekend</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Waarschuwing: geen geldige startperiode -->
    @if (!_detail.PeriodStartUtc.HasValue)
    {
        <div class="alert alert-warning" role="alert">
            <strong>Waarschuwing:</strong> Geen geldige startperiode beschikbaar. Controleer de logboekgegevens.
        </div>
    }
    else if (HasNoMeasurementData(_detail))
    {
        <div class="alert alert-info" role="alert">
            <strong>Geen meetdata in dit logtijdvak.</strong> Vul deze logregel handmatig aan voordat u deze accordeert.
        </div>
    }

    <!-- Logregelwaarden -->
    @if (_detail.SavedValues != null)
    {
        <div class="card mb-4 border-info">
            <div class="card-header fw-semibold bg-light-info">Logregelwaarden</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-3">
                        <span class="text-muted small">Barometer</span>
                        <div>@(_detail.SavedValues.BaroPressure.HasValue ? $"{_detail.SavedValues.BaroPressure.Value:F1} hPa" : "Nog niet ingevuld")</div>
                    </div>
                    <div class="col-md-3">
                        <span class="text-muted small">Log</span>
                        <div>@(_detail.SavedValues.LogValue.HasValue ? $"{_detail.SavedValues.LogValue.Value:F2} nm" : "Nog niet ingevuld")</div>
                    </div>
                    <div class="col-md-3">
                        <span class="text-muted small">Koers</span>
                        <div>@(_detail.SavedValues.Course.HasValue ? $"{_detail.SavedValues.Course.Value}°" : "Nog niet ingevuld")</div>
                    </div>
                    <div class="col-md-3">
                        <span class="text-muted small">Gem. SOG</span>
                        <div>@(_detail.SavedValues.AverageSogKnots.HasValue ? $"{_detail.SavedValues.AverageSogKnots.Value:F1} kn" : "Nog niet ingevuld")</div>
                    </div>

                    <div class="col-md-3">
                        <span class="text-muted small">Wind</span>
                        <div>@(string.IsNullOrEmpty(_detail.SavedValues.WindDescription) ? "Nog niet ingevuld" : _detail.SavedValues.WindDescription)</div>
                    </div>
                    <div class="col-md-3">
                        <span class="text-muted small">GPS-status</span>
                        <div>@(string.IsNullOrEmpty(_detail.SavedValues.GpsStatus) ? "Nog niet ingevuld" : _detail.SavedValues.GpsStatus)</div>
                    </div>
                    <div class="col-md-3">
                        <span class="text-muted small">Breedtegraad</span>
                        <div>@(_detail.SavedValues.Latitude.HasValue ? $"{_detail.SavedValues.Latitude.Value:F5}" : "Nog niet ingevuld")</div>
                    </div>
                    <div class="col-md-3">
                        <span class="text-muted small">Lengtegraad</span>
                        <div>@(_detail.SavedValues.Longitude.HasValue ? $"{_detail.SavedValues.Longitude.Value:F5}" : "Nog niet ingevuld")</div>
                    </div>

                    @if (!string.IsNullOrEmpty(_detail.SavedValues.Remarks))
                    {
                        <div class="col-12">
                            <span class="text-muted small">Opmerkingen</span>
                            <div>@_detail.SavedValues.Remarks</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <!-- Meetdata in dit logtijdvak -->
    @if (_detail.PeriodStartUtc.HasValue)
    {
        <div class="card mb-4 border-success">
            <div class="card-header fw-semibold bg-light-success">Meetdata in dit logtijdvak</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="text-center">
                            <div class="h4 mb-1">@GetSampleCount(_detail.Positie)</div>
                            <div class="text-muted small">Positie-samples</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="text-center">
                            <div class="h4 mb-1">@GetSampleCount(_detail.Beweging)</div>
                            <div class="text-muted small">COG/SOG-samples</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="text-center">
                            <div class="h4 mb-1">@GetSampleCount(_detail.Heading)</div>
                            <div class="text-muted small">Heading-samples</div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="text-center">
                            <div class="h4 mb-1">@GetSampleCount(_detail.Wind)</div>
                            <div class="text-muted small">Wind-samples</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="text-center">
                            <div class="h4 mb-1">@GetSampleCount(_detail.Diepte)</div>
                            <div class="text-muted small">Diepte-samples</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="text-center">
                            <div class="h4 mb-1">@GetSampleCount(_detail.WaterTemperatuur)</div>
                            <div class="text-muted small">Watertemperatuur-samples</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sampletabellen (secundair) -->
        <h5 class="mt-4 mb-3">Samples</h5>

        @if (_detail.Positie?.Samples.Count > 0)
        {
            <div class="card mb-3">
                <div class="card-header fw-semibold">Positie — samples (@_detail.Positie.Samples.Count)</div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered mb-0">
                            <thead class="table-light"><tr><th>Tijd (lokaal)</th><th>Lat.</th><th>Long.</th></tr></thead>
                            <tbody>
                                @foreach (var s in _detail.Positie.Samples)
                                {
                                    <tr>
                                        <td>@BoordtijdHelper.NaarLokaal(s.TijdUtc).ToString("HH:mm:ss")</td>
                                        <td>@s.Latitude.ToString("F5")</td>
                                        <td>@s.Longitude.ToString("F5")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

        @if (_detail.Beweging?.Samples.Count > 0)
        {
            <div class="card mb-3">
                <div class="card-header fw-semibold">COG/SOG — samples (@_detail.Beweging.Samples.Count)</div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered mb-0">
                            <thead class="table-light"><tr><th>Tijd (lokaal)</th><th>COG</th><th>SOG</th></tr></thead>
                            <tbody>
                                @foreach (var s in _detail.Beweging.Samples)
                                {
                                    <tr>
                                        <td>@BoordtijdHelper.NaarLokaal(s.TijdUtc).ToString("HH:mm:ss")</td>
                                        <td>@s.CogDegrees.ToString("F1")°</td>
                                        <td>@s.SogKnots.ToString("F1") kn</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

        @if (_detail.Heading?.Samples.Count > 0)
        {
            <div class="card mb-3">
                <div class="card-header fw-semibold">Heading — samples (@_detail.Heading.Samples.Count)</div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered mb-0">
                            <thead class="table-light"><tr><th>Tijd (lokaal)</th><th>Heading</th></tr></thead>
                            <tbody>
                                @foreach (var s in _detail.Heading.Samples)
                                {
                                    <tr>
                                        <td>@BoordtijdHelper.NaarLokaal(s.TijdUtc).ToString("HH:mm:ss")</td>
                                        <td>@s.HeadingDegrees.ToString("F1")°</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

        @if (_detail.Wind?.Samples.Count > 0)
        {
            <div class="card mb-3">
                <div class="card-header fw-semibold">Wind — samples (@_detail.Wind.Samples.Count)</div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered mb-0">
                            <thead class="table-light"><tr><th>Tijd (lokaal)</th><th>Hoek</th><th>Snelheid</th></tr></thead>
                            <tbody>
                                @foreach (var s in _detail.Wind.Samples)
                                {
                                    <tr>
                                        <td>@BoordtijdHelper.NaarLokaal(s.TijdUtc).ToString("HH:mm:ss")</td>
                                        <td>@s.WindAngleDegrees.ToString("F0")°</td>
                                        <td>@s.WindSpeedKnots.ToString("F1") kn</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

        @if (_detail.Diepte?.Samples.Count > 0)
        {
            <div class="card mb-3">
                <div class="card-header fw-semibold">Diepte — samples (@_detail.Diepte.Samples.Count)</div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered mb-0">
                            <thead class="table-light"><tr><th>Tijd (lokaal)</th><th>Diepte</th></tr></thead>
                            <tbody>
                                @foreach (var s in _detail.Diepte.Samples)
                                {
                                    <tr>
                                        <td>@BoordtijdHelper.NaarLokaal(s.TijdUtc).ToString("HH:mm:ss")</td>
                                        <td>@s.DepthMeters.ToString("F1") m</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

        @if (_detail.WaterTemperatuur?.Samples.Count > 0)
        {
            <div class="card mb-3">
                <div class="card-header fw-semibold">Watertemperatuur — samples (@_detail.WaterTemperatuur.Samples.Count)</div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered mb-0">
                            <thead class="table-light"><tr><th>Tijd (lokaal)</th><th>Temperatuur</th></tr></thead>
                            <tbody>
                                @foreach (var s in _detail.WaterTemperatuur.Samples)
                                {
                                    <tr>
                                        <td>@BoordtijdHelper.NaarLokaal(s.TijdUtc).ToString("HH:mm:ss")</td>
                                        <td>@s.TemperatuurCelsius.ToString("F1") °C</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }

    <div class="mt-4">
        <button class="btn btn-outline-secondary" @onclick="TerugNaarLogboek">← Terug naar logboek</button>
    </div>
}

@code {
    [Parameter]
    public int EntryId { get; set; }

    private bool _loading = true;
    private LogbookEntryDetailDto? _detail;

    protected override async Task OnInitializedAsync()
    {
        _detail = await DetailService.GetEntryDetailAsync(EntryId);
        _loading = false;
    }

    private void TerugNaarLogboek() => Navigation.NavigateTo("/logbook");

    /// <summary>
    /// Controleer of er geen meetdata beschikbaar is in het logtijdvak.
    /// </summary>
    private bool HasNoMeasurementData(LogbookEntryDetailDto detail)
    {
        if (!detail.PeriodStartUtc.HasValue)
            return false;

        return GetSampleCount(detail.Positie) == 0 &&
               GetSampleCount(detail.Beweging) == 0 &&
               GetSampleCount(detail.Heading) == 0 &&
               GetSampleCount(detail.Wind) == 0 &&
               GetSampleCount(detail.Diepte) == 0 &&
               GetSampleCount(detail.WaterTemperatuur) == 0;
    }

    /// <summary>
    /// Bepaal het aantal samples voor een gegeven samenvatting.
    /// </summary>
    private int GetSampleCount<T>(LogbookDetailSummaryDto<T>? summary)
    {
        return summary?.Samples.Count ?? 0;
    }
}
