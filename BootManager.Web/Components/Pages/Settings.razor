@page "/settings"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Owner")]
@using System.Net.Http.Json
@using BootManager.Application.Authentication.DTOs
@using BootManager.Application.OperationalSettings.DTOs
@using BootManager.Application.OperationalSettings.Services
@using BootManager.Application.VesselProfile.DTOs
@using BootManager.Application.VesselProfile.Services
@using BootManager.Web.Services
@using BootManager.Web.Components.Settings
@using BootManager.Core.Enums
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime Js
@inject BootManager.Application.Authentication.Services.IOwnerSettingsService SettingsService
@inject BootManager.Application.Authentication.Services.ILocalUserManagementService LocalUserManagementService
@inject IOperationalSettingsService OperationalSettingsService
@inject IOperationalSettingsWithReloadService OperationalSettingsWithReloadService
@inject IVesselProfileService VesselProfileService

<h3>Instellingen</h3>

<div class="accordion" id="settingsAccordion">
    <!-- Account Group -->
    <div class="accordion-item">
        <h2 class="accordion-header">
            <button class="@GetAccordionButtonClass(_accountOpen)" type="button" @onclick="@(() => ToggleAccordion("account"))" aria-expanded="@GetAriaExpanded(_accountOpen)" aria-controls="accountCollapse">
                Account
            </button>
        </h2>
        <div id="accountCollapse" class="@GetAccordionContentClass(_accountOpen)">
            <div class="accordion-body">
                <!-- Eigenaarprofiel -->
                <div class="mb-4">
                    <h5>Eigenaarprofiel</h5>

                    @if (_ownerProfileBusy && _ownerProfileEditModel is null)
                    {
                        <p>Laden...</p>
                    }
                    else if (_ownerProfileEditModel is not null)
                    {
                        <EditForm Model="_ownerProfileEditModel" OnValidSubmit="HandleOwnerProfileSubmit">
                            <DataAnnotationsValidator />
                            <ValidationSummary />

                            <div class="mb-2">
                                <label>Naam <span class="text-danger">*</span></label>
                                <InputText class="form-control" @bind-Value="_ownerProfileEditModel.Name" />
                                <small class="form-text text-muted">Verplicht veld.</small>
                            </div>
                            <div class="mb-2">
                                <label>E-mail <span class="text-muted">(optioneel)</span></label>
                                <InputText class="form-control" type="email" @bind-Value="_ownerProfileEditModel.Email" />
                            </div>

                            <button type="submit" class="btn btn-primary" disabled="@_ownerProfileBusy">@(_ownerProfileBusy ? "Bezig..." : "Opslaan")</button>
                        </EditForm>
                        @if (!string.IsNullOrEmpty(_ownerProfileError))
                        {
                            <div class="alert alert-danger mt-2">@_ownerProfileError</div>
                        }
                        @if (_ownerProfileSuccess)
                        {
                            <div class="alert alert-success mt-2">@(_ownerProfileSuccessMessage ?? "Eigenaarprofiel opgeslagen.")</div>
                        }
                    }
                </div>

                <!-- Wachtwoord wijzigen -->
                <div>
                    <h5>Wachtwoord wijzigen</h5>
                    <EditForm Model="pwdModel" OnSubmit="HandlePasswordSubmit">
                        <DataAnnotationsValidator />
                        <ValidationSummary />
                        <div class="mb-2">
                            <label>Huidig wachtwoord</label>
                            <InputText class="form-control" type="password" @bind-Value="pwdModel.CurrentPassword" />
                        </div>
                        <div class="mb-2">
                            <label>Nieuw wachtwoord</label>
                            <InputText class="form-control" type="password" @bind-Value="pwdModel.NewPassword" />
                        </div>
                        <div class="mb-2">
                            <label>Bevestig nieuw wachtwoord</label>
                            <InputText class="form-control" type="password" @bind-Value="pwdModel.ConfirmNewPassword" />
                        </div>
                        <button type="submit" class="btn btn-primary" disabled="@_pwdBusy">@(_pwdBusy ? "Bezig..." : "Wijzig wachtwoord")</button>
                    </EditForm>
                    @if (!string.IsNullOrEmpty(pwdError)) { <div class="text-danger">@pwdError</div> }
                    @if (pwdSuccess) { <div class="text-success">Wachtwoord gewijzigd.</div> }
                </div>

                <!-- Crew Management -->
                <div class="mt-4">
                    <h5>Crew-management</h5>

                    <!-- Crew list -->
                    @if (_crewListLoading)
                    {
                        <p>Laden...</p>
                    }
                    else if (_crewList != null && _crewList.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Naam</th>
                                        <th>Status</th>
                                        <th>Acties</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var crew in _crewList)
                                    {
                                        <tr>
                                            <td>@crew.DisplayName</td>
                                            <td>
                                                @if (crew.IsActive)
                                                {
                                                    <span class="badge bg-success">Actief</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">Uitgeschakeld</span>
                                                }
                                            </td>
                                            <td>
                                                <button class="btn btn-sm btn-warning" @onclick="() => ShowResetPasswordModal(crew.Id)">Wachtwoord reset</button>
                                                @if (crew.IsActive)
                                                {
                                                    <button class="btn btn-sm btn-danger" @onclick="() => DisableCrew(crew.Id)">Uitschakelen</button>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-sm btn-success" @onclick="() => ReactivateCrew(crew.Id)">Activeren</button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p>Geen Crew-accounts aanwezig.</p>
                    }

                    <!-- Create crew -->
                    <div class="mt-3">
                        <h6>Nieuwe Crew toevoegen</h6>
                        <div class="mb-2">
                            <label>Accountnaam</label>
                            <InputText class="form-control" @bind-Value="_newCrewName" disabled="@_crewActionBusy" />
                        </div>
                        <div class="mb-2">
                            <label>Tijdelijk wachtwoord</label>
                            <InputText class="form-control" type="password" @bind-Value="_newCrewPassword" disabled="@_crewActionBusy" />
                            <small class="form-text text-muted">Minimaal 8 tekens.</small>
                        </div>
                        <button class="btn btn-primary" @onclick="CreateCrew" disabled="@_crewActionBusy">
                            @(_crewActionBusy ? "Bezig..." : "Crew toevoegen")
                        </button>
                        @if (!string.IsNullOrEmpty(_crewError)) { <div class="alert alert-danger mt-2">@_crewError</div> }
                        @if (!string.IsNullOrEmpty(_crewSuccess)) { <div class="alert alert-success mt-2">@_crewSuccess</div> }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Boot Group -->
    <div class="accordion-item">
        <h2 class="accordion-header">
            <button class="@GetAccordionButtonClass(_bootOpen)" type="button" @onclick="@(() => ToggleAccordion("boot"))" aria-expanded="@GetAriaExpanded(_bootOpen)" aria-controls="bootCollapse">
                Boot
            </button>
        </h2>
        <div id="bootCollapse" class="@GetAccordionContentClass(_bootOpen)">
            <div class="accordion-body">
                <!-- Bootgegevens -->
                <h5>Bootgegevens</h5>

                @if (_vesselBusy && _vesselModel is null)
                {
                    <p>Laden...</p>
                }
                else if (_vesselModel is not null)
                {
                    <EditForm Model="_vesselEditModel" OnValidSubmit="HandleVesselSubmit">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="mb-2">
                            <label>Bootnaam <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="_vesselEditModel.VesselName" />
                            <small class="form-text text-muted">Verplicht veld.</small>
                        </div>
                        <div class="mb-2">
                            <label>Thuishaven <span class="text-muted">(optioneel)</span></label>
                            <InputText class="form-control" @bind-Value="_vesselEditModel.HomePort" />
                        </div>
                        <div class="mb-2">
                            <label>Roepnaam <span class="text-muted">(optioneel)</span></label>
                            <InputText class="form-control" @bind-Value="_vesselEditModel.CallSign" />
                        </div>
                        <div class="mb-2">
                            <label>MMSI <span class="text-muted">(optioneel)</span></label>
                            <InputText class="form-control" @bind-Value="_vesselEditModel.Mmsi" />
                        </div>

                        <hr />
                        <h6 class="mt-3">Actuele Tellerstand</h6>
                        <div class="mb-2">
                            <label>Motorurenstand <span class="text-muted">(optioneel)</span></label>
                            <InputNumber class="form-control" @bind-Value="_vesselEditModel.CurrentEngineHours" />
                            <small class="form-text text-muted">Actuele stand in motoruren. Kan null zijn of een lagere waarde voor reset.</small>
                        </div>
                        <div class="mb-2">
                            <label>Logstand <span class="text-muted">(optioneel, nm)</span></label>
                            <InputNumber class="form-control" @bind-Value="_vesselEditModel.CurrentLogstand" />
                            <small class="form-text text-muted">Actuele stand in zeemijlen. Kan null zijn of een lagere waarde voor reset.</small>
                        </div>

                        <button type="submit" class="btn btn-primary" disabled="@_vesselBusy">@(_vesselBusy ? "Bezig..." : "Opslaan")</button>
                    </EditForm>
                    @if (!string.IsNullOrEmpty(_vesselError))
                    {
                        <div class="alert alert-danger mt-2">@_vesselError</div>
                    }
                    @if (_vesselSuccess)
                    {
                        <div class="alert alert-success mt-2">@(_vesselSuccessMessage ?? "Bootgegevens opgeslagen.")</div>
                    }
                }
            </div>
        </div>
    </div>

    <!-- Operationeel Group -->
    <div class="accordion-item">
        <h2 class="accordion-header">
            <button class="@GetAccordionButtonClass(_operationalOpen)" type="button" @onclick="@(() => ToggleAccordion("operational"))" aria-expanded="@GetAriaExpanded(_operationalOpen)" aria-controls="operationalCollapse">
                Operationeel
            </button>
        </h2>
        <div id="operationalCollapse" class="@GetAccordionContentClass(_operationalOpen)">
            <div class="accordion-body">
                <!-- Operationele instellingen -->
                <h5>Operationele instellingen</h5>

                @if (_opsBusy && _opsModel is null)
                {
                    <p>Laden...</p>
                }
                else if (_opsModel is not null)
                {
                    <EditForm Model="_opsModel" OnValidSubmit="HandleOpsSubmit">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <h6 class="mt-2">Netwerk / Ingest</h6>
                        <div class="mb-2">
                            <label>Luisteradres</label>
                            <InputText class="form-control" @bind-Value="_opsModel.ListenAddress" />
                            <small class="form-text text-muted">IP-adres waarop de ingest-service luistert (bijv. 0.0.0.0).</small>
                        </div>
                        <div class="mb-2">
                            <label>Luisterpoort</label>
                            <InputNumber class="form-control" @bind-Value="_opsModel.ListenPort" />
                        </div>
                        <div class="mb-2">
                            <label>Alternatieve poort <span class="text-muted">(optioneel)</span></label>
                            <InputNumber class="form-control" @bind-Value="_opsModel.AlternativeListenPort" />
                        </div>
                        <div class="mb-2">
                            <label>API basis-URL</label>
                            <InputText class="form-control" @bind-Value="_opsModel.ApiBaseUrl" />
                            <small class="form-text text-muted">Basis-URL van de BootManager Web API.</small>
                        </div>

                        <h6 class="mt-3">Opslag / Sampling</h6>
                        <div class="mb-2">
                            <label>Raw opslagmodus</label>
                            <InputSelect class="form-select" @bind-Value="_opsModel.RawStorageMode">
                                <option value="@RawStorageMode.All">Alles opslaan</option>
                                <option value="@RawStorageMode.Sampled">Sampling (interval)</option>
                                <option value="@RawStorageMode.OffAfterSuccessfulParse">Uit na geslaagde parse</option>
                            </InputSelect>
                        </div>
                        <div class="mb-2">
                            <label>Standaard sample-interval (seconden)</label>
                            <InputNumber class="form-control" @bind-Value="_opsModel.DefaultSampleIntervalSeconds" />
                            <small class="form-text text-muted">Alleen relevant bij modus Sampling (1–3600).</small>
                        </div>
                        <div class="mb-2 form-check">
                            <InputCheckbox class="form-check-input" @bind-Value="_opsModel.CaptureLoggingEnabled" id="captureLogging" />
                            <label class="form-check-label" for="captureLogging">Capture logging inschakelen</label>
                        </div>

                        <h6 class="mt-3">Logboekbijlagen</h6>
                        <div class="mb-2">
                            <label>Directory voor bijlagen</label>
                            <InputText class="form-control" @bind-Value="_opsModel.LogbookAttachmentsDirectory" />
                            <small class="form-text text-muted">Pad waar bijlagen worden opgeslagen (bijv. data/logbook-attachments of /mnt/data/attachments op Raspberry Pi).</small>
                        </div>

                        <button type="submit" class="btn btn-primary" disabled="@_opsBusy">@(_opsBusy ? "Bezig..." : "Opslaan")</button>
                    </EditForm>
                    @if (!string.IsNullOrEmpty(_opsError))
                    {
                        <div class="alert alert-danger mt-2">@_opsError</div>
                    }
                    @if (_opsSuccess)
                    {
                        <div class="alert alert-success mt-2">@(_opsSuccessMessage ?? "Instellingen opgeslagen.")</div>
                    }
                    @if (!string.IsNullOrEmpty(_opsReloadMessage))
                    {
                        @if (_opsReloadMessage.Contains("Let op:") || _opsReloadMessage.Contains("niet bereikbaar"))
                        {
                            <div class="alert alert-warning mt-2">@_opsReloadMessage</div>
                        }
                        else
                        {
                            <div class="alert alert-info mt-2">@_opsReloadMessage</div>
                        }
                    }
                }
            </div>
        </div>
    </div>

    <!-- Storage Group -->
    <div class="accordion-item">
        <h2 class="accordion-header">
            <button class="@GetAccordionButtonClass(_storageOpen)" type="button" @onclick="@(() => ToggleAccordion("storage"))" aria-expanded="@GetAriaExpanded(_storageOpen)" aria-controls="storageCollapse">
                Opslag
            </button>
        </h2>
        <div id="storageCollapse" class="@GetAccordionContentClass(_storageOpen)">
            <div class="accordion-body">
                <StorageManagement />
            </div>
        </div>
    </div>
</div>

@code {
    // Accordion state
    private bool _accountOpen = true;
    private bool _bootOpen = false;
    private bool _operationalOpen = false;
    private bool _storageOpen = false;

    private string GetAccordionButtonClass(bool isOpen) => isOpen ? "accordion-button" : "accordion-button collapsed";
    private string GetAccordionContentClass(bool isOpen) => isOpen ? "accordion-collapse collapse show" : "accordion-collapse collapse";
    private string GetAriaExpanded(bool isOpen) => isOpen ? "true" : "false";

    private void ToggleAccordion(string group)
    {
        var wasOpen = group switch
        {
            "account" => _accountOpen,
            "boot" => _bootOpen,
            "operational" => _operationalOpen,
            "storage" => _storageOpen,
            _ => false
        };

        _accountOpen = false;
        _bootOpen = false;
        _operationalOpen = false;
        _storageOpen = false;

        if (wasOpen)
        {
            return;
        }

        switch (group)
        {
            case "account":
                _accountOpen = true;
                break;
            case "boot":
                _bootOpen = true;
                break;
            case "operational":
                _operationalOpen = true;
                break;
            case "storage":
                _storageOpen = true;
                break;
        }
    }

    private BootManager.Application.Authentication.DTOs.ChangePasswordRequestDto pwdModel = new();

    private string? pwdError;
    private bool pwdSuccess;

    private async Task ChangePassword()
    {
        pwdError = null;
        pwdSuccess = false;
        try
        {
            // In Blazor Server the injected HttpClient issues server-side requests which
            // do not include the user's authentication cookie. Call the application
            // service directly to perform the change under the current user context.
            await SettingsService.ChangePasswordAsync(pwdModel);
            pwdSuccess = true;
        }
        catch (Exception ex)
        {
            pwdError = ex.Message;
        }
    }

    private bool _pwdBusy;

    private async Task HandlePasswordSubmit(Microsoft.AspNetCore.Components.Forms.EditContext ctx)
    {
        _pwdBusy = true;
        try
        {
            await ChangePassword();
        }
        finally
        {
            _pwdBusy = false;
        }
    }

    // --- Operationele instellingen ---

    private OperationalSettingsDto? _opsModel;
    private bool _opsBusy;
    private string? _opsError;
    private bool _opsSuccess;
    private string? _opsSuccessMessage;
    private string? _opsReloadMessage;

    // --- Bootgegevens ---

    private class VesselEditModel
    {
        public string VesselName { get; set; } = string.Empty;
        public string? HomePort { get; set; }
        public string? CallSign { get; set; }
        public string? Mmsi { get; set; }
        public decimal? CurrentEngineHours { get; set; }
        public decimal? CurrentLogstand { get; set; }
    }

    private VesselProfileDto? _vesselModel;
    private VesselEditModel _vesselEditModel = new();
    private bool _vesselBusy;
    private string? _vesselError;
    private bool _vesselSuccess;
    private string? _vesselSuccessMessage;

    private async Task HandleOpsSubmit()
    {
        _opsBusy = true;
        _opsError = null;
        _opsSuccess = false;
        _opsSuccessMessage = null;
        _opsReloadMessage = null;

        try
        {
            var response = await OperationalSettingsWithReloadService.SaveAndReloadAsync(_opsModel!);

            // Toon feedback
            if (response.SettingsSaved)
            {
                _opsSuccess = true;
                _opsSuccessMessage = response.SaveMessage ?? "Instellingen opgeslagen.";
                _opsReloadMessage = response.IngestReloadMessage;
            }
            else
            {
                _opsError = "Instellingen konden niet worden opgeslagen.";
            }
        }
        catch (ArgumentException ex)
        {
            _opsError = $"Validatie-fout: {ex.Message}";
        }
        catch (Exception ex)
        {
            _opsError = $"Fout: {ex.Message}";
        }
        finally
        {
            _opsBusy = false;
        }
    }

    private async Task HandleVesselSubmit()
    {
        _vesselBusy = true;
        _vesselError = null;
        _vesselSuccess = false;
        _vesselSuccessMessage = null;

        try
        {
            // Trim whitespace en behandel lege velden als null voor optionele velden
            var request = new UpdateVesselProfileRequestDto
            {
                VesselName = _vesselEditModel.VesselName?.Trim() ?? string.Empty,
                HomePort = string.IsNullOrWhiteSpace(_vesselEditModel.HomePort) ? null : _vesselEditModel.HomePort.Trim(),
                CallSign = string.IsNullOrWhiteSpace(_vesselEditModel.CallSign) ? null : _vesselEditModel.CallSign.Trim(),
                Mmsi = string.IsNullOrWhiteSpace(_vesselEditModel.Mmsi) ? null : _vesselEditModel.Mmsi.Trim(),
                CurrentEngineHours = _vesselEditModel.CurrentEngineHours,
                CurrentLogstand = _vesselEditModel.CurrentLogstand
            };

            // Update via service
            _vesselModel = await VesselProfileService.UpdateVesselProfileAsync(request);

            // Update het edit-model met de bijgewerkte waarden
            _vesselEditModel = new VesselEditModel
            {
                VesselName = _vesselModel.VesselName ?? string.Empty,
                HomePort = _vesselModel.HomePort,
                CallSign = _vesselModel.CallSign,
                Mmsi = _vesselModel.Mmsi,
                CurrentEngineHours = _vesselModel.CurrentEngineHours,
                CurrentLogstand = _vesselModel.CurrentLogstand
            };

            _vesselSuccess = true;
            _vesselSuccessMessage = "Bootgegevens opgeslagen.";
        }
        catch (ArgumentException ex)
        {
            _vesselError = $"Validatie-fout: {ex.Message}";
        }
        catch (InvalidOperationException)
        {
            _vesselError = "Er is een fout opgetreden bij het opslaan van bootgegevens. Probeer later opnieuw.";
        }
        catch (Exception)
        {
            _vesselError = "Er is een onverwachte fout opgetreden. Probeer later opnieuw.";
        }
        finally
        {
            _vesselBusy = false;
        }
    }

    // --- Eigenaarprofiel ---

    private class OwnerProfileEditModel
    {
        public string Name { get; set; } = string.Empty;
        public string? Email { get; set; }
    }

    private OwnerProfileEditModel? _ownerProfileEditModel;
    private bool _ownerProfileBusy;
    private string? _ownerProfileError;
    private bool _ownerProfileSuccess;
    private string? _ownerProfileSuccessMessage;

    private async Task LoadOwnerProfile()
    {
        _ownerProfileBusy = true;
        _ownerProfileError = null;

        try
        {
            var ownerProfile = await SettingsService.GetOwnerProfileAsync();
            _ownerProfileEditModel = new OwnerProfileEditModel
            {
                Name = ownerProfile.Name,
                Email = ownerProfile.Email
            };
        }
        catch (Exception)
        {
            _ownerProfileError = "Eigenaarprofiel kon niet worden geladen. Probeer later opnieuw.";
            _ownerProfileEditModel = null;
        }
        finally
        {
            _ownerProfileBusy = false;
        }
    }

    private async Task HandleOwnerProfileSubmit()
    {
        _ownerProfileBusy = true;
        _ownerProfileError = null;
        _ownerProfileSuccess = false;
        _ownerProfileSuccessMessage = null;

        try
        {
            var request = new UpdateOwnerProfileRequestDto
            {
                Name = _ownerProfileEditModel!.Name?.Trim() ?? string.Empty,
                Email = string.IsNullOrWhiteSpace(_ownerProfileEditModel.Email) ? string.Empty : _ownerProfileEditModel.Email.Trim()
            };

            await SettingsService.UpdateOwnerProfileAsync(request);

            _ownerProfileSuccess = true;
            _ownerProfileSuccessMessage = "Eigenaarprofiel opgeslagen.";
        }
        catch (ArgumentException ex)
        {
            _ownerProfileError = $"Validatie-fout: {ex.Message}";
        }
        catch (InvalidOperationException)
        {
            _ownerProfileError = "Er is een fout opgetreden bij het opslaan van het eigenaarprofiel. Probeer later opnieuw.";
        }
        catch (Exception)
        {
            _ownerProfileError = "Er is een onverwachte fout opgetreden bij het opslaan van het eigenaarprofiel. Probeer later opnieuw.";
        }
        finally
        {
            _ownerProfileBusy = false;
        }
    }

    private void InitializeOwnerProfile()
    {
        if (_ownerProfileEditModel is null)
        {
            // Initialize lazy
            _ = LoadOwnerProfile();
        }
    }

    // --- Crew Management ---

    private class CrewUser
    {
        public Guid Id { get; set; }
        public string DisplayName { get; set; } = string.Empty;
        public bool IsActive { get; set; }
    }

    private List<CrewUser>? _crewList;
    private bool _crewListLoading;
    private string _newCrewName = string.Empty;
    private string _newCrewPassword = string.Empty;
    private bool _crewActionBusy;
    private string? _crewError;
    private string? _crewSuccess;

    private async Task LoadCrewList()
    {
        _crewListLoading = true;
        try
        {
            var crewList = await LocalUserManagementService.GetAllCrewAsync();
            _crewList = crewList
                .Select(u => new CrewUser { Id = u.Id, DisplayName = u.DisplayName, IsActive = u.IsActive })
                .ToList();
        }
        catch (Exception)
        {
            _crewError = "Crew-lijst kon niet worden geladen.";
            _crewList = [];
        }
        finally
        {
            _crewListLoading = false;
        }
    }

    private async Task CreateCrew()
    {
        _crewError = null;
        _crewSuccess = null;
        _crewActionBusy = true;

        try
        {
            if (string.IsNullOrWhiteSpace(_newCrewName))
            {
                _crewError = "Accountnaam is verplicht.";
                return;
            }

            if (string.IsNullOrWhiteSpace(_newCrewPassword) || _newCrewPassword.Length < 8)
            {
                _crewError = "Wachtwoord moet minimaal 8 tekens zijn.";
                return;
            }

            var result = await LocalUserManagementService.CreateCrewAsync(_newCrewName, _newCrewPassword);

            if (result.Success)
            {
                _crewSuccess = $"Crew '{_newCrewName}' aangemaakt. Het tijdelijke wachtwoord is: {_newCrewPassword}";
                _newCrewName = string.Empty;
                _newCrewPassword = string.Empty;
                await LoadCrewList();
            }
            else
            {
                _crewError = result.Message ?? "Crew kon niet worden aangemaakt.";
            }
        }
        catch (Exception ex)
        {
            _crewError = $"Fout: {ex.Message}";
        }
        finally
        {
            _crewActionBusy = false;
        }
    }

    private async Task DisableCrew(Guid crewId)
    {
        _crewActionBusy = true;
        try
        {
            var success = await LocalUserManagementService.DisableCrewAsync(crewId);
            if (success)
            {
                await LoadCrewList();
                _crewSuccess = "Crew uitgeschakeld.";
            }
            else
            {
                _crewError = "Crew kon niet worden uitgeschakeld.";
            }
        }
        catch (Exception ex)
        {
            _crewError = $"Fout: {ex.Message}";
        }
        finally
        {
            _crewActionBusy = false;
        }
    }

    private async Task ReactivateCrew(Guid crewId)
    {
        _crewActionBusy = true;
        try
        {
            var success = await LocalUserManagementService.ReactivateCrewAsync(crewId);
            if (success)
            {
                await LoadCrewList();
                _crewSuccess = "Crew geactiveerd.";
            }
            else
            {
                _crewError = "Crew kon niet worden geactiveerd.";
            }
        }
        catch (Exception ex)
        {
            _crewError = $"Fout: {ex.Message}";
        }
        finally
        {
            _crewActionBusy = false;
        }
    }

    private async Task ShowResetPasswordModal(Guid crewId)
    {
        // Simplified: just prompt for new password and reset
        var newPassword = await Js.InvokeAsync<string>("prompt", "Voer nieuw wachtwoord in (minimaal 8 tekens):");

        if (!string.IsNullOrWhiteSpace(newPassword) && newPassword.Length >= 8)
        {
            _crewActionBusy = true;
            try
            {
                var result = await LocalUserManagementService.ResetCrewPasswordAsync(crewId, newPassword);
                if (result.Success)
                {
                    _crewSuccess = $"Wachtwoord gereset. Nieuw wachtwoord: {newPassword}";
                }
                else
                {
                    _crewError = result.Message ?? "Wachtwoord kon niet worden gereset.";
                }
            }
            catch (Exception ex)
            {
                _crewError = $"Fout: {ex.Message}";
            }
            finally
            {
                _crewActionBusy = false;
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // Initialize owner profile
        await LoadOwnerProfile();

        // Load crew list
        await LoadCrewList();

        // Laad operationele instellingen
        _opsModel = await OperationalSettingsService.GetAsync();

        // Laad bootgegevens
        try
        {
            _vesselModel = await VesselProfileService.GetOrCreateVesselProfileAsync();
            if (_vesselModel != null)
            {
                _vesselEditModel = new VesselEditModel
                {
                    VesselName = _vesselModel.VesselName ?? string.Empty,
                    HomePort = _vesselModel.HomePort,
                    CallSign = _vesselModel.CallSign,
                    Mmsi = _vesselModel.Mmsi,
                    CurrentEngineHours = _vesselModel.CurrentEngineHours,
                    CurrentLogstand = _vesselModel.CurrentLogstand
                };
            }
        }
        catch (Exception)
        {
            _vesselError = "Bootgegevens konden niet worden geladen. Probeer later opnieuw.";
        }
    }
}
