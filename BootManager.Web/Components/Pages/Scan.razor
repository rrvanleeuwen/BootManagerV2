@page "/scan"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Microsoft.AspNetCore.Components

@inject NavigationManager NavigationManager

<PageTitle>Scannen</PageTitle>

<div class="alert alert-info" role="alert">
    <h4 class="alert-heading">Scannen (nieuwe versie in voorbereiding)</h4>
    <p>
        De nieuwe scanflow is nog in ontwikkeling. U wordt doorgestuurd naar de huidige werkende versie.
    </p>
</div>

@code {
    protected override void OnInitialized()
    {
        NavigationManager.NavigateTo("/scan/old", replace: true);
    }
}
