@page "/scan"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@implements IAsyncDisposable
@using Microsoft.JSInterop
@using BootManager.Application.Storage.Services
@using BootManager.Application.Storage.Results
@using Microsoft.AspNetCore.Components.Authorization

@inject IJSRuntime Js
@inject IStorageService StorageService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Scannen</PageTitle>

<h3>Scannen</h3>

@if (_status == ScanStatus.InsecureContext)
{
    <div class="alert alert-danger">
        <strong>Camera niet beschikbaar via HTTP.</strong>
        Cameratoegang vereist een beveiligde verbinding (HTTPS).
        Open de pagina via de operationeel geconfigureerde HTTPS-route.
        De handmatige invoer hieronder blijft beschikbaar.
    </div>
}
else if (_status == ScanStatus.Error && _errorMessage is not null)
{
    <div class="alert alert-warning">@_errorMessage</div>
}

<div class="scan-video-wrapper @(_showVideo ? "scan-video-visible" : "scan-video-hidden")">
    <video id="scan-video" autoplay playsinline muted></video>
</div>

<p class="scan-status-text">@_statusText</p>

<div class="scan-controls">
    @if (_status is ScanStatus.NotStarted or ScanStatus.Stopped or ScanStatus.Error)
    {
        <button class="btn btn-primary" @onclick="StartScan">Starten</button>
    }
    else if (_status == ScanStatus.RequestingPermission)
    {
        <button class="btn btn-primary" disabled>Bezig met starten…</button>
    }
    else if (_status == ScanStatus.Active)
    {
        <button class="btn btn-secondary" @onclick="StopScan">Stoppen</button>
    }
    else if (_status is ScanStatus.Result or ScanStatus.ManualEntry)
    {
        <button class="btn btn-primary me-2" @onclick="StartScan">Opnieuw scannen</button>
        <button class="btn btn-outline-secondary" @onclick="StopScan">Stoppen</button>
    }
</div>

@if (_cameras.Length > 1)
{
    <div class="scan-camera-select">
        <label class="scan-camera-label">Camera</label>
        <select class="form-select form-select-sm"
                value="@(_selectedDeviceId ?? string.Empty)"
                @onchange="OnCameraChange">
            <option value="">Automatisch (achtercamera voorkeur)</option>
            @for (int i = 0; i < _cameras.Length; i++)
            {
                var cam = _cameras[i];
                var displayLabel = string.IsNullOrEmpty(cam.Label) ? $"Camera {i + 1}" : cam.Label;
                <option value="@cam.DeviceId">@displayLabel</option>
            }
        </select>
    </div>
}

@if (_decoderSupport is not null)
{
    <div class="scan-decoder-support">
        @if (_decoderSupport.QrAvailable)
        {
            <span class="scan-support-item">QR-code: beschikbaar</span>
        }
        @if (_decoderSupport.NativeEan13Available)
        {
            <span class="scan-support-item scan-support-success">EAN-13: beschikbaar</span>
        }
        else
        {
            @switch (_decoderSupport.NativeFailureReason)
            {
                case "initializing":
                    <span class="scan-support-item scan-support-neutral">EAN-13: controleren…</span>
                    break;
                case "not_available":
                case "format_not_supported":
                    <span class="scan-support-item scan-support-warning">EAN-13: niet ondersteund in deze browser; gebruik handmatige invoer</span>
                    break;
                default:
                    <span class="scan-support-item scan-support-warning">EAN-13: decoder niet beschikbaar; gebruik handmatige invoer</span>
                    break;
            }
        }
    </div>
}

@if (_diagnostics is not null)
{
    <div class="scan-diagnostics">
        @if (!string.IsNullOrEmpty(_diagnostics.Label))
        {
            <span class="scan-diag-item">@_diagnostics.Label</span>
        }
        @if (_diagnostics.Width.HasValue && _diagnostics.Height.HasValue)
        {
            <span class="scan-diag-item">@_diagnostics.Width×@_diagnostics.Height</span>
        }
        @if (!string.IsNullOrEmpty(_diagnostics.FacingMode))
        {
            <span class="scan-diag-item">@_diagnostics.FacingMode</span>
        }
        @if (!string.IsNullOrEmpty(_diagnostics.ActiveFocusMode))
        {
            <span class="scan-diag-item">AF: @_diagnostics.ActiveFocusMode</span>
        }
        @if (_diagnostics.SupportedFocusModes?.Length > 0)
        {
            <span class="scan-diag-item">Modes: @string.Join(",", _diagnostics.SupportedFocusModes)</span>
        }
        @switch (_diagnostics.Autofocus)
        {
            case "applied":
                <span class="scan-diag-item scan-diag-success">↻ continu</span>
                break;
            case "failed":
                <span class="scan-diag-item scan-diag-warning">✗ mislukt</span>
                break;
            case "unsupported":
                <span class="scan-diag-item scan-diag-neutral">— n.v.t.</span>
                break;
        }
    </div>
}

@if (_status is ScanStatus.Result or ScanStatus.ManualEntry)
{
    <div class="scan-result">
        <div><strong>Waarde</strong></div>
        <div class="scan-result-value">@_resultValue</div>
        <div class="mt-2"><strong>Formaat</strong></div>
        <div>@_resultFormat</div>

        @if (_qrResolution != null)
        {
            <div class="mt-3">
                @if (_qrResolution.Status == QrStatus.Linked)
                {
                    <div class="alert alert-info">
                        <strong>BootManager locatie-QR herkennen.</strong>
                        <button class="btn btn-sm btn-primary ms-2" @onclick="NavigateToLocation">Locatie openen</button>
                    </div>
                }
                else if (_qrResolution.Status == QrStatus.Unknown)
                {
                    @if (_isOwner)
                    {
                        <div class="alert alert-warning">
                            <strong>Onbekende BootManager locatie-QR.</strong>
                            <button class="btn btn-sm btn-primary ms-2" @onclick="NavigateToLinkPage">Koppelen…</button>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            <strong>Onbekende BootManager locatie-QR.</strong>
                            Deze QR kan door een beheerder worden gekoppeld.
                        </div>
                    }
                }
            </div>
        }
    </div>
}

<div class="scan-manual">
    <h5>Handmatige invoer</h5>
    <div class="input-group">
        <input class="form-control"
               type="text"
               placeholder="Voer barcode of QR-waarde in…"
               @bind="_manualInput"
               @bind:event="oninput"
               @onkeydown="HandleManualKeyDown" />
        <button class="btn btn-outline-primary"
                @onclick="ApplyManualInput"
                disabled="@string.IsNullOrWhiteSpace(_manualInput)">
            Toepassen
        </button>
    </div>
</div>

@code {
    private enum ScanStatus
    {
        NotStarted,
        RequestingPermission,
        Active,
        Result,
        ManualEntry,
        Stopped,
        Error,
        InsecureContext
    }

    /// <summary>Eenvoudige DTO voor een beschikbare video-input, gevuld via JS-interop.</summary>
    public sealed class CameraInfo
    {
        public string DeviceId { get; set; } = string.Empty;
        public string Label    { get; set; } = string.Empty;
    }

    /// <summary>
    /// Diagnostische gegevens van de actieve cameratrack, gevuld na toestemmingsverlening.
    /// Nullable properties: niet alle browsers ondersteunen alle velden.
    /// </summary>
    public sealed class CameraDiagnostics
    {
        public string? DeviceId             { get; set; }
        public string? Label                { get; set; }
        public int?    Width                { get; set; }
        public int?    Height               { get; set; }
        public string? FacingMode           { get; set; }
        public string[]? SupportedFocusModes { get; set; }
        public string? ActiveFocusMode      { get; set; }

        /// <summary>Autofocusresultaat: "applied", "failed", "unsupported".</summary>
        public string? Autofocus            { get; set; }
    }

    /// <summary>
    /// Rapportage van beschikbare decoders (ZXing QR en native EAN-13).
    /// </summary>
    public sealed class DecoderSupport
    {
        public bool QrAvailable { get; set; }
        public bool NativeSupportCheckSucceeded { get; set; }
        public bool NativeEan13Available { get; set; }
        public string[] SupportedFormats { get; set; } = Array.Empty<string>();
        public string? NativeFailureReason { get; set; }
        /// <summary>Per-sessie oplopende revision: voorkomt terug-in-de-tijd callbacks.</summary>
        public int SupportRevision { get; set; }
    }

    private ScanStatus _status = ScanStatus.NotStarted;
    private string? _resultValue;
    private string? _resultFormat;
    private string? _errorMessage;
    private string? _manualInput;
    private QrResolutionResult? _qrResolution;
    private bool _isOwner = false;

    // Geselecteerde camera-ID; null = automatische achtercameravoorkeur via facingMode.
    // Blijft behouden over scan-herstarts tijdens de levensduur van het component.
    private string? _selectedDeviceId;

    // Beschikbare cameras; gevuld na eerste toestemmingsverlening; leeg = selector verborgen.
    private CameraInfo[] _cameras = Array.Empty<CameraInfo>();

    // Diagnostics van de actieve track; null = diagnosticsblok verborgen.
    private CameraDiagnostics? _diagnostics;

    // Decoderondersteuning; null = blok verborgen.
    private DecoderSupport? _decoderSupport;

    // Laatste support-revision gezien; voorkomt terug-in-de-tijd updates.
    private int _lastSupportRevision = -1;

    // Monotoon request-ID per scan-sessie voor race-safe callbacks.
    private int _requestId = 0;

    private IJSObjectReference? _scanModule;
    private DotNetObjectReference<Scan>? _dotnetRef;

    private bool _showVideo =>
        _status is ScanStatus.RequestingPermission or ScanStatus.Active;

    private string _statusText => _status switch
    {
        ScanStatus.NotStarted           => "Druk op Starten om de camera te activeren.",
        ScanStatus.RequestingPermission => "Cameratoestemming aanvragen…",
        ScanStatus.Active               => "Camera actief — houd een code voor de camera.",
        ScanStatus.Result               => "Code herkend.",
        ScanStatus.ManualEntry          => "Code handmatig ingevoerd.",
        ScanStatus.Stopped              => "Scanner gestopt.",
        ScanStatus.Error                => "Fout bij starten van de scanner.",
        ScanStatus.InsecureContext      => "Cameratoegang niet mogelijk via HTTP.",
        _                               => string.Empty
    };

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _isOwner = authState.User.IsInRole("Owner");
    }

    /// <summary>
    /// Laadt de JavaScript-scanmodule bij de eerste render en bepaalt direct de beveiligde-contextstatus,
    /// zodat de HTTP-waarschuwing zichtbaar is zonder dat de gebruiker actie hoeft te ondernemen.
    /// Als de module niet kan worden geladen blijft de pagina bruikbaar via handmatige invoer.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _scanModule = await Js.InvokeAsync<IJSObjectReference>("import", "./js/barcodeScanner.js");
            }
            catch (JSException)
            {
                _status = ScanStatus.Error;
                _errorMessage = "Scannermodule kon niet worden geladen. Handmatige invoer is beschikbaar.";
                StateHasChanged();
                return;
            }

            _dotnetRef = DotNetObjectReference.Create(this);

            try
            {
                var isSecure = await _scanModule.InvokeAsync<bool>("checkSecureContext");
                if (!isSecure)
                {
                    _status = ScanStatus.InsecureContext;
                    StateHasChanged();
                }
            }
            catch (JSDisconnectedException) { }
            catch (JSException) { }
        }
    }

    /// <summary>
    /// Interne helper: start de scanner race-safe met lokale request-ID en deviceId.
    /// Controlleert na iedere async-bewerking of deze request nog actueel is.
    /// </summary>
    private async Task _internalStartScan(int localRequestId, string? localSelectedDeviceId)
    {
        if (_scanModule is null || _dotnetRef is null)
            return;

        try
        {
            await _scanModule.InvokeVoidAsync("startScan", _dotnetRef, "scan-video", localSelectedDeviceId, localRequestId);

            // Check: is dit nog de huidige request?
            if (localRequestId != _requestId)
                return;
        }
        catch (JSDisconnectedException)
        {
            return;
        }
        catch (JSException ex)
        {
            // Check: is dit nog de huidige request?
            if (localRequestId != _requestId)
                return;

            _status = ScanStatus.Error;
            _errorMessage = "Fout bij starten van de scanner: " + ex.Message;
            StateHasChanged();
            return;
        }

        // Check opnieuw: is dit nog de huidige request?
        if (localRequestId != _requestId)
            return;

        // Als OnScanError de status al heeft gewijzigd, niet overschrijven.
        if (_status == ScanStatus.RequestingPermission)
        {
            _status = ScanStatus.Active;
            StateHasChanged();
        }
    }

    private async Task StartScan()
    {
        if (_scanModule is null || _dotnetRef is null)
            return;

        _resultValue  = null;
        _resultFormat = null;
        _errorMessage = null;
        _diagnostics  = null;
        _decoderSupport = null;
        _lastSupportRevision = -1;
        _requestId++;

        // Leg lokaal vast vóór aanroep.
        var localRequestId = _requestId;
        var localSelectedDeviceId = _selectedDeviceId;

        _status = ScanStatus.RequestingPermission;
        StateHasChanged();

        await _internalStartScan(localRequestId, localSelectedDeviceId);
    }

    private async Task StopScan()
    {
        _requestId++;

        if (_scanModule is not null)
        {
            try
            {
                await _scanModule.InvokeVoidAsync("stopScan");
            }
            catch (JSDisconnectedException) { }
            catch (JSException) { }
        }

        _status = ScanStatus.Stopped;
        StateHasChanged();
    }

    /// <summary>
    /// Verwerkt een camerawissel uit de selector. Race-safe: controlleert na stop en start
    /// of de wissel nog actueel is (alleen de nieuwste wissel start een scanner).
    /// </summary>
    private async Task OnCameraChange(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString();
        _selectedDeviceId = string.IsNullOrEmpty(raw) ? null : raw;

        if (_status is ScanStatus.Active or ScanStatus.RequestingPermission)
        {
            // Lokale request-ID vóór stopScan.
            _requestId++;
            var localStopRequestId = _requestId;
            var localSelectedDeviceId = _selectedDeviceId;

            if (_scanModule is not null)
            {
                try
                {
                    await _scanModule.InvokeVoidAsync("stopScan");
                }
                catch (JSDisconnectedException) { }
                catch (JSException) { }
            }

            // Check: is dit nog de huidige wissel?
            if (localStopRequestId != _requestId)
                return;

            // Herstart direct met de nieuwe camera.
            _resultValue  = null;
            _resultFormat = null;
            _errorMessage = null;
            _diagnostics  = null;
            _decoderSupport = null;
            _lastSupportRevision = -1;
            _requestId++;
            var localStartRequestId = _requestId;

            _status = ScanStatus.RequestingPermission;
            StateHasChanged();

            await _internalStartScan(localStartRequestId, localSelectedDeviceId);
        }
    }

    /// <summary>
    /// Past handmatige invoer toe. Stopt een actieve scanner en camerastream eerst.
    /// </summary>
    private async Task ApplyManualInput()
    {
        var value = _manualInput?.Trim();
        if (string.IsNullOrEmpty(value))
            return;

        if (_scanModule is not null &&
            _status is ScanStatus.Active or ScanStatus.RequestingPermission)
        {
            _requestId++;
            try
            {
                await _scanModule.InvokeVoidAsync("stopScan");
            }
            catch (JSDisconnectedException) { }
            catch (JSException) { }
        }

        _resultValue  = value;
        _resultFormat = "Handmatig ingevoerd";
        _status       = ScanStatus.ManualEntry;
        _manualInput  = null;
        await ProcessScannedValue(value);
        StateHasChanged();
    }

    private async Task HandleManualKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ApplyManualInput();
        }
    }

    /// <summary>Ontvangt een succesvol scanresultaat vanuit JavaScript.</summary>
    [JSInvokable]
    public async void OnScanResult(int requestId, string value, string format)
    {
        // Negeer resultaten van vorige sessies.
        if (requestId != _requestId)
            return;

        _resultValue  = value;
        _resultFormat = format;
        _status       = ScanStatus.Result;
        await ProcessScannedValue(value);
        StateHasChanged();
    }

    /// <summary>Ontvangt een foutcode vanuit JavaScript en vertaalt die naar een Nederlandse melding.</summary>
    [JSInvokable]
    public void OnScanError(int requestId, string errorCode)
    {
        // Negeer fouten van vorige sessies.
        if (requestId != _requestId)
            return;

        _status = errorCode == "INSECURE_CONTEXT" ? ScanStatus.InsecureContext : ScanStatus.Error;
        _errorMessage = errorCode switch
        {
            "INSECURE_CONTEXT"    => "Cameratoegang vereist een beveiligde verbinding (HTTPS).",
            "NO_CAMERA_API"       => "Camera-API niet beschikbaar in deze browser.",
            "PERMISSION_DENIED"   => "Cameratoestemming geweigerd. Sta cameratoegang toe in de browserinstellingen.",
            "NO_CAMERA"           => "Geen camera gevonden op dit apparaat.",
            "CAMERA_ERROR"        => "Camera kon niet worden gestart. Controleer of de camera beschikbaar is.",
            "DECODER_LOAD_FAILED" => "Barcodedecoder kon niet worden geladen. Controleer of lib/zxing/zxing.min.js aanwezig is.",
            _                     => "Onbekende fout bij het starten van de scanner."
        };

        StateHasChanged();
    }

    /// <summary>
    /// Ontvangt de lijst van beschikbare camera's na toestemmingsverlening.
    /// Labels zijn pas beschikbaar nadat cameratoestemming is verleend.
    /// Toont de camera-selector wanneer meer dan één video-input beschikbaar is.
    /// </summary>
    [JSInvokable]
    public void OnCamerasAvailable(int requestId, CameraInfo[] cameras)
    {
        // Negeer camera's van vorige sessies.
        if (requestId != _requestId)
            return;

        _cameras = cameras;
        StateHasChanged();
    }

    /// <summary>
    /// Ontvangt diagnostische gegevens van de actieve cameratrack na toestemmingsverlening:
    /// werkelijke resolutie, richting en autofocusresultaat (uit opnieuw gelezen settings).
    /// </summary>
    [JSInvokable]
    public void OnDiagnostics(int requestId, CameraDiagnostics diagnostics)
    {
        // Negeer diagnostics van vorige sessies.
        if (requestId != _requestId)
            return;

        _diagnostics = diagnostics;
        StateHasChanged();
    }

    /// <summary>
    /// Ontvangt rapportage van beschikbare decoders (ZXing QR en native EAN-13).
    /// Ignoreert oudere of gelijke revisions om terug-in-de-tijd updates te voorkomen.
    /// </summary>
    [JSInvokable]
    public void OnDecoderSupport(int requestId, DecoderSupport support)
    {
        // Negeer ondersteuning van vorige sessies.
        if (requestId != _requestId)
            return;

        // Negeer oudere of gelijke revisions (terug-in-de-tijd bescherming).
        if (support.SupportRevision <= _lastSupportRevision)
            return;

        _lastSupportRevision = support.SupportRevision;
        _decoderSupport = support;
        StateHasChanged();
    }

    private async Task ProcessScannedValue(string value)
    {
        _qrResolution = await StorageService.ResolveQrValueAsync(value);
        if (_qrResolution.Status == QrStatus.Linked && _qrResolution.LinkedLocationId.HasValue)
        {
            await NavigateToLocation();
        }
    }

    private Task NavigateToLocation()
    {
        if (_qrResolution?.Status == QrStatus.Linked && _qrResolution.LinkedLocationId.HasValue)
        {
            NavigationManager.NavigateTo($"/storage/locations/{_qrResolution.LinkedLocationId}");
        }
        return Task.CompletedTask;
    }

    private Task NavigateToLinkPage()
    {
        if (_qrResolution?.Status == QrStatus.Unknown && !string.IsNullOrEmpty(_qrResolution.Token))
        {
            var qrValue = BootManager.Application.Storage.QrFormat.LocationQrValue.FormatQrValue(_qrResolution.Token);
            var encodedQrValue = Uri.EscapeDataString(qrValue);
            NavigationManager.NavigateTo($"/storage/link-location-qr?qrValue={encodedQrValue}");
        }
        return Task.CompletedTask;
    }

    /// <summary>
    /// Stopt de camera en geeft JavaScript- en .NET-referenties vrij bij disposal van het component.
    /// JSDisconnectedException en JSException worden onderdrukt; de browser-verbinding kan al gesloten zijn.
    /// </summary>
    public async ValueTask DisposeAsync()
    {
        _requestId++;

        if (_scanModule is not null)
        {
            try
            {
                await _scanModule.InvokeVoidAsync("dispose");
            }
            catch (JSDisconnectedException) { }
            catch (JSException) { }

            try
            {
                await _scanModule.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
            catch (JSException) { }
        }

        _dotnetRef?.Dispose();
    }
}
