@page "/scan"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@implements IAsyncDisposable
@using Microsoft.JSInterop
@using BootManager.Application.Storage.Services
@using BootManager.Application.Storage.DTOs
@using BootManager.Application.Storage.Results
@using BootManager.Application.Inventory.Contracts
@using BootManager.Application.Inventory.DTOs
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using Microsoft.AspNetCore.Components

@inject IJSRuntime Js
@inject IStorageService StorageService
@inject IProductService ProductService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Scannen</PageTitle>

<div class="scan-start-container">
    <h2>Scannen</h2>
    <div class="scan-instruction-line">
        Scan een locatie-QR of productcode, of voer handmatig in.
    </div>

    @if (_status == ScanStatus.InsecureContext)
    {
        <div class="alert alert-danger">
            <strong>Camera niet beschikbaar via HTTP.</strong>
            Cameratoegang vereist een beveiligde verbinding (HTTPS).
            Open de pagina via de operationeel geconfigureerde HTTPS-route.
            De handmatige invoer hieronder blijft beschikbaar.
        </div>
    }
    else if (_status == ScanStatus.Error && _errorMessage is not null)
    {
        <div class="alert alert-warning">@_errorMessage</div>
    }

    <div class="scan-start-layout">
        <!-- Camera card: primary focus -->
        <div class="scan-start-card card scan-camera-card">
            <div class="card-body">
                <h5 class="card-title">Camera starten</h5>

                <div class="scan-video-wrapper @(_showVideo ? "scan-video-visible" : "scan-video-hidden")">
                    <video id="scan-video" autoplay playsinline muted></video>
                </div>

                <p class="scan-status-text">@_statusText</p>

                <div class="scan-controls">
                    @if (_status is ScanStatus.NotStarted or ScanStatus.Stopped or ScanStatus.Error)
                    {
                        <button class="btn btn-primary" @onclick="StartScan">Camera starten</button>
                    }
                    else if (_status == ScanStatus.RequestingPermission)
                    {
                        <button class="btn btn-primary" disabled>Bezig met starten…</button>
                    }
                    else if (_status == ScanStatus.Active)
                    {
                        <button class="btn btn-secondary" @onclick="StopScan">Stoppen</button>
                    }
                </div>
            </div>
        </div>

        <!-- Manual input card: secondary -->
        <div class="scan-start-card card scan-secondary-card scan-manual-input-card">
            <div class="card-body">
                <h5 class="card-title">Handmatige invoer</h5>
                <p class="text-muted">Of voer hier in:</p>
                <div class="scan-manual-input-group">
                    <input class="form-control"
                           type="text"
                           placeholder="Voer code in…"
                           @bind="_manualInput"
                           @bind:event="oninput"
                           @onkeydown="HandleManualKeyDown" />
                    <button class="btn btn-outline-primary"
                            @onclick="ApplyManualInput"
                            disabled="@string.IsNullOrWhiteSpace(_manualInput)">
                        OK
                    </button>
                </div>
            </div>
        </div>

        <!-- Recents card: supporting -->
        @if (_recentScans.Count > 0)
        {
            <div class="scan-start-card card scan-secondary-card scan-recents-card">
                <div class="card-body">
                    <h5 class="card-title">Recente scans</h5>
                    <div class="scan-recents-list">
                        @foreach (var scan in _recentScans)
                        {
                            <button type="button" class="list-group-item list-group-item-action" @onclick="() => RescanRecent(scan.Code)">
                                <strong>@scan.Display</strong>
                                <small class="text-muted">@scan.Code</small>
                                <small class="text-muted" style="float: right;">@scan.TimeAgo</small>
                            </button>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private enum ScanStatus
    {
        NotStarted,
        RequestingPermission,
        Active,
        Stopped,
        Error,
        InsecureContext
    }

    private sealed class RecentScan
    {
        public string Code { get; set; } = string.Empty;
        public string Display { get; set; } = string.Empty;
        public string TimeAgo { get; set; } = string.Empty;
    }

    private ScanStatus _status = ScanStatus.NotStarted;
    private string? _errorMessage;
    private string? _manualInput;
    private readonly List<RecentScan> _recentScans = new();
    private int _requestId = 0;
    private IJSObjectReference? _scanModule;
    private DotNetObjectReference<Scan>? _dotnetRef;

    private bool _showVideo =>
        _status is ScanStatus.RequestingPermission or ScanStatus.Active;

    private string _statusText => _status switch
    {
        ScanStatus.NotStarted           => "Druk op 'Camera starten' om te beginnen.",
        ScanStatus.RequestingPermission => "Cameratoestemming aanvragen…",
        ScanStatus.Active               => "Camera actief — houd een code voor de camera.",
        ScanStatus.Stopped              => "Scanner gestopt.",
        ScanStatus.Error                => "Fout bij starten van de scanner.",
        ScanStatus.InsecureContext      => "Cameratoegang niet mogelijk via HTTP.",
        _                               => string.Empty
    };

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated != true)
        {
            NavigationManager.NavigateTo("/login");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _scanModule = await Js.InvokeAsync<IJSObjectReference>("import", "./js/barcodeScanner.js");
            }
            catch (JSException)
            {
                _status = ScanStatus.Error;
                _errorMessage = "Scannermodule kon niet worden geladen. Handmatige invoer is beschikbaar.";
                StateHasChanged();
                return;
            }

            _dotnetRef = DotNetObjectReference.Create(this);

            try
            {
                var isSecure = await _scanModule.InvokeAsync<bool>("checkSecureContext");
                if (!isSecure)
                {
                    _status = ScanStatus.InsecureContext;
                    StateHasChanged();
                }
            }
            catch (JSDisconnectedException) { }
            catch (JSException) { }
        }
    }

    private async Task _internalStartScan(int localRequestId)
    {
        if (_scanModule is null || _dotnetRef is null)
            return;

        try
        {
            await _scanModule.InvokeVoidAsync("startScan", _dotnetRef, "scan-video", null, localRequestId);

            if (localRequestId != _requestId)
                return;
        }
        catch (JSDisconnectedException)
        {
            return;
        }
        catch (JSException ex)
        {
            if (localRequestId != _requestId)
                return;

            _status = ScanStatus.Error;
            _errorMessage = "Fout bij starten van de scanner: " + ex.Message;
            StateHasChanged();
            return;
        }

        if (localRequestId != _requestId)
            return;

        if (_status == ScanStatus.RequestingPermission)
        {
            _status = ScanStatus.Active;
            StateHasChanged();
        }
    }

    private async Task StartScan()
    {
        if (_scanModule is null || _dotnetRef is null)
            return;

        _errorMessage = null;
        _requestId++;

        var localRequestId = _requestId;

        _status = ScanStatus.RequestingPermission;
        StateHasChanged();

        await _internalStartScan(localRequestId);
    }

    private async Task StopScan()
    {
        _requestId++;

        if (_scanModule is not null)
        {
            try
            {
                await _scanModule.InvokeVoidAsync("stopScan");
            }
            catch (JSDisconnectedException) { }
            catch (JSException) { }
        }

        _status = ScanStatus.Stopped;
        StateHasChanged();
    }

    [JSInvokable]
    public async void OnScanResult(int requestId, string value, string format)
    {
        if (requestId != _requestId)
            return;

        _status = ScanStatus.Stopped;
        await ProcessScannedValue(value);
        StateHasChanged();
    }

    [JSInvokable]
    public void OnScanError(int requestId, string errorCode)
    {
        if (requestId != _requestId)
            return;

        _status = errorCode == "INSECURE_CONTEXT" ? ScanStatus.InsecureContext : ScanStatus.Error;
        _errorMessage = errorCode switch
        {
            "INSECURE_CONTEXT"    => "Cameratoegang vereist een beveiligde verbinding (HTTPS).",
            "NO_CAMERA_API"       => "Camera-API niet beschikbaar in deze browser.",
            "PERMISSION_DENIED"   => "Cameratoestemming geweigerd. Sta cameratoegang toe in de browserinstellingen.",
            "NO_CAMERA"           => "Geen camera gevonden op dit apparaat.",
            "CAMERA_ERROR"        => "Camera kon niet worden gestart. Controleer of de camera beschikbaar is.",
            "DECODER_LOAD_FAILED" => "Barcodedecoder kon niet worden geladen. Controleer of lib/zxing/zxing.min.js aanwezig is.",
            _                     => "Onbekende fout bij het starten van de scanner."
        };

        StateHasChanged();
    }

    [JSInvokable]
    public void OnCamerasAvailable(int requestId, object[] cameras)
    {
        // Ignored in start screen; not needed for this flow.
    }

    [JSInvokable]
    public void OnDiagnostics(int requestId, object diagnostics)
    {
        // Ignored in start screen; not needed for this flow.
    }

    [JSInvokable]
    public void OnDecoderSupport(int requestId, object decoderSupport)
    {
        // Ignored in start screen; not needed for this flow.
    }

    private async Task ApplyManualInput()
    {
        var value = _manualInput?.Trim();
        if (string.IsNullOrEmpty(value))
            return;

        if (_scanModule is not null &&
            _status is ScanStatus.Active or ScanStatus.RequestingPermission)
        {
            _requestId++;
            try
            {
                await _scanModule.InvokeVoidAsync("stopScan");
            }
            catch (JSDisconnectedException) { }
            catch (JSException) { }
        }

        _manualInput = null;
        await ProcessScannedValue(value);
        StateHasChanged();
    }

    private async Task HandleManualKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ApplyManualInput();
        }
    }

    private async Task ProcessScannedValue(string code)
    {
        AddRecentScan(code);

        var qrResolution = await StorageService.ResolveQrValueAsync(code);

        // Known location code — navigate directly to location detail
        if (qrResolution.Status == QrStatus.Linked && qrResolution.LinkedLocationId.HasValue)
        {
            NavigationManager.NavigateTo($"/storage/locations/{qrResolution.LinkedLocationId.Value}");
            return;
        }

        // Try as product code
        var productResult = await ProductService.GetByCodeValueAsync(code);
        if (productResult.Success && productResult.Data != null)
        {
            // Known product — navigate to new product scan workcontext
            NavigationManager.NavigateTo($"/scan/product/{productResult.Data.Id}");
            return;
        }

        // Unknown code — handoff to /scan/old with code
        NavigationManager.NavigateTo($"/scan/old?code={Uri.EscapeDataString(code)}");
    }

    private void AddRecentScan(string code)
    {
        var now = DateTimeOffset.UtcNow;

        var existing = _recentScans.FirstOrDefault(s => s.Code == code);
        if (existing != null)
        {
            _recentScans.Remove(existing);
        }

        var display = code.Length > 40 ? code.Substring(0, 37) + "…" : code;

        _recentScans.Insert(0, new RecentScan
        {
            Code = code,
            Display = display,
            TimeAgo = "Just now"
        });
    }

    private async Task RescanRecent(string code)
    {
        await ProcessScannedValue(code);
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        if (_dotnetRef is not null)
        {
            _dotnetRef.Dispose();
        }

        if (_scanModule is not null)
        {
            try
            {
                await _scanModule.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
        }
    }
}
