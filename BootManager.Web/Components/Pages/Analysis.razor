@page "/analysis"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Owner")]
@using BootManager.Application.Analysis.DTOs
@using BootManager.Application.Analysis.Services
@inject IAnalysisService AnalysisService
@inject IJSRuntime JS

<h2 class="mb-3">Technische Analyse</h2>

<div class="card mb-4">
    <div class="card-header">
        <span>Analyse-venster</span>
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-5">
                <label class="form-label">Van *</label>
                <input type="text" class="form-control" placeholder="29-05-2026 20:57"
                       value="@_startDateTimeText" @oninput="OnStartChanged" />
                <small class="form-text text-muted">Gebruik formaat dd-MM-jjjj uu:mm.</small>
            </div>
            <div class="col-md-5">
                <label class="form-label">Tot *</label>
                <input type="text" class="form-control" placeholder="29-05-2026 20:57"
                       value="@_endDateTimeText" @oninput="OnEndChanged" />
                <small class="form-text text-muted">Gebruik formaat dd-MM-jjjj uu:mm.</small>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button class="btn btn-primary w-100" @onclick="FetchAnalysis" disabled="@_loading">
                    @if (_loading)
                    {
                        <span>Laden...</span>
                    }
                    else
                    {
                        <span>Analyseren</span>
                    }
                </button>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(_validationError))
        {
            <div class="alert alert-danger mt-3">@_validationError</div>
        }
    </div>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}

@if (_summary != null)
{
    <div class="card mb-4">
        <div class="card-header">
            <span>Samenvatting voor @_summary.StartUtc:O t/m @_summary.EndUtc:O</span>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <h5>Ruw Overzicht</h5>
                    <div class="mb-2">
                        <strong>Totaal NetworkMessages:</strong>
                        <span class="badge bg-primary">@_summary.TotalNetworkMessages</span>
                    </div>
                </div>
                <div class="col-md-6">
                    <h5>Waarschuwingen / Errors</h5>
                    <small class="text-muted">@_summary.WarningErrorsStatus</small>
                </div>
            </div>
        </div>
    </div>

    @if (_summary.MeasurementCounts.Count > 0)
    {
        <div class="card mb-4">
            <div class="card-header">
                <span>Opgeslagen Metingen per Type</span>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-sm table-striped">
                        <thead>
                            <tr>
                                <th>Meettype</th>
                                <th class="text-end">Aantaal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var mc in _summary.MeasurementCounts)
                            {
                                <tr>
                                    <td>@mc.MeasurementType</td>
                                    <td class="text-end">
                                        <span class="badge bg-success">@mc.Count</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <div class="card">
        <div class="card-header">
            <span>Export</span>
        </div>
        <div class="card-body">
            <p>Exporteer de analyse-samenvatting in het gewenste formaat:</p>
            <button class="btn btn-sm btn-outline-secondary" @onclick="DownloadCSV" disabled="@_exporting">
                @if (_exporting)
                {
                    <span>Bezig...</span>
                }
                else
                {
                    <span>📥 Download CSV</span>
                }
            </button>
            <button class="btn btn-sm btn-outline-secondary ms-2" @onclick="DownloadJSON" disabled="@_exporting">
                @if (_exporting)
                {
                    <span>Bezig...</span>
                }
                else
                {
                    <span>📥 Download JSON</span>
                }
            </button>
        </div>
    </div>
}

@code {
    // String-backed text fields (dd-MM-yyyy HH:mm format)
    private string _startDateTimeText = "";
    private string _endDateTimeText = "";

    // Parsed DateTime values (local time)
    private DateTime _startLocal;
    private DateTime _endLocal;

    // UI state
    private AnalysisSummaryDto? _summary;
    private string _error = "";
    private string _validationError = "";
    private bool _loading = false;
    private bool _exporting = false;

    protected override void OnInitialized()
    {
        // Initialize with default values: 24 hours ago to now (local time)
        _startLocal = DateTime.Now.AddHours(-24);
        _endLocal = DateTime.Now;

        // Format as dd-MM-yyyy HH:mm for display
        var cultureInfo = System.Globalization.CultureInfo.InvariantCulture;
        _startDateTimeText = _startLocal.ToString("dd-MM-yyyy HH:mm", cultureInfo);
        _endDateTimeText = _endLocal.ToString("dd-MM-yyyy HH:mm", cultureInfo);
    }

    private void OnStartChanged(ChangeEventArgs e)
    {
        if (e.Value != null)
        {
            _startDateTimeText = e.Value.ToString() ?? "";
        }
    }

    private void OnEndChanged(ChangeEventArgs e)
    {
        if (e.Value != null)
        {
            _endDateTimeText = e.Value.ToString() ?? "";
        }
    }

    private async Task FetchAnalysis()
    {
        _validationError = "";
        _error = "";

        // Validate and parse
        var cultureInfo = System.Globalization.CultureInfo.InvariantCulture;
        var dateTimeFormat = "dd-MM-yyyy HH:mm";

        // Check if fields are empty
        if (string.IsNullOrWhiteSpace(_startDateTimeText))
        {
            _validationError = "Begintijd is verplicht.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_endDateTimeText))
        {
            _validationError = "Eindtijd is verplicht.";
            return;
        }

        // Try to parse start datetime
        if (!DateTime.TryParseExact(_startDateTimeText, dateTimeFormat, cultureInfo, System.Globalization.DateTimeStyles.None, out _startLocal))
        {
            _validationError = "Gebruik voor Van het formaat dd-MM-jjjj uu:mm.";
            return;
        }

        // Try to parse end datetime
        if (!DateTime.TryParseExact(_endDateTimeText, dateTimeFormat, cultureInfo, System.Globalization.DateTimeStyles.None, out _endLocal))
        {
            _validationError = "Gebruik voor Tot het formaat dd-MM-jjjj uu:mm.";
            return;
        }

        // Check that start < end
        if (_startLocal >= _endLocal)
        {
            _validationError = "Begintijd moet voor eindtijd liggen.";
            return;
        }

        // All valid, fetch analysis
        _loading = true;

        try
        {
            var startUtc = _startLocal.ToUniversalTime();
            var endUtc = _endLocal.ToUniversalTime();

            var request = new AnalysisTimeWindowDto { StartUtc = startUtc, EndUtc = endUtc };
            _summary = await AnalysisService.GetAnalysisSummaryAsync(request);
        }
        catch (Exception ex)
        {
            _error = $"Fout bij ophalen analysegegevens: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task DownloadCSV()
    {
        await DownloadExport("csv");
    }

    private async Task DownloadJSON()
    {
        await DownloadExport("json");
    }

    private async Task DownloadExport(string exportType)
    {
        if (_summary == null) return;

        _exporting = true;
        try
        {
            var content = exportType == "csv" 
                ? AnalysisService.ExportAsCSV(_summary)
                : AnalysisService.ExportAsJSON(_summary);

            var fileExtension = exportType == "csv" ? "csv" : "json";
            var fileName = $"analysis-{_summary.StartUtc:yyyyMMdd-HHmm}-{_summary.EndUtc:yyyyMMdd-HHmm}.{fileExtension}";

            var bytes = System.Text.Encoding.UTF8.GetBytes(content);
            await using var stream = new MemoryStream(bytes);
            using var streamRef = new DotNetStreamReference(stream);
            await JS.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
        }
        catch (Exception ex)
        {
            _error = $"Fout bij export: {ex.Message}";
        }
        finally
        {
            _exporting = false;
        }
    }
}
