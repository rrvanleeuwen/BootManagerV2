    private async Task SaveAsync()
    {
        _formError = null;

        if (string.IsNullOrWhiteSpace(_editingProduct.Name))
        {
            _formError = "Naam is verplicht.";
            return;
        }

        if (_editingProduct.DefaultUnitId == Guid.Empty)
        {
            _formError = "Standaardeenheid is verplicht.";
            return;
        }

        try
        {
            if (_editingProduct.Id == Guid.Empty)
            {
                var pendingCode = _editingProduct.Code;
                var result = await ProductService.CreateAsync(
                    _editingProduct.Name,
                    _editingProduct.Description,
                    _editingProduct.DefaultUnitId,
                    _editingProduct.ActiveCategoryId == Guid.Empty ? null : _editingProduct.ActiveCategoryId);

                if (!result.Success)
                {
                    _formError = result.ErrorMessage;
                    return;
                }

                _editingProduct = result.Data!;

                if (pendingCode != null)
                {
                    var codeResult = await ProductService.AddCodeAsync(
                        _editingProduct.Id,
                        pendingCode.Value,
                        pendingCode.Format);

                    if (!codeResult.Success)
                    {
                        _editingProduct.Code = pendingCode;
                        _formError = $"Product opgeslagen, maar code opslaan mislukte: {codeResult.ErrorMessage}";
                        return;
                    }

                    _editingProduct.Code = codeResult.Data;
                }
            }
            else
            {
                var result = await ProductService.UpdateAsync(
                    _editingProduct.Id,
                    _editingProduct.Name,
                    _editingProduct.Description,
                    _editingProduct.DefaultUnitId,
                    _editingProduct.ActiveCategoryId == Guid.Empty ? null : _editingProduct.ActiveCategoryId);

                if (!result.Success)
                {
                    _formError = result.ErrorMessage;
                    return;
                }
            }

            _editMode = false;
            await LoadOverviewPageAsync(resetPage: false);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fout bij opslaan van product");
            _formError = "Fout bij opslaan.";
        }
    }

