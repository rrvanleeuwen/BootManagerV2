    }

    private async Task SaveMutationFallback()
    {
        if (_fallbackProduct == null || _fallbackSelectedStock == null || string.IsNullOrEmpty(_fallbackMutationType) || _fallbackQuantity <= 0)
        {
            _fallbackError = "Onvolledig formulier.";
            return;
        }

        if (!Enum.TryParse<StockMutationType>(_fallbackMutationType, out var mutationType))
        {
            _fallbackError = "Ongeldig mutatielogtype.";
            return;
        }

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userIdClaim = authState.User.FindFirst("sub")?.Value
            ?? authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (string.IsNullOrWhiteSpace(userIdClaim) || !Guid.TryParse(userIdClaim, out var userId))
        {
            _fallbackError = "Gebruiker niet bepaald.";
            return;
        }

        try
        {
            var result = await StockService.MutateStockAsync(
                _fallbackProduct.Id,
                _fallbackSelectedStock.StorageLocationId,
                mutationType,
                _fallbackQuantity,
                userId,
                string.IsNullOrWhiteSpace(_fallbackNote) ? null : _fallbackNote.Trim());

            if (result.Success)
            {
                CloseMutationFallback();
            }
            else
            {
                _fallbackError = result.ErrorMessage ?? "Opslaan mislukt.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fout bij opslaan van voorraadbijzonderheid");
            _fallbackError = "Fout: " + ex.Message;
        }

        StateHasChanged();
    }
