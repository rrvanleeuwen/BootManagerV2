    private async Task SelectProductFromSearch(ProductDto product)
    {
        // Load finding flow data for the product
        _selectedSearchProduct = product;
        _searchFoundLocations = null;
        _searchExpectedLocation = null;

        var activeStocksResult = await StockService.GetActiveStocksByProductAsync(product.Id);
        _searchFoundLocations = activeStocksResult.Success && activeStocksResult.Data != null
            ? activeStocksResult.Data.ToList()
            : new();

        if (_searchFoundLocations.Count == 1)
        {
            NavigationManager.NavigateTo($"/storage/locations/{_searchFoundLocations[0].StorageLocationId}");
            return;
        }

        if (_searchFoundLocations.Count == 0)
        {
            var expectedResult = await StockService.GetExpectedLocationForProductAsync(product.Id);
            _searchExpectedLocation = expectedResult.Success ? expectedResult.Data : null;
        }

        _showSearchFindingFlow = true;
        StateHasChanged();
    }

