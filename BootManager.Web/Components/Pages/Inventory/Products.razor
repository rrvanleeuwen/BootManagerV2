@page "/inventory/products"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Owner,Crew")]
@using BootManager.Application.Inventory.Contracts
@using BootManager.Application.Inventory.DTOs
@using BootManager.Web.Components.Inventory
@using BootManager.Core.Entities
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject IProductService ProductService
@inject IProductOverviewReadQuery OverviewReadQuery
@inject IProductCategoryService CategoryService
@inject IUnitService UnitService
@inject IStockService StockService
@inject NavigationManager NavigationManager
@inject ILogger<Products> Logger
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Producten</PageTitle>

@if (_showAddStockModal && _selectedSearchProduct != null)
{
    <AddStockToProductModal
        Product="_selectedSearchProduct"
        OnClose="CloseAddStockModal"
        OnStockAdded="HandleAddStockSuccess">
    </AddStockToProductModal>
}

@if (_showProductDetailsPopup && _detailsPopupProduct != null)
{
    <ProductDetailsFromHome
        Product="_detailsPopupProduct"
        OnClose="CloseProductDetailsPopup">
    </ProductDetailsFromHome>
}

@if (!_editMode)
{
    @* Responsieve productzoek- en resultaatpagina (PILOT-INV-06) *@
    <div class="products-header">
        <div class="products-identity">
            <span class="products-eyebrow">Voorraadbeheer</span>
            <h3 class="products-title">Producten</h3>
        </div>
        <button class="btn-new-product" @onclick="OpenCreateForm">
            <i class="fas fa-plus"></i> Nieuw product
        </button>
    </div>

    <div class="products-toolbar desktop-only">
        @if (_showArchived)
        {
            <button class="btn btn-secondary btn-sm" title="Actieve weergeven" @onclick="() => ToggleArchivedAsync(false)">
                <i class="fas fa-eye-slash"></i> Actieve weergeven
            </button>
        }
        else
        {
            <button class="btn btn-secondary btn-sm" title="Gearchiveerde weergeven" @onclick="() => ToggleArchivedAsync(true)">
                <i class="fas fa-archive"></i> Gearchiveerde weergeven
            </button>
        }

        <button class="btn btn-info btn-sm" title="Voorraadbijzonderheid" @onclick="OpenMutationFallback">
            <i class="fas fa-edit"></i> Voorraadbijzonderheid
        </button>
    </div>

    <div class="products-search">
        <i class="fas fa-search search-icon"></i>
        <input type="text" class="products-search-input"
               placeholder="Zoek op productnaam of omschrijving…"
               value="@_searchTerm"
               @oninput="OnSearchInput"
               @onkeydown="HandleSearchKeyDown" />
    </div>

    @if (_errorMessage != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @_errorMessage
            <button type="button" class="btn-close" @onclick="() => _errorMessage = null"></button>
        </div>
    }

    @if (!_loaded)
    {
        <p>Bezig met laden...</p>
    }
    else if (_overviewItems.Count == 0)
    {
        <div class="products-empty">
            @if (_hasSearched)
            {
                <span>Geen producten gevonden.</span>
            }
            else
            {
                <span>Geen producten beschikbaar.</span>
            }
        </div>
    }
    else
    {
        <div class="products-results">
            @foreach (var item in _overviewItems)
            {
                var product = item.Product;
                var hasStock = item.ActiveLocations.Count > 0;

                <div class="product-result">
                    <button type="button" class="product-main" @onclick="() => SelectProductFromSearch(product)">
                        <span class="product-identity">
                            <span class="product-name">@product.Name</span>
                            @if (!string.IsNullOrEmpty(product.Code?.Value))
                            {
                                <span class="product-code">Code: @product.Code!.Value</span>
                            }
                        </span>
                        <span class="product-stock">
                            @* Ook zonder actieve voorraad tonen we de totale hoeveelheid (0) en de eenheid. *@
                            <span class="stock-value">@item.TotalQuantity</span>
                            <span class="stock-unit">@(product.DefaultUnitName ?? "")</span>
                        </span>
                        <span class="product-locations">
                            @if (hasStock)
                            {
                                <span class="locations-label">Locaties:</span>
                                <span class="location-chips">
                                    @foreach (var location in item.ActiveLocations)
                                    {
                                        <span class="location-chip">@location.StorageAreaName - @location.StorageLocationName</span>
                                    }
                                </span>
                            }
                            else
                            {
                                <span class="product-no-stock">Geen actieve voorraad</span>
                            }
                        </span>
                    </button>
                    <div class="product-actions">
                        <button type="button" class="product-action" title="Productdetails" @onclick="() => ShowProductDetailsPopup(product)">
                            <i class="fas fa-info-circle"></i> Details
                        </button>
                        <button type="button" class="product-action" title="Bewerken/code" @onclick="() => NavigateToEditProduct(product)">
                            <i class="fas fa-edit"></i> Bewerken
                        </button>
                        @if (product.IsArchived)
                        {
                            <button type="button" class="product-action" title="Reactiveren" @onclick="() => ReactivateAsync(product.Id)">
                                <i class="fas fa-undo"></i> Reactiveren
                            </button>
                        }
                        else
                        {
                            <button type="button" class="product-action danger" title="Archiveren" @onclick="() => ArchiveAsync(product.Id)">
                                <i class="fas fa-archive"></i> Archiveren
                            </button>
                        }
                    </div>
                </div>
            }
        </div>

        @if (_totalPages > 1)
        {
            <div class="products-pagination">
                <button class="pagination-btn" disabled="@(_currentPage == 1)" @onclick="PreviousPage">Vorige</button>
                <span class="pagination-info">Pagina @_currentPage van @_totalPages</span>
                <button class="pagination-btn" disabled="@(_currentPage >= _totalPages)" @onclick="NextPage">Volgende</button>
            </div>
        }
    }

    @if (_showSearchFindingFlow && _selectedSearchProduct != null)
    {
        <div class="card mt-3 p-3">
            @if (_searchFoundLocations != null && _searchFoundLocations.Count > 0)
            {
                @if (_searchFoundLocations.Count == 1)
                {
                    <div class="alert alert-info">
                        <h6>Product gevonden op één locatie</h6>
                        <strong>@_selectedSearchProduct.Name</strong><br/>
                        Locatie: @_searchFoundLocations[0].StorageAreaName - @_searchFoundLocations[0].StorageLocationName<br/>
                        <small class="text-muted">Hoeveelheid: @_searchFoundLocations[0].Quantity @_searchFoundLocations[0].DefaultUnitName</small>
                        <br/>
                        <button class="btn btn-sm btn-primary mt-2" @onclick="() => NavigateToSearchFoundLocation(0)">Naar locatie</button>
                    </div>
                }
                else
                {
                    <div>
                        <h6>Product gevonden op meerdere locaties</h6>
                        <strong>@_selectedSearchProduct.Name</strong>
                        <div class="list-group mt-2">
                            @foreach (var location in _searchFoundLocations)
                            {
                                <button type="button" class="list-group-item list-group-item-action"
                                        @onclick="() => NavigateToLocation(location.StorageLocationId)">
                                    <div class="d-flex justify-content-between">
                                        <strong>@location.StorageAreaName - @location.StorageLocationName</strong>
                                        <span class="badge bg-primary">@location.Quantity @location.DefaultUnitName</span>
                                    </div>
                                </button>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="alert alert-warning">
                    <h6>Geen actieve voorraad</h6>
                    <strong>@_selectedSearchProduct.Name</strong> is bekend maar momenteel niet op voorraad.
                    @if (_searchExpectedLocation != null)
                    {
                        <div class="alert alert-info mt-2">
                            <strong>Verwachte locatie:</strong><br/>
                            @_searchExpectedLocation.StorageAreaName - @_searchExpectedLocation.StorageLocationName
                        </div>
                    }
                    <button class="btn btn-sm btn-primary" @onclick="NavigateToAddStock">
                        Voorraad toevoegen
                    </button>
                </div>
            }
            <button class="btn btn-sm btn-outline-secondary mt-2" @onclick="CloseSearchFindingFlow">Sluiten</button>
        </div>
    }
}
else
{
    @* Edit/Create form view *@
    <h3>Producten</h3>

    @if (_formError != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @_formError
            <button type="button" class="btn-close" @onclick="() => _formError = null"></button>
        </div>
    }

    <form @onsubmit="SaveAsync" class="row g-3">
        <div class="col-md-6">
            <label class="form-label">Naam *</label>
            <input type="text" class="form-control" @bind="_editingProduct.Name" placeholder="Productnaam">
        </div>

        <div class="col-md-6">
            <label class="form-label">Omschrijving</label>
            <input type="text" class="form-control" @bind="_editingProduct.Description" placeholder="Optionele omschrijving">
        </div>

        <div class="col-md-6">
            <label class="form-label">Categorie</label>
            <div class="input-group">
                <select class="form-select" @bind="_editingProduct.ActiveCategoryId">
                    <option value="">-- Geen categorie --</option>
                    @foreach (var category in _activeCategories)
                    {
                        <option value="@category.Id.ToString()">@category.Name</option>
                    }
                </select>
                <button type="button" class="btn btn-outline-secondary" @onclick="OpenAddCategoryModal" title="Nieuwe categorie">
                    <i class="fas fa-plus"></i>
                </button>
            </div>
        </div>

        <div class="col-md-6">
            <label class="form-label">Standaardeenheid *</label>
            <div class="input-group">
                <select class="form-select" @bind="_editingProduct.DefaultUnitId">
                    <option value="">-- Selecteer eenheid --</option>
                    @foreach (var unit in _activeUnits)
                    {
                        <option value="@unit.Id.ToString()">@unit.Name</option>
                    }
                </select>
                <button type="button" class="btn btn-outline-secondary" @onclick="OpenAddUnitModal" title="Nieuwe eenheid">
                    <i class="fas fa-plus"></i>
                </button>
            </div>
        </div>

        <div class="col-12">
            <h5>Gekoppelde code</h5>
            @if (_editingProduct.Code == null)
            {
                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => _showAddCodeForm = true">
                    <i class="fas fa-barcode"></i> Code toevoegen
                </button>
            }
            else
            {
                <div class="card">
                    <div class="card-body">
                        <p class="mb-2"><strong>Waarde:</strong> @_editingProduct.Code.Value</p>
                        <p class="mb-2"><strong>Formaat:</strong> @_editingProduct.Code.Format</p>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => _showAddCodeForm = true">
                            <i class="fas fa-edit"></i> Vervangen
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="RemoveCodeAsync">
                            <i class="fas fa-trash"></i> Verwijderen
                        </button>
                    </div>
                </div>
            }

            @if (_showAddCodeForm)
            {
                <div class="mt-3 p-3 border rounded">
                    <div class="mb-3">
                        <label class="form-label">Code-waarde *</label>
                        <input type="text" class="form-control" @bind="_newCodeValue" placeholder="Voer code in of scan">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Formaat *</label>
                        <select class="form-select" @bind="_newCodeFormat">
                            <option value="">-- Selecteer --</option>
                            <option value="barcode">Barcode</option>
                            <option value="qr">QR-code</option>
                            <option value="text">Vrije tekst</option>
                        </select>
                    </div>
                    <button type="button" class="btn btn-sm btn-primary" @onclick="SaveCodeAsync">Opslaan</button>
                    <button type="button" class="btn btn-sm btn-secondary" @onclick="() => _showAddCodeForm = false">Annuleren</button>
                </div>
            }
        </div>

        <div class="col-12">
            <button type="submit" class="btn btn-primary">Opslaan</button>
            <button type="button" class="btn btn-secondary" @onclick="CancelForm">Annuleren</button>
        </div>
    </form>
}

@* Add Category Modal *@
<div class="modal fade @(_addCategoryModalOpen ? "show" : "")" style="display: @(_addCategoryModalOpen ? "block" : "none");" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Nieuwe categorie</h5>
                <button type="button" class="btn-close" @onclick="() => _addCategoryModalOpen = false"></button>
            </div>
            <div class="modal-body">
                @if (_addCategoryError != null)
                {
                    <div class="alert alert-danger alert-sm mb-3">
                        @_addCategoryError
                    </div>
                }

                <div class="mb-3">
                    <label class="form-label">Naam *</label>
                    <input type="text" class="form-control" @bind="_newCategoryName" placeholder="Categorienaam">
                </div>

                <div class="mb-3">
                    <label class="form-label">Omschrijving</label>
                    <textarea class="form-control" @bind="_newCategoryDescription" rows="3" placeholder="Optionele omschrijving"></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label">Icoon *</label>
                    <select class="form-select" @bind="_newCategoryIconKey">
                        <option value="">-- Selecteer icoon --</option>
                        @foreach (var iconKey in _validIconKeys)
                        {
                            <option value="@iconKey">@iconKey <i class="fas fa-@GetIconClass(iconKey)"></i></option>
                        }
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="() => _addCategoryModalOpen = false">Annuleren</button>
                <button type="button" class="btn btn-primary" @onclick="SaveNewCategoryAsync">Opslaan</button>
            </div>
        </div>
    </div>
</div>

@* Add Unit Modal *@
<div class="modal fade @(_addUnitModalOpen ? "show" : "")" style="display: @(_addUnitModalOpen ? "block" : "none");" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Nieuwe eenheid</h5>
                <button type="button" class="btn-close" @onclick="() => _addUnitModalOpen = false"></button>
            </div>
            <div class="modal-body">
                @if (_addUnitError != null)
                {
                    <div class="alert alert-danger alert-sm mb-3">
                        @_addUnitError
                    </div>
                }

                <div class="mb-3">
                    <label class="form-label">Naam *</label>
                    <input type="text" class="form-control" @bind="_newUnitName" placeholder="Eenheidsnaam">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="() => _addUnitModalOpen = false">Annuleren</button>
                <button type="button" class="btn btn-primary" @onclick="SaveNewUnitAsync">Opslaan</button>
            </div>
        </div>
    </div>
</div>

@if (_showMutationFallback)
{
    <div class="modal d-block" style="display: block; background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Voorraadbijzonderheid vastleggen</h5>
                    <button type="button" class="btn-close" @onclick="CloseMutationFallback"></button>
                </div>
                <div class="modal-body">
                    @if (_fallbackError != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @_fallbackError
                            <button type="button" class="btn-close" @onclick="() => _fallbackError = null"></button>
                        </div>
                    }

                    @if (_fallbackProduct == null)
                    {
                        <div class="mb-3">
                            <label class="form-label">Product selecteren *</label>
                            <input type="text" class="form-control" placeholder="Typ productnaam…" @bind="_fallbackSearchTerm" />
                            <button class="btn btn-sm btn-primary mt-2" @onclick="PerformMutationFallbackSearch">Zoeken</button>
                        </div>

                        @if (_fallbackSearchResults != null && _fallbackSearchResults.Count > 0)
                        {
                            <div class="list-group">
                                @foreach (var product in _fallbackSearchResults)
                                {
                                    <button type="button" class="list-group-item list-group-item-action" @onclick="() => SelectProductForMutationFallback(product)">
                                        <strong>@product.Name</strong>
                                        @if (!string.IsNullOrEmpty(product.Description))
                                        {
                                            <br />
                                            <small class="text-muted">@(product.Description.Length > 60 ? product.Description.Substring(0, 60) + "…" : product.Description)</small>
                                        }
                                    </button>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div class="alert alert-info mb-3">
                            <strong>Product:</strong> @_fallbackProduct.Name<br />
                        </div>

                        @if (_fallbackSelectedStock == null && _fallbackProductLocations != null)
                        {
                            <div class="mb-3">
                                <label class="form-label">Locatie selecteren *</label>
                                @if (_fallbackProductLocations.Count == 1)
                                {
                                    <div class="alert alert-info">
                                        Automatisch geselecteerd: <strong>@_fallbackProductLocations[0].StorageAreaName - @_fallbackProductLocations[0].StorageLocationName</strong>
                                        <button class="btn btn-sm btn-primary mt-2" @onclick="() => _fallbackSelectedStock = _fallbackProductLocations[0]">Doorgaan</button>
                                    </div>
                                }
                                else if (_fallbackProductLocations.Count > 0)
                                {
                                    <div class="list-group">
                                        @foreach (var stock in _fallbackProductLocations)
                                        {
                                            <button type="button" class="list-group-item list-group-item-action" @onclick="() => _fallbackSelectedStock = stock">
                                                <div class="d-flex justify-content-between">
                                                    <strong>@stock.StorageAreaName - @stock.StorageLocationName</strong>
                                                    <span class="badge bg-primary">@stock.Quantity @stock.DefaultUnitName</span>
                                                </div>
                                            </button>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-warning">
                                        Geen actieve voorraad beschikbaar voor dit product.
                                    </div>
                                }
                            </div>
                        }
                        else if (_fallbackSelectedStock != null)
                        {
                            <div class="alert alert-info mb-3">
                                <strong>Locatie:</strong> @_fallbackSelectedStock.StorageAreaName - @_fallbackSelectedStock.StorageLocationName<br />
                                <strong>Huidige hoeveelheid:</strong> @_fallbackSelectedStock.Quantity @_fallbackSelectedStock.DefaultUnitName
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Mutatielogtype *</label>
                                <select class="form-select" @bind="_fallbackMutationType">
                                    <option value="">-- Selecteer type --</option>
                                    <option value="Verbruik">Verbruik (afname)</option>
                                    <option value="Correctie">Correctie (herzien hoeveelheid)</option>
                                    <option value="Telling">Telling (gecontroleerde hoeveelheid)</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">
                                    @if (_fallbackMutationType == "Verbruik")
                                    {
                                        <span>Afnamehoeveelheid *</span>
                                    }
                                    else if (_fallbackMutationType == "Correctie" || _fallbackMutationType == "Telling")
                                    {
                                        <span>Nieuwe hoeveelheid *</span>
                                    }
                                    else
                                    {
                                        <span>Hoeveelheid *</span>
                                    }
                                </label>
                                <div class="input-group">
                                    <input type="number" class="form-control" step="0.01"
                                           @bind="_fallbackQuantity" placeholder="0" />
                                    <span class="input-group-text">@_fallbackSelectedStock?.DefaultUnitName</span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Notitie (optioneel)</label>
                                <textarea class="form-control" @bind="_fallbackNote" placeholder="Vrije notitie…" rows="2"></textarea>
                            </div>

                            <button class="btn btn-sm btn-primary" @onclick="SaveMutationFallback"
                                    disabled="@(string.IsNullOrEmpty(_fallbackMutationType) || _fallbackQuantity <= 0)">
                                Opslaan
                            </button>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="ClearMutationForm">
                                Terug
                            </button>
                        }
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseMutationFallback">Sluiten</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_addCategoryModalOpen || _addUnitModalOpen || _showMutationFallback)
{
    <div class="modal-backdrop fade show"></div>
}

@code {
    /// <summary>
    /// Optionele deep-link: opent bij het laden direct de bewerkform van het product met
    /// dit id, zodat een gebruiker vanuit een zoekresultaat meteen een code kan toevoegen
    /// of wijzigen zonder door de volledige productlijst te scrollen.
    /// </summary>
    [Parameter]
    [SupplyParameterFromQuery(Name = "editProductId")]
    public Guid? EditProductId { get; set; }

    private Guid? _handledEditProductId;

    private List<ProductCategoryDto> _activeCategories = new();
    private List<UnitDto> _activeUnits = new();
    private bool _showArchived = false;
    private bool _editMode = false;
    private bool _loaded = false;
    private ProductDto _editingProduct = new();
    private string? _errorMessage;
    private string? _formError;
    private IReadOnlyList<string> _validIconKeys = new List<string>();

    // Form-lookups (categorieën, eenheden, icoonsleutels) worden pas geladen wanneer de
    // gebruiker een productform voor aanmaken of bewerken opent, niet bij de paginaopbouw.
    private bool _formLookupsLoaded = false;

    // Overzicht: zoek- en resultaatstate. De gepagineerde read levert per pagina alleen de
    // zichtbare producten met hun reeds gebatchte actieve voorraad.
    private string _searchTerm = "";
    private bool _hasSearched = false;
    private List<ProductOverviewItemDto> _overviewItems = new();
    private int _totalCount = 0;
    private int _currentPage = 1;
    private const int ItemsPerPage = 10;
    private int _totalPages = 1;

    // Finding flow (primaire klik op resultaat)
    private bool _showSearchFindingFlow = false;
    private ProductDto? _selectedSearchProduct;
    private List<StockDto>? _searchFoundLocations;
    private StockDto? _searchExpectedLocation;

    private bool _addCategoryModalOpen = false;
    private string _newCategoryName = "";
    private string? _newCategoryDescription;
    private string _newCategoryIconKey = "";
    private string? _addCategoryError;

    private bool _addUnitModalOpen = false;
    private string _newUnitName = "";
    private string? _addUnitError;

    private bool _showAddCodeForm = false;
    private string _newCodeValue = "";
    private string _newCodeFormat = "";

    private bool _showAddStockModal = false;

    // Product details popup (zoekresultaat detailactie)
    private bool _showProductDetailsPopup = false;
    private ProductDto? _detailsPopupProduct;

    // Mutation fallback state (eigen zoekvelden, losstaand van het hoofdoverzicht)
    private bool _showMutationFallback = false;
    private string _fallbackSearchTerm = "";
    private List<ProductDto>? _fallbackSearchResults;
    private ProductDto? _fallbackProduct;
    private List<StockDto>? _fallbackProductLocations;
    private StockDto? _fallbackSelectedStock;
    private string _fallbackMutationType = "";
    private decimal _fallbackQuantity = 0;
    private string? _fallbackNote;
    private string? _fallbackError;

    protected override async Task OnInitializedAsync()
    {
        await LoadOverviewPageAsync(resetPage: true);
    }

    /// <summary>
    /// Verwerkt de <see cref="EditProductId"/> deep-link. Draait na het laden van de data
    /// (eerste weergave) en opnieuw wanneer op dezelfde pagina naar een ander product-id
    /// wordt genavigeerd. Haalt het ene doelproduct op aanvraag op zonder de volledige
    /// catalogus te laden. Een onbekend id laat de pagina bruikbaar en toont een melding.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        if (EditProductId == _handledEditProductId)
        {
            return;
        }

        _handledEditProductId = EditProductId;

        if (!EditProductId.HasValue)
        {
            return;
        }

        await EnsureFormLookupsLoadedAsync();

        var result = await ProductService.GetByIdAsync(EditProductId.Value);
        if (!result.Success || result.Data == null)
        {
            _errorMessage = "Product niet gevonden voor bewerken.";
            _editMode = false;
            return;
        }

        _errorMessage = null;
        OpenEditForm(result.Data);
    }

    /// <summary>
    /// Laadt via de gepagineerde read exact de huidige pagina uit de database: gefilterd op
    /// archiefstand en zoekterm, stabiel gesorteerd, met de actieve voorraad reeds gebatcht.
    /// Er wordt geen volledige catalogus geladen en geen losse voorraadquery per product gedaan.
    /// </summary>
    private async Task LoadOverviewPageAsync(bool resetPage)
    {
        if (resetPage)
        {
            _currentPage = 1;
        }

        try
        {
            _hasSearched = !string.IsNullOrWhiteSpace(_searchTerm);
            var term = _hasSearched ? _searchTerm.Trim() : null;

            var pageResult = await OverviewReadQuery.GetPageAsync(term, _showArchived, _currentPage, ItemsPerPage);
            _totalCount = pageResult.TotalCount;
            _totalPages = Math.Max(1, (int)Math.Ceiling(_totalCount / (double)ItemsPerPage));

            if (_currentPage > _totalPages)
            {
                _currentPage = _totalPages;
                pageResult = await OverviewReadQuery.GetPageAsync(term, _showArchived, _currentPage, ItemsPerPage);
            }

            _overviewItems = pageResult.Items.ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fout bij laden van productoverzicht");
            _errorMessage = "Fout bij laden van data.";
            _overviewItems = new();
        }
        finally
        {
            _loaded = true;
        }
    }

    /// <summary>
    /// Laadt de form-lookups (categorieën, eenheden, default-eenheden en icoonsleutels) één
    /// keer, pas wanneer een aanmaak- of bewerkform ze nodig heeft.
    /// </summary>
    private async Task EnsureFormLookupsLoadedAsync()
    {
        if (_formLookupsLoaded)
        {
            return;
        }

        await UnitService.InitializeDefaultUnitsAsync();
        _activeCategories = (await CategoryService.GetActiveAsync()).ToList();
        _activeUnits = (await UnitService.GetActiveAsync()).ToList();
        _validIconKeys = CategoryService.GetValidIconKeys();
        _formLookupsLoaded = true;
    }

    /// <summary>
    /// Voert de zoekopdracht uit: een nieuwe zoekopdracht begint altijd op pagina 1 en vraagt
    /// de server-side pagina op.
    /// </summary>
    private async Task PerformSearch()
    {
        await LoadOverviewPageAsync(resetPage: true);
    }

    private async Task NextPage()
    {
        if (_currentPage < _totalPages)
        {
            _currentPage++;
            await LoadOverviewPageAsync(resetPage: false);
        }
    }

    private async Task PreviousPage()
    {
        if (_currentPage > 1)
        {
            _currentPage--;
            await LoadOverviewPageAsync(resetPage: false);
        }
    }

