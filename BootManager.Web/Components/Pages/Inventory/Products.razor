    private void CancelForm()
    {
        _editMode = false;

        // Als de form via de deep-link (?editProductId=<id>) is geopend, verwijderen we die
        // queryparameter bij annuleren. De daaropvolgende parametercyclus zet
        // _handledEditProductId terug op null, zodat opnieuw op Bewerken klikken voor
        // hetzelfde product de form weer opent. Voor een nieuw (nog niet opgeslagen) product
        // is er geen queryparameter en behouden we de bestaande terugkeer zonder routewijziging.
        if (EditProductId.HasValue)
