@page "/dashboard"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Owner")]
@implements IAsyncDisposable
@using System.Globalization
@using System.Text.Json
@using BootManager.Application.Dashboard.DTOs
@using BootManager.Application.Dashboard.Services
@using BootManager.Application.OperationalSettings.DTOs
@using BootManager.Application.OperationalSettings.Services
@using BootManager.Web.Services
@using BootManager.Core.Entities
@inject IDashboardMeasurementService DashboardMeasurementService
@inject IOperationalSettingsWithReloadService OperationalSettingsWithReloadService
@inject ILogger<Dashboard> Logger
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="d-flex justify-content-between align-items-center">
                <h2 class="mb-0">BootManager Dashboard</h2>
                <!-- Ingest Toggle in Header (rechts uitgelijd) -->
                <div class="d-flex align-items-center gap-2">
                    @if (!isLoading && settings != null)
                    {
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="ingestToggleHeader"
                                checked="@ingestProcessingEnabled"
                                @onchange="OnIngestProcessingToggled"
                                disabled="@isSubmitting" />
                            <label class="form-check-label" for="ingestToggleHeader">
                                @if (ingestProcessingEnabled)
                                {
                                    <span class="badge bg-success">NMEA aan</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">NMEA uit</span>
                                }
                            </label>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(warningMessage))
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            @warningMessage
            <button type="button" class="btn-close" @onclick="() => warningMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
        </div>
    }

    <!-- Huidige Meetwaarden Sectie -->
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Actuele Meetwaarden</h5>
                </div>
                <div class="card-body">
                    @if (measurementsError != null)
                    {
                        <div class="alert alert-danger" role="alert">
                            @measurementsError
                        </div>
                    }

                    @if (currentMeasurements == null)
                    {
                        <div class="text-center">
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Laden...</span>
                            </div>
                        </div>
                    }
                    else if (!currentMeasurements.HasAnyData)
                    {
                        <div class="alert alert-info">
                            <p class="mb-0">Geen meetgegevens beschikbaar. Zorg ervoor dat NMEA-verwerking actief is en boordgegevens binnenkomen.</p>
                        </div>
                    }
                    else
                    {
                        <div class="row mb-2">
                            <div class="col-md-12">
                                @{
                                    var latestMeasurementTime = GetLatestMeasurementTime();
                                    if (latestMeasurementTime.HasValue)
                                    {
                                        <small class="text-muted">Laatste meting: @FormatTimestamp(latestMeasurementTime) · <span class="text-secondary" style="font-size: 0.85em;">scherm ververst elke @autoRefreshIntervalSeconds s</span></small>
                                    }
                                    else
                                    {
                                        <small class="text-muted">Laatste meting: geen data · <span class="text-secondary" style="font-size: 0.85em;">scherm ververst elke @autoRefreshIntervalSeconds s</span></small>
                                    }
                                }
                            </div>
                        </div>
                        <div class="row">
                            <!-- Wind Angle - Compass Gauge (Heading-up) -->
                            @if (IsItemVisible("WindAngle"))
                            {
                                var windAngleValue = currentMeasurements.Wind.AngleDegrees.Value.ToString("F0", CultureInfo.CurrentCulture) + "°";
                                <CompassGaugeTile
                                    Title="Windhoek"
                                    AbsoluteAngle="currentMeasurements.Wind.AngleDegrees.Value"
                                    ShipHeading="currentMeasurements.Heading.HasData && currentMeasurements.Heading.HeadingDegrees.HasValue ? currentMeasurements.Heading.HeadingDegrees : null"
                                    Value="@windAngleValue"
                                    Timestamp="@FormatTimestamp(currentMeasurements.Wind.RecordedAtUtc)"
                                    NeedleColor="#d00"
                                    OnHideCallback="@(async () => await HideMeasurement("WindAngle"))">
                                </CompassGaugeTile>
                            }

                            <!-- Wind Speed - Linear Gauge -->
                            @if (IsItemVisible("WindSpeed"))
                            {
                                var speedVal = currentMeasurements.Wind.SpeedMetersPerSecond.Value;
                                var maxSpeed = 20m;
                                var fillPercent = Math.Min((speedVal / maxSpeed) * 90, 90);
                                <LinearGaugeTile
                                    Title="Windsnelheid"
                                    Value="@currentMeasurements.Wind.SpeedMetersPerSecond.Value.ToString("F1", CultureInfo.CurrentCulture)"
                                    Unit="m/s"
                                    FillWidth="@fillPercent"
                                    GaugeColor="#ff6b35"
                                    Timestamp="@FormatTimestamp(currentMeasurements.Wind.RecordedAtUtc)"
                                    OnHideCallback="@(async () => await HideMeasurement("WindSpeed"))">
                                </LinearGaugeTile>
                            }

                            <!-- Heading - Compass Gauge (Heading-up) -->
                            @if (IsItemVisible("Heading"))
                            {
                                var headingValue = currentMeasurements.Heading.HeadingDegrees.Value.ToString("F1", CultureInfo.CurrentCulture) + "°";
                                <CompassGaugeTile
                                    Title="Koers (Heading)"
                                    AbsoluteAngle="currentMeasurements.Heading.HeadingDegrees.Value"
                                    ShipHeading="currentMeasurements.Heading.HeadingDegrees"
                                    Value="@headingValue"
                                    Timestamp="@FormatTimestamp(currentMeasurements.Heading.RecordedAtUtc)"
                                    NeedleColor="#0066cc"
                                    ShowForwardMarker="true"
                                    OnHideCallback="@(async () => await HideMeasurement("Heading"))">
                                </CompassGaugeTile>
                            }

                            <!-- Position - Text Fields -->
                            @if (IsItemVisible("Position"))
                            {
                                <PositionTile
                                    Latitude="@currentMeasurements.Position.Latitude.Value.ToString("F4", CultureInfo.CurrentCulture)"
                                    Longitude="@currentMeasurements.Position.Longitude.Value.ToString("F4", CultureInfo.CurrentCulture)"
                                    Timestamp="@FormatTimestamp(currentMeasurements.Position.RecordedAtUtc)"
                                    OnHideCallback="@(async () => await HideMeasurement("Position"))">
                                </PositionTile>
                            }

                            <!-- Speed Through Water - Linear Gauge -->
                            @if (IsItemVisible("SpeedThroughWater"))
                            {
                                var stwVal = currentMeasurements.SpeedThroughWater.SpeedKnots.Value;
                                var maxSTW = 20m;
                                var fillSTW = Math.Min((stwVal / maxSTW) * 90, 90);
                                <LinearGaugeTile
                                    Title="Snelheid (door water)"
                                    Value="@currentMeasurements.SpeedThroughWater.SpeedKnots.Value.ToString("F1", CultureInfo.CurrentCulture)"
                                    Unit="kn"
                                    FillWidth="@fillSTW"
                                    GaugeColor="#4CAF50"
                                    Timestamp="@FormatTimestamp(currentMeasurements.SpeedThroughWater.RecordedAtUtc)"
                                    OnHideCallback="@(async () => await HideMeasurement("SpeedThroughWater"))">
                                </LinearGaugeTile>
                            }

                            <!-- COG - Compass Gauge (Heading-up) -->
                            @if (IsItemVisible("CourseOverGround"))
                            {
                                var cogValue = currentMeasurements.Motion.CourseOverGroundDegrees.Value.ToString("F1", CultureInfo.CurrentCulture) + "°";
                                <CompassGaugeTile
                                    Title="Koers over Grond (COG)"
                                    AbsoluteAngle="currentMeasurements.Motion.CourseOverGroundDegrees.Value"
                                    ShipHeading="currentMeasurements.Heading.HasData && currentMeasurements.Heading.HeadingDegrees.HasValue ? currentMeasurements.Heading.HeadingDegrees : null"
                                    Value="@cogValue"
                                    Timestamp="@FormatTimestamp(currentMeasurements.Motion.RecordedAtUtc)"
                                    NeedleColor="#FF9800"
                                    OnHideCallback="@(async () => await HideMeasurement("CourseOverGround"))">
                                </CompassGaugeTile>
                            }

                            <!-- SOG - Linear Gauge -->
                            @if (IsItemVisible("SpeedOverGround"))
                            {
                                var sogVal = currentMeasurements.Motion.SpeedOverGroundKnots.Value;
                                var maxSOG = 20m;
                                var fillSOG = Math.Min((sogVal / maxSOG) * 90, 90);
                                <LinearGaugeTile
                                    Title="Snelheid over Grond (SOG)"
                                    Value="@currentMeasurements.Motion.SpeedOverGroundKnots.Value.ToString("F1", CultureInfo.CurrentCulture)"
                                    Unit="kn"
                                    FillWidth="@fillSOG"
                                    GaugeColor="#2196F3"
                                    Timestamp="@FormatTimestamp(currentMeasurements.Motion.RecordedAtUtc)"
                                    OnHideCallback="@(async () => await HideMeasurement("SpeedOverGround"))">
                                </LinearGaugeTile>
                            }

                            <!-- Depth - Linear Gauge -->
                            @if (IsItemVisible("Depth"))
                            {
                                var depthVal = currentMeasurements.Depth.DepthMeters.Value;
                                var maxDepth = 30m;
                                var fillDepth = Math.Min((depthVal / maxDepth) * 90, 90);
                                <LinearGaugeTile
                                    Title="Diepte"
                                    Value="@currentMeasurements.Depth.DepthMeters.Value.ToString("F1", CultureInfo.CurrentCulture)"
                                    Unit="m"
                                    FillWidth="@fillDepth"
                                    GaugeColor="#9C27B0"
                                    Timestamp="@FormatTimestamp(currentMeasurements.Depth.RecordedAtUtc)"
                                    OnHideCallback="@(async () => await HideMeasurement("Depth"))">
                                </LinearGaugeTile>
                            }

                            <!-- Water Temperature - Linear Gauge -->
                            @if (IsItemVisible("WaterTemperature"))
                            {
                                var tempVal = currentMeasurements.WaterTemperature.TemperatureCelsius.Value;
                                var minTemp = 0m;
                                var maxTemp = 30m;
                                var fillTemp = Math.Min(((tempVal - minTemp) / (maxTemp - minTemp)) * 90, 90);
                                <LinearGaugeTile
                                    Title="Watertemperatuur"
                                    Value="@currentMeasurements.WaterTemperature.TemperatureCelsius.Value.ToString("F1", CultureInfo.CurrentCulture)"
                                    Unit="°C"
                                    FillWidth="@fillTemp"
                                    GaugeColor="#E91E63"
                                    Timestamp="@FormatTimestamp(currentMeasurements.WaterTemperature.RecordedAtUtc)"
                                    OnHideCallback="@(async () => await HideMeasurement("WaterTemperature"))">
                                </LinearGaugeTile>
                            }

                            <!-- Battery Voltage - Linear Gauge -->
                            @if (IsItemVisible("Battery"))
                            {
                                var voltVal = currentMeasurements.Battery.Voltage.Value;
                                var minVolt = 10m;
                                var maxVolt = 15m;
                                var fillVolt = Math.Min(((voltVal - minVolt) / (maxVolt - minVolt)) * 90, 90);
                                var voltColor = voltVal < 11m ? "#FF0000" : voltVal < 12m ? "#FFA500" : "#4CAF50";
                                <LinearGaugeTile
                                    Title="Spanning"
                                    Value="@currentMeasurements.Battery.Voltage.Value.ToString("F2", CultureInfo.CurrentCulture)"
                                    Unit="V"
                                    FillWidth="@fillVolt"
                                    GaugeColor="@voltColor"
                                    Timestamp="@FormatTimestamp(currentMeasurements.Battery.RecordedAtUtc)"
                                    OnHideCallback="@(async () => await HideMeasurement("Battery"))">
                                </LinearGaugeTile>
                            }
                        </div>
                    }

                    <!-- Fluid Level Tiles -->
                    @if (currentMeasurements?.FluidLevels.Count > 0)
                    {
                        <div class="row">
                            @foreach (var fluid in currentMeasurements.FluidLevels)
                            {
                                var fluidKey = GetFluidLevelKey(fluid.FluidType, fluid.FluidInstance);
                                @if (IsItemVisible(fluidKey))
                                {
                                    <FluidLevelTile
                                        Title="@GetFluidLevelLabel(fluid.FluidType, fluid.FluidInstance)"
                                        LevelPercent="@(fluid.LevelPercent?.ToString("F1", CultureInfo.CurrentCulture))"
                                        LevelPercentValue="@(fluid.LevelPercent ?? 0)"
                                        IsLevelInvalid="@(fluid.IsLevelInvalid == true)"
                                        CapacityLiters="@(fluid.CapacityLiters?.ToString("F0", CultureInfo.CurrentCulture))"
                                        Timestamp="@FormatTimestamp(fluid.RecordedAtUtc)"
                                        OnHideCallback="@(async () => await HideMeasurement(fluidKey))">
                                    </FluidLevelTile>
                                }
                            }
                        </div>
                    }

                    <!-- All Hidden Message -->
                    @{
                        var availableItems = GetAvailableDashboardItems();
                        var visibleItems = GetVisibleDashboardItems();
                        var hiddenMeasurements = GetAvailableButHiddenMeasurements();
                    }
                    @if (availableItems.Count > 0 && visibleItems.Count == 0)
                    {
                        <div class="alert alert-info mt-3">
                            <p class="mb-3"><strong>Alle beschikbare meetwaarden zijn verborgen.</strong> Voeg hieronder een meetwaarde terug toe.</p>
                        </div>
                    }

                    <!-- Restore Hidden Measurements -->
                    @if (hiddenMeasurements.Count > 0)
                    {
                        <HiddenMeasurementsList
                            HiddenMeasurements="@hiddenMeasurements"
                            OnShowMeasurement="@ShowMeasurement">
                        </HiddenMeasurementsList>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    /// <summary>
    /// Interne representatie van een dashboarditem voor beschikbaarheid/zichtbaarheid-tracking.
    /// </summary>
    private record DashboardItem(string Key, string Label);

    private OperationalSettingsDto? settings;
    private bool ingestProcessingEnabled;
    private bool isLoading = true;
    private bool isSubmitting = false;
    private string? errorMessage;
    private string? successMessage;
    private string? warningMessage;

    private CurrentMeasurementsDto? currentMeasurements;
    private string? measurementsError;

    private Timer? pollingTimer;
    private CancellationTokenSource? cancellationTokenSource;
    private IJSObjectReference? browserTimeModule;
    private int? browserTimezoneOffsetMinutes;
    private int autoRefreshIntervalSeconds = 10;

    // Dashboard visibility state
    private HashSet<string> hiddenMeasurementKeys = new();
    private const string LocalStorageKey = "dashboard-hidden-keys";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            settings = await OperationalSettingsWithReloadService.GetOperationalSettingsAsync();
            ingestProcessingEnabled = settings?.IngestProcessingEnabled ?? true;
            isLoading = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fout bij laden operationele instellingen");
            errorMessage = "Kon operationele instellingen niet laden.";
            isLoading = false;
        }

        await LoadMeasurements();
        StartAutoRefresh();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            browserTimeModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/browserTime.js");
            browserTimezoneOffsetMinutes = await browserTimeModule.InvokeAsync<int>("getTimezoneOffsetMinutes");

            try
            {
                var hiddenKeysJson = await JS.InvokeAsync<string?>("localStorage.getItem", LocalStorageKey);
                if (!string.IsNullOrEmpty(hiddenKeysJson))
                {
                    var keys = JsonSerializer.Deserialize<List<string>>(hiddenKeysJson) ?? new();
                    hiddenMeasurementKeys = new HashSet<string>(keys);
                }
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Kon hidden measurement keys niet laden uit localStorage");
            }

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Kon browser-tijdzone niet bepalen; dashboard toont UTC-tijden.");
        }
    }

    private void StartAutoRefresh()
    {
        int interval = 10;
        if (settings?.DefaultSampleIntervalSeconds > 0)
            interval = Math.Min(Math.Max(settings.DefaultSampleIntervalSeconds, 5), 60);

        autoRefreshIntervalSeconds = interval;
        cancellationTokenSource = new CancellationTokenSource();
        pollingTimer = new Timer(async _ =>
        {
            if (!cancellationTokenSource.Token.IsCancellationRequested)
            {
                await LoadMeasurements();
                await InvokeAsync(StateHasChanged);
            }
        }, null, TimeSpan.FromSeconds(interval), TimeSpan.FromSeconds(interval));
    }

    private bool IsItemVisible(string key)
    {
        return GetVisibleDashboardItems().Any(x => x.Key == key);
    }

    private void PurgeInvalidHiddenKeys()
    {
        // Verwijder hidden keys die niet meer in de beschikbare items voorkomen
        var availableKeys = GetAvailableDashboardItems().Select(x => x.Key).ToHashSet();
        var invalidKeys = hiddenMeasurementKeys.Where(k => !availableKeys.Contains(k)).ToList();
        foreach (var invalidKey in invalidKeys)
        {
            hiddenMeasurementKeys.Remove(invalidKey);
        }
    }

    private async Task LoadMeasurements()
    {
        try
        {
            measurementsError = null;
            currentMeasurements = await DashboardMeasurementService.GetCurrentMeasurementsAsync();

            // Valideer en zuiver verouderde hidden keys
            PurgeInvalidHiddenKeys();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fout bij laden meetwaarden");
            measurementsError = "Kon meetwaarden niet laden.";
        }
    }

    private string FormatTimestamp(DateTime? utcTime)
    {
        if (!utcTime.HasValue)
            return "Geen tijd";

        var utcValue = DateTime.SpecifyKind(utcTime.Value, DateTimeKind.Utc);
        if (!browserTimezoneOffsetMinutes.HasValue)
            return utcValue.ToString("dd-MM-yyyy HH:mm:ss", CultureInfo.CurrentCulture) + " UTC";

        var browserLocalTime = utcValue.AddMinutes(-browserTimezoneOffsetMinutes.Value);
        return browserLocalTime.ToString("dd-MM-yyyy HH:mm:ss", CultureInfo.CurrentCulture);
    }

    private bool ShouldShowMeasurement(string key) => !hiddenMeasurementKeys.Contains(key);

    private string GetFluidLevelKey(FluidType fluidType, byte instance)
        => $"FluidLevel_{fluidType}_{instance}";

    private string GetFluidLevelLabel(FluidType fluidType, byte instance)
    {
        string baseName = fluidType switch
        {
            FluidType.Fuel => "Brandstof",
            FluidType.FreshWater => "Drinkwater",
            FluidType.GrayWater => "Grijs water",
            FluidType.BlackWater => "Zwart water",
            FluidType.LiveWell => "Live well",
            FluidType.Oil => "Olie",
            _ => "Onbekende tank"
        };

        int displayNumber = 1;
        if (currentMeasurements != null)
            displayNumber = currentMeasurements.FluidLevels
                .Where(f => f.FluidType == fluidType && f.FluidInstance < instance)
                .Count() + 1;

        return $"{baseName} {displayNumber}";
    }

    private async Task HideMeasurement(string key)
    {
        hiddenMeasurementKeys.Add(key);
        await SaveHiddenKeysToLocalStorage();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ShowMeasurement(string key)
    {
        hiddenMeasurementKeys.Remove(key);
        await SaveHiddenKeysToLocalStorage();
        await InvokeAsync(StateHasChanged);
    }

    private async Task SaveHiddenKeysToLocalStorage()
    {
        try
        {
            var keysJson = JsonSerializer.Serialize(hiddenMeasurementKeys.ToList());
            await JS.InvokeVoidAsync("localStorage.setItem", LocalStorageKey, keysJson);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Kon hidden measurement keys niet opslaan in localStorage");
        }
    }

    private List<(string key, string label)> GetAvailableButHiddenMeasurements()
    {
        return GetHiddenDashboardItems();
    }

    /// <summary>
    /// Centrale methode: returneert alle beschikbare dashboard items (zichtbaar en verborgen).
    /// Dit is de bron van waarheid voor beschikbaarheid.
    /// </summary>
    private List<DashboardItem> GetAvailableDashboardItems()
    {
        var available = new List<DashboardItem>();
        if (currentMeasurements == null)
            return available;

        // Wind measurements
        if (currentMeasurements.Wind.AngleDegrees.HasValue)
            available.Add(new DashboardItem("WindAngle", "Windhoek"));

        if (currentMeasurements.Wind.SpeedMetersPerSecond.HasValue)
            available.Add(new DashboardItem("WindSpeed", "Windsnelheid"));

        // Heading
        if (currentMeasurements.Heading.HeadingDegrees.HasValue)
            available.Add(new DashboardItem("Heading", "Koers (Heading)"));

        // Position
        if (currentMeasurements.Position.Latitude.HasValue && currentMeasurements.Position.Longitude.HasValue)
            available.Add(new DashboardItem("Position", "Positie"));

        // Speed Through Water
        if (currentMeasurements.SpeedThroughWater.SpeedKnots.HasValue)
            available.Add(new DashboardItem("SpeedThroughWater", "Snelheid (door water)"));

        // Motion measurements (COG and SOG are separate)
        if (currentMeasurements.Motion.CourseOverGroundDegrees.HasValue)
            available.Add(new DashboardItem("CourseOverGround", "Koers over Grond (COG)"));

        if (currentMeasurements.Motion.SpeedOverGroundKnots.HasValue)
            available.Add(new DashboardItem("SpeedOverGround", "Snelheid over Grond (SOG)"));

        // Depth
        if (currentMeasurements.Depth.DepthMeters.HasValue)
            available.Add(new DashboardItem("Depth", "Diepte"));

        // Water Temperature
        if (currentMeasurements.WaterTemperature.TemperatureCelsius.HasValue)
            available.Add(new DashboardItem("WaterTemperature", "Watertemperatuur"));

        // Battery
        if (currentMeasurements.Battery.Voltage.HasValue)
            available.Add(new DashboardItem("Battery", "Spanning"));

        // Fluid Levels
        foreach (var fluid in currentMeasurements.FluidLevels)
        {
            if (fluid.HasData)
            {
                var key = GetFluidLevelKey(fluid.FluidType, fluid.FluidInstance);
                var label = GetFluidLevelLabel(fluid.FluidType, fluid.FluidInstance);
                available.Add(new DashboardItem(key, label));
            }
        }

        return available;
    }

    /// <summary>
    /// Returneert beschikbare items die NIET verborgen zijn.
    /// </summary>
    private List<DashboardItem> GetVisibleDashboardItems()
    {
        return GetAvailableDashboardItems()
            .Where(item => !hiddenMeasurementKeys.Contains(item.Key))
            .ToList();
    }

    /// <summary>
    /// Returneert beschikbare items die WEL verborgen zijn.
    /// </summary>
    private List<(string key, string label)> GetHiddenDashboardItems()
    {
        return GetAvailableDashboardItems()
            .Where(item => hiddenMeasurementKeys.Contains(item.Key))
            .Select(item => (item.Key, item.Label))
            .ToList();
    }

    private DateTime? GetLatestMeasurementTime()
    {
        if (currentMeasurements == null || !currentMeasurements.HasAnyData)
            return null;

        var timestamps = new List<DateTime?>();

        if (currentMeasurements.Wind.HasData && currentMeasurements.Wind.RecordedAtUtc.HasValue)
            timestamps.Add(currentMeasurements.Wind.RecordedAtUtc);

        if (currentMeasurements.Heading.HasData && currentMeasurements.Heading.RecordedAtUtc.HasValue)
            timestamps.Add(currentMeasurements.Heading.RecordedAtUtc);

        if (currentMeasurements.Position.HasData && currentMeasurements.Position.RecordedAtUtc.HasValue)
            timestamps.Add(currentMeasurements.Position.RecordedAtUtc);

        if (currentMeasurements.SpeedThroughWater.HasData && currentMeasurements.SpeedThroughWater.RecordedAtUtc.HasValue)
            timestamps.Add(currentMeasurements.SpeedThroughWater.RecordedAtUtc);

        if (currentMeasurements.Motion.HasData && currentMeasurements.Motion.RecordedAtUtc.HasValue)
            timestamps.Add(currentMeasurements.Motion.RecordedAtUtc);

        if (currentMeasurements.Depth.HasData && currentMeasurements.Depth.RecordedAtUtc.HasValue)
            timestamps.Add(currentMeasurements.Depth.RecordedAtUtc);

        if (currentMeasurements.WaterTemperature.HasData && currentMeasurements.WaterTemperature.RecordedAtUtc.HasValue)
            timestamps.Add(currentMeasurements.WaterTemperature.RecordedAtUtc);

        if (currentMeasurements.Battery.HasData && currentMeasurements.Battery.RecordedAtUtc.HasValue)
            timestamps.Add(currentMeasurements.Battery.RecordedAtUtc);

        // Include fluid level timestamps
        foreach (var fluid in currentMeasurements.FluidLevels)
        {
            if (fluid.HasData && fluid.RecordedAtUtc.HasValue)
                timestamps.Add(fluid.RecordedAtUtc);
        }

        return timestamps.Count > 0 ? timestamps.Max() : null;
    }

    private async Task OnIngestProcessingToggled(ChangeEventArgs e)
    {
        if (settings == null) return;

        try
        {
            isSubmitting = true;
            errorMessage = null;
            successMessage = null;
            warningMessage = null;

            settings.IngestProcessingEnabled = (bool)e.Value!;
            var response = await OperationalSettingsWithReloadService.SaveAndReloadAsync(settings);

            if (response.SettingsSaved)
            {
                ingestProcessingEnabled = settings.IngestProcessingEnabled;
                var action = settings.IngestProcessingEnabled ? "ingeschakeld" : "uitgeschakeld";
                successMessage = $"NMEA-verwerking is {action}.";

                if (response.IngestReloadStatus == "unreachable" || response.IngestReloadStatus == "failed")
                    warningMessage = response.IngestReloadMessage ?? "NMEA-verwerking kon niet automatisch worden bijgewerkt.";

                Logger.LogInformation("Ingest processing toggled to {Value}. Reload status: {ReloadStatus}",
                    settings.IngestProcessingEnabled, response.IngestReloadStatus);
            }
            else
            {
                errorMessage = "Kon NMEA-verwerking niet wijzigen.";
                ingestProcessingEnabled = !ingestProcessingEnabled;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fout bij wijzigen NMEA-verwerking");
            errorMessage = "Kon NMEA-verwerking niet wijzigen.";
            ingestProcessingEnabled = !ingestProcessingEnabled;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        if (pollingTimer != null)
            await pollingTimer.DisposeAsync();

        cancellationTokenSource?.Cancel();
        cancellationTokenSource?.Dispose();

        if (browserTimeModule != null)
            await browserTimeModule.DisposeAsync();
    }
}
