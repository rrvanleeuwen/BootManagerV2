@page "/storage/locations/{LocationId:guid}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Owner,Crew")]
@using BootManager.Application.Storage.DTOs
@using BootManager.Application.Storage.Services
@using BootManager.Application.Inventory.Contracts
@using BootManager.Application.Inventory.DTOs
@using BootManager.Web.Components.Inventory
@using Microsoft.AspNetCore.Components.Authorization
@inject IStorageService StorageService
@inject IStockService StockService
@inject IJSRuntime JsRuntime
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="mb-4">
    <button class="btn btn-sm btn-outline-secondary mb-3" @onclick="GoBackAsync">← Terug</button>
</div>

@if (_loading)
{
    <p>Laden…</p>
}
else if (_detail == null)
{
    <div class="alert alert-warning">Opslaglocatie niet gevonden.</div>
}
else
{
    <div class="card">
        <div class="card-header">
            <h4 class="mb-0">@_detail.LocationName</h4>
        </div>
        <div class="card-body">
            <div class="mb-3">
                <span class="text-muted small">Opslaggebied</span>
                <div class="h5 mb-0">@_detail.AreaName</div>
            </div>
            <div class="mb-3">
                <span class="text-muted small">Locatienaam</span>
                <div class="h5 mb-0">@_detail.LocationName</div>
            </div>
            @if (!string.IsNullOrEmpty(_detail.Description))
            {
                <div class="mb-3">
                    <span class="text-muted small">Beschrijving</span>
                    <div>@_detail.Description</div>
                </div>
            }
            @if (_isOwner)
            {
                <div class="mb-3">
                    <span class="text-muted small">BootManager QR-code</span>
                    @if (string.IsNullOrEmpty(_detail.QrValue))
                    {
                        <div>
                            <button class="btn btn-sm btn-primary" @onclick="GenerateQrToken">QR-token genereren</button>
                        </div>
                    }
                    else
                    {
                        <div class="font-monospace small mb-2">@_detail.QrValue</div>
                        <div>
                            <a href="/storage/locations/@LocationId/tag" class="btn btn-sm btn-success">🏷 Tag afdrukken</a>
                        </div>
                    }
                </div>
            }
            <div class="mb-3">
                <span class="text-muted small">Voorraad</span>
                <div class="mb-3">
                    <button class="btn btn-sm btn-success" @onclick="OpenAddStockDialog">+ Voorraad toevoegen</button>
                </div>
                @if (_detail.Stocks.Count > 0)
                {
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Productnaam</th>
                                    <th class="text-end">Hoeveelheid</th>
                                    <th class="text-end">Acties</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var stock in _detail.Stocks)
                                {
                                    <tr>
                                        <td>@stock.ProductName</td>
                                        <td class="text-end">@stock.Quantity @stock.DefaultUnitName</td>
                                        <td class="text-end">
                                            <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenMutationModal(stock)" title="Bijzonderheid">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => OpenDeleteConfirmation(stock.Id)" title="Verwijderen">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted">Geen voorraad op deze locatie.</p>
                }
            </div>
        </div>
    </div>

    @if (_showAddStockDialog)
    {
        <AddStockDialog LocationId="LocationId" OnClose="CloseAddStockDialog" OnStockAdded="OnStockAdded" />
    }

    @if (_showMutationModal && _selectedStock != null)
    {
        <StockMutationModal Stock="_selectedStock" OnClose="CloseMutationModal" OnMutationSaved="OnMutationSaved" />
    }

    @if (_showDeleteConfirmation)
    {
        <div class="modal d-block" style="display: block; background-color: rgba(0, 0, 0, 0.5);">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Voorraadregel verwijderen</h5>
                    </div>
                    <div class="modal-body">
                        Weet u zeker dat u deze voorraadregel wilt verwijderen?
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseDeleteConfirmation">Annuleren</button>
                        <button type="button" class="btn btn-danger" @onclick="ConfirmDelete">Verwijderen</button>
                    </div>
                </div>
            </div>
        </div>
    }
}

@code {
    [Parameter]
    public Guid LocationId { get; set; }

    private StorageLocationDetailDto? _detail;
    private bool _loading = true;
    private bool _isOwner = false;
    private bool _showAddStockDialog = false;
    private bool _showMutationModal = false;
    private StockDto? _selectedStock;
    private bool _showDeleteConfirmation = false;
    private Guid _stockToDeleteId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _isOwner = authState.User.IsInRole("Owner");
        await LoadDetail();
    }

    private async Task LoadDetail()
    {
        _loading = true;
        try
        {
            var result = await StorageService.GetLocationDetailAsync(LocationId);
            _detail = result.Success ? result.Data : null;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task GenerateQrToken()
    {
        var result = await StorageService.GenerateOrGetQrTokenAsync(LocationId);
        if (result.Success && _detail != null)
        {
            _detail.QrValue = result.Data;
            StateHasChanged();
        }
    }

    private void OpenAddStockDialog()
    {
        _showAddStockDialog = true;
    }

    private void CloseAddStockDialog()
    {
        _showAddStockDialog = false;
    }

    private async Task OnStockAdded()
    {
        CloseAddStockDialog();
        await LoadDetail();
    }

    private void OpenMutationModal(StockDto stock)
    {
        _selectedStock = stock;
        _showMutationModal = true;
    }

    private void CloseMutationModal()
    {
        _showMutationModal = false;
        _selectedStock = null;
    }

    private async Task OnMutationSaved()
    {
        CloseMutationModal();
        await LoadDetail();
    }

    private void OpenDeleteConfirmation(Guid stockId)
    {
        _stockToDeleteId = stockId;
        _showDeleteConfirmation = true;
    }

    private void CloseDeleteConfirmation()
    {
        _showDeleteConfirmation = false;
    }

    private async Task ConfirmDelete()
    {
        CloseDeleteConfirmation();
        var result = await StockService.DeleteStockAsync(_stockToDeleteId);
        if (result.Success)
        {
            await LoadDetail();
        }
    }

    private async Task GoBackAsync()
    {
        await JsRuntime.InvokeVoidAsync("history.back");
    }
}
