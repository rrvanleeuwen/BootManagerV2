@page "/storage/locations/{LocationId:guid}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Owner,Crew")]
@using BootManager.Application.Storage.DTOs
@using BootManager.Application.Storage.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject IStorageService StorageService
@inject IJSRuntime JsRuntime
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="mb-4">
    <button class="btn btn-sm btn-outline-secondary mb-3" @onclick="GoBackAsync">← Terug</button>
</div>

@if (_loading)
{
    <p>Laden…</p>
}
else if (_detail == null)
{
    <div class="alert alert-warning">Opslaglocatie niet gevonden.</div>
}
else
{
    <div class="card">
        <div class="card-header">
            <h4 class="mb-0">@_detail.LocationName</h4>
        </div>
        <div class="card-body">
            <div class="mb-3">
                <span class="text-muted small">Opslaggebied</span>
                <div class="h5 mb-0">@_detail.AreaName</div>
            </div>
            <div class="mb-3">
                <span class="text-muted small">Locatienaam</span>
                <div class="h5 mb-0">@_detail.LocationName</div>
            </div>
            @if (!string.IsNullOrEmpty(_detail.Description))
            {
                <div class="mb-3">
                    <span class="text-muted small">Beschrijving</span>
                    <div>@_detail.Description</div>
                </div>
            }
            @if (_isOwner)
            {
                <div class="mb-3">
                    <span class="text-muted small">BootManager QR-code</span>
                    @if (string.IsNullOrEmpty(_detail.QrValue))
                    {
                        <div>
                            <button class="btn btn-sm btn-primary" @onclick="GenerateQrToken">QR-token genereren</button>
                        </div>
                    }
                    else
                    {
                        <div class="font-monospace small mb-2">@_detail.QrValue</div>
                        <div>
                            <a href="/storage/locations/@LocationId/tag" class="btn btn-sm btn-success">🏷 Tag afdrukken</a>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid LocationId { get; set; }

    private StorageLocationDetailDto? _detail;
    private bool _loading = true;
    private bool _isOwner = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _isOwner = authState.User.IsInRole("Owner");
        await LoadDetail();
    }

    private async Task LoadDetail()
    {
        _loading = true;
        try
        {
            var result = await StorageService.GetLocationDetailAsync(LocationId);
            _detail = result.Success ? result.Data : null;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task GenerateQrToken()
    {
        var result = await StorageService.GenerateOrGetQrTokenAsync(LocationId);
        if (result.Success && _detail != null)
        {
            _detail.QrValue = result.Data;
            StateHasChanged();
        }
    }

    private async Task GoBackAsync()
    {
        await JsRuntime.InvokeVoidAsync("history.back");
    }
}
