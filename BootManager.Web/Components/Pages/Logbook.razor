    /// <summary>
    /// Retourneert logboekregels in omgekeerde volgorde (nieuw naar oud) voor display.
    /// De interne _entries lijst blijft chronologisch oplopend voor berekeningen.
    /// </summary>
    private IEnumerable<LogbookEntryDto> GetDisplayEntries()
    {
        return _entries.AsEnumerable().Reverse();
    }

    /// <summary>
    /// Retourneert gefilterde en gesorteerde logboekregels op basis van actieve filters.
    /// </summary>
    private IEnumerable<LogbookEntryDto> GetFilteredAndSortedEntries()
    {
        var filtered = _entries.AsEnumerable();

        // Statusfilter
        if (_statusFilter == "draft")
            filtered = filtered.Where(e => e.Status == LogbookEntryStatus.Draft);
        else if (_statusFilter == "confirmed")
            filtered = filtered.Where(e => e.Status == LogbookEntryStatus.Confirmed);

        // Bijlagenfilter
        if (_attachmentFilter == "with")
            filtered = filtered.Where(e => e.AttachmentCount > 0);
        else if (_attachmentFilter == "without")
            filtered = filtered.Where(e => e.AttachmentCount == 0);

        // Zoekveld: zoekt in Remarks, WindDescription en GpsStatus
        if (!string.IsNullOrWhiteSpace(_searchFilter))
        {
            var searchLower = _searchFilter.ToLowerInvariant();
            filtered = filtered.Where(e =>
                (e.Remarks?.ToLowerInvariant().Contains(searchLower) ?? false) ||
                (e.WindDescription?.ToLowerInvariant().Contains(searchLower) ?? false) ||
                (e.GpsStatus?.ToLowerInvariant().Contains(searchLower) ?? false)
            );
        }

        // Datumfilter (optioneel, alleen indien ingesteld)
        if (_dateFilterStart.HasValue)
        {
            var startUtc = BoordtijdHelper.NaarUtc(_dateFilterStart.Value);
            filtered = filtered.Where(e => e.EntryTimeUtc >= startUtc);
        }
        if (_dateFilterEnd.HasValue)
        {
            var endUtc = BoordtijdHelper.NaarUtc(_dateFilterEnd.Value.AddDays(1).AddTicks(-1));
            filtered = filtered.Where(e => e.EntryTimeUtc <= endUtc);
        }

        // Sorteer nieuw → oud (omgekeerde chronologische volgorde)
        return filtered.OrderByDescending(e => e.EntryTimeUtc);
    }

    private string GetEmptyEntriesMessage()
    {
        if (!_entries.Any())
        {
            return "Nog geen logboekregels. Klik op \"+ Nieuwe regel\" om te beginnen.";
        }

        return "Geen logboekregels gevonden met de actieve filters.";
    }

    /// <summary>
    /// Reset alle filters naar standaardwaarden.
    /// </summary>
    private void ResetFilters()
    {
        _statusFilter = "all";
        _attachmentFilter = "all";
        _searchFilter = string.Empty;
        _dateFilterStart = null;
        _dateFilterEnd = null;
        ResetCardPaging();
    }

    /// <summary>
    /// Reset paging voor card-view.
    /// </summary>
    private void ResetCardPaging()
    {
        _cardPageIndex = 0;
        _displayedEntries.Clear();
        LoadMoreCards();
        QueueInfiniteScrollRefresh();
    }

    /// <summary>
    /// Laadt volgende batch van gefilterde entries voor card-view.
    /// </summary>
    private void LoadMoreCards()
    {
        if (_isLoadingMore) return;

        var allFiltered = GetFilteredAndSortedEntries().ToList();
        var totalCount = allFiltered.Count;

        int skipCount = _cardPageIndex * _cardPageSize;
        if (skipCount >= totalCount)
        {
            _hasMoreEntries = false;
            return;
        }

        var nextBatch = allFiltered.Skip(skipCount).Take(_cardPageSize).ToList();
        _displayedEntries.AddRange(nextBatch);

        _cardPageIndex++;
        _hasMoreEntries = (_cardPageIndex * _cardPageSize) < totalCount;
        QueueInfiniteScrollRefresh();
    }

    private void QueueInfiniteScrollRefresh()
    {
        _refreshInfiniteScroll = true;
    }

