    private void CloseUploadModal()
    {
        _showUploadModal = false;
        _modalEntryId = null;
        _modalSelectedFile = null;
        _modalAttachmentDescription = null;
        _modalUploadMessage = null;
        _modalUploadSuccess = false;
        StateHasChanged();
    }
    private void OnModalFileSelected(InputFileChangeEventArgs e)
    {
        _modalSelectedFile = e.File;
        _modalUploadMessage = null;
    }

    private async Task ModalUploadAttachment()
    {
        if (_modalSelectedFile == null || !_modalEntryId.HasValue)
        {
            _modalUploadMessage = "Selecteer alstublieft een bestand.";
            StateHasChanged();
            return;
        }

        _modalUploading = true;
        _modalUploadMessage = null;
        _modalUploadSuccess = false;
        StateHasChanged();

        try
        {
            using var stream = _modalSelectedFile.OpenReadStream(maxAllowedSize: 10_485_760);

            var result = await AttachmentService.UploadAsync(
                _modalEntryId.Value,
                stream,
                _modalSelectedFile.Name,
                _modalSelectedFile.ContentType,
                _modalAttachmentDescription);

            if (result.Status == AttachmentUploadStatus.Success)
            {
                _modalUploadMessage = "Bijlage succesvol geüpload.";
                _modalUploadSuccess = true;
                StateHasChanged();

                // Herlaad entries om bijlagenteller bij te werken
                if (_selectedTrip != null)
                {
                    _entries = (await LogbookService.GetEntriesAsync(_selectedTrip.Id)).ToList();
                    ResetCardPaging();
                    StateHasChanged();
                }

                // Sluit modal na korte vertraging
                await Task.Delay(800);
                CloseUploadModal();
            }
            else
            {
                _modalUploadMessage = result.Message ?? $"Upload mislukt (status: {result.Status})";
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            _modalUploadMessage = $"Fout: {ex.Message}";
            StateHasChanged();
        }
        finally
        {
            _modalUploading = false;
            StateHasChanged();
        }
    }

