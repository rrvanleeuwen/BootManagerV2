@code {
    private bool _loading = true;
    private string? _foutmelding;
    private bool _tripSaved;
    private OperationalSettingsDto? _operationalSettings;
    private VesselProfileDto? _currentVesselProfile;

    private List<LogbookTripDto> _trips = new();
    private LogbookTripDto? _selectedTrip;
    private TripFormModel? _tripForm;

    private List<LogbookEntryDto> _entries = new();
    private int? _editingEntryId;
    private EntryFormModel? _entryForm;
    private EntryFormModel? _newEntryForm;

    private MissedLogMomentsDto? _missedLogMoments;
    private bool _creatingDraftEntries;
    private bool _checkingMissedMoments;

    // Variabelen voor verwijderingsbevestiging
    private int? _entryIdToDelete;
    private string? _entryTimeToDelete;

    // Variabelen voor reisvoltooiing
    private bool _showCompleteModal = false;
    private DateTime? _completeModalArrivalTimeLocal;
    private bool _completingTrip = false;

    // Variabelen voor upload-modal
    private bool _showUploadModal = false;
    private int? _modalEntryId;
    private IBrowserFile? _modalSelectedFile;
    private string? _modalAttachmentDescription;
    private bool _modalUploading = false;
    private string? _modalUploadMessage;
    private bool _modalUploadSuccess = false;

    // Variabelen voor bevestiging nieuwe reis (ingest-verwerking uit)
    private bool _showNewTripWarningModal = false;

    // Filter-state
    private string _statusFilter = "all"; // "all", "draft", "confirmed"
    private string _attachmentFilter = "all"; // "all", "with", "without"
    private string _searchFilter = string.Empty;
    private DateTime? _dateFilterStart;
    private DateTime? _dateFilterEnd;

    // Paging state voor mobiel/tablet (infinite scroll)
    private List<LogbookEntryDto> _displayedEntries = new(); // Zichtbare entries in card-view
    private int _cardPageSize = 8; // Items per page in card-view
    private bool _hasMoreEntries = false; // Zijn er meer entries beschikbaar?
    private bool _isLoadingMore = false; // Laadt meer data?
    private int _cardPageIndex = 0; // Huidige pagina-index voor card-view

    // JavaScript interop
    private IJSObjectReference? _infiniteScrollModule;
    private bool _refreshInfiniteScroll;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Load operational settings to check if ingest processing is enabled
            _operationalSettings = await OperationalSettingsService.GetAsync();
            _currentVesselProfile = await VesselProfileService.GetOrCreateVesselProfileAsync();

            _trips = (await LogbookService.GetAllTripsAsync()).ToList();
            if (_trips.Count > 0)
            {
                await SelecteerReis(_trips[0]);
            }
        }
        catch (Exception ex)
        {
            _foutmelding = $"Fout bij laden: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _infiniteScrollModule = await JS.InvokeAsync<IJSObjectReference>(
                    "import", "./Components/Pages/logbook-infinite-scroll.js");
                await _infiniteScrollModule.InvokeVoidAsync("initInfiniteScroll");
            }
            catch (Exception ex)
            {
                // Infinite scroll is optional, don't fail if it doesn't load
                System.Diagnostics.Debug.WriteLine($"Infinite scroll initialization failed: {ex.Message}");
            }
        }
        else if (_refreshInfiniteScroll && _infiniteScrollModule is not null)
        {
            try
            {
                _refreshInfiniteScroll = false;
                await _infiniteScrollModule.InvokeVoidAsync("refreshInfiniteScroll");
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"Infinite scroll refresh failed: {ex.Message}");
            }
        }
    }

    private async Task OnTripSelected(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
        {
            var trip = _trips.FirstOrDefault(t => t.Id == id);
            if (trip != null) await SelecteerReis(trip);
        }
    }

    private async Task SelecteerReis(LogbookTripDto trip)
    {
        _selectedTrip = trip;
        _tripForm = new TripFormModel(trip);
        _entries = (await LogbookService.GetEntriesAsync(trip.Id)).ToList();
        _editingEntryId = null;
        _entryForm = null;
        _newEntryForm = null;
        _tripSaved = false;
        ResetCardPaging(); // Initialiseer card-paging voor deze reis
        await BerekenVolgendeLogmoment();
    }

    private async Task NieuweReis()
    {
        // Check of ingest-verwerking uit staat
        if (_operationalSettings != null && !_operationalSettings.IngestProcessingEnabled)
        {
            _showNewTripWarningModal = true;
        }
        else
        {
            // Ingest is aan, ga direct door
            DoCreateNewTrip();
        }
    }

    /// <summary>
    /// Werkelijk proces voor nieuwe reis aanmaken.
    /// </summary>
    private void DoCreateNewTrip()
    {
        _selectedTrip = null;
        _entries = new();
        _tripForm = new TripFormModel
        {
            VesselName = _currentVesselProfile?.VesselName,
            DepartureDateTimeLocal = BoordtijdHelper.NaarLokaal(DateTime.UtcNow)
        };
        _tripSaved = false;
        _showNewTripWarningModal = false;
    }

    /// <summary>
    /// Handler voor bevestiging van nieuwe reis ondanks ingest verwerking uit.
    /// </summary>
    private void ConfirmNewTripDespiteIngestDisabled()
    {
        DoCreateNewTrip();
    }

    /// <summary>
    /// Handler voor annuleren van nieuwe reis.
    /// </summary>
    private void CancelNewTrip()
    {
        _showNewTripWarningModal = false;
    }

    private async Task OpslaanReis()
    {
        if (_tripForm == null) return;
        try
        {
            var dto = _tripForm.ToCreateDto();
            if (_selectedTrip == null)
            {
                var created = await LogbookService.CreateTripAsync(dto);
                _currentVesselProfile = await VesselProfileService.GetOrCreateVesselProfileAsync();
                _trips.Insert(0, created);
                _selectedTrip = created;
                _tripForm = new TripFormModel(created);
            }
            else
            {
                await LogbookService.UpdateTripAsync(_selectedTrip.Id, dto);
                _currentVesselProfile = await VesselProfileService.GetOrCreateVesselProfileAsync();
                var updated = await LogbookService.GetTripAsync(_selectedTrip.Id);
                if (updated != null)
                {
                    var idx = _trips.FindIndex(t => t.Id == updated.Id);
                    if (idx >= 0) _trips[idx] = updated;
                    _selectedTrip = updated;
                    _tripForm = new TripFormModel(updated);
                }
            }
            _tripSaved = true;
            _foutmelding = null;
        }
        catch (Exception ex)
        {
            _foutmelding = $"Opslaan mislukt: {ex.Message}";
        }
    }

    private void NieuweRegel()
    {
        _newEntryForm = new EntryFormModel();
        _editingEntryId = null;
        _entryForm = null;
    }

    private async Task VulSuggestiesNieuweRegel()
    {
        if (_newEntryForm == null || _selectedTrip == null) return;
        try
        {
            var suggesties = await SuggestionService.GetSuggestionsAsync(_selectedTrip.Id, BoordtijdHelper.NaarUtc(_newEntryForm.EntryTimeLocal));
            if (!_newEntryForm.Course.HasValue && suggesties.Course.HasValue)
                _newEntryForm.Course = suggesties.Course;
            if (string.IsNullOrWhiteSpace(_newEntryForm.WindDescription) && suggesties.WindDescription != null)
                _newEntryForm.WindDescription = suggesties.WindDescription;
            if (string.IsNullOrWhiteSpace(_newEntryForm.GpsStatus) && suggesties.GpsStatus != null)
                _newEntryForm.GpsStatus = suggesties.GpsStatus;
            if (!_newEntryForm.Latitude.HasValue && suggesties.Latitude.HasValue)
                _newEntryForm.Latitude = suggesties.Latitude;
            if (!_newEntryForm.Longitude.HasValue && suggesties.Longitude.HasValue)
                _newEntryForm.Longitude = suggesties.Longitude;
            if (!_newEntryForm.AverageSogKnots.HasValue && suggesties.AverageSogKnots.HasValue)
                _newEntryForm.AverageSogKnots = suggesties.AverageSogKnots;
        }
        catch (Exception ex)
        {
            _foutmelding = $"Suggesties ophalen mislukt: {ex.Message}";
        }
    }

    private async Task OpslaanNieuweRegel()
    {
        if (_newEntryForm == null || _selectedTrip == null) return;
        try
        {
            var entry = await LogbookService.CreateEntryAsync(_selectedTrip.Id, _newEntryForm.ToDto());
            _entries.Add(entry);
            _entries = _entries.OrderBy(e => e.EntryTimeUtc).ToList();
            _newEntryForm = null;
            _foutmelding = null;
            ResetCardPaging(); // Reset paging na nieuwe regel
            await BerekenVolgendeLogmoment();
        }
        catch (Exception ex)
        {
            _foutmelding = $"Opslaan mislukt: {ex.Message}";
        }
    }

    private void BewerkenRegel(LogbookEntryDto entry)
    {
        _editingEntryId = entry.Id;
        _entryForm = new EntryFormModel(entry);
        _newEntryForm = null;
    }

    private async Task OpslaanRegel(int entryId)
    {
        if (_entryForm == null) return;
        try
        {
            await LogbookService.UpdateEntryAsync(entryId, _entryForm.ToDto());
            var updated = _entries.FirstOrDefault(e => e.Id == entryId);
            if (updated != null)
            {
                var idx = _entries.IndexOf(updated);
                var dto = _entryForm.ToDto();
                _entries[idx] = new LogbookEntryDto
                {
                    Id = entryId,
                    LogbookTripId = updated.LogbookTripId,
                    EntryTimeUtc = dto.EntryTimeUtc,
                    BaroPressure = dto.BaroPressure,
                    LogValue = dto.LogValue,
                    Course = dto.Course,
                    Remarks = dto.Remarks,
                    WindDescription = dto.WindDescription,
                    GpsStatus = dto.GpsStatus,
                    Latitude = dto.Latitude,
                    Longitude = dto.Longitude,
                    AverageSogKnots = dto.AverageSogKnots,
                    Status = updated.Status,
                    AttachmentCount = updated.AttachmentCount,
                    UpdatedAtUtc = DateTime.UtcNow
                };
                _entries = _entries.OrderBy(e => e.EntryTimeUtc).ToList();
            }
            _editingEntryId = null;
            _entryForm = null;
            _foutmelding = null;
            ResetCardPaging();
            // Herbereken het volgende verwachte logmoment, omdat de gebruiker
            // mogelijk de tijd van een regel heeft gewijzigd.
            await BerekenVolgendeLogmoment();
        }
        catch (Exception ex)
        {
            _foutmelding = $"Opslaan mislukt: {ex.Message}";
        }
    }

