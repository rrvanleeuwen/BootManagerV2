    private static string FormatTripDuration(decimal? durationHours)
    {
        if (!durationHours.HasValue || durationHours.Value < 0)
        {
            return "—";
        }

        var duration = TimeSpan.FromHours((double)durationHours.Value);
        return $"{(int)duration.TotalHours}:{duration.Minutes:00} uur";
    }

    private static string FormatNauticalMiles(decimal? nauticalMiles)
        => nauticalMiles.HasValue ? $"{nauticalMiles.Value:0.0} nm" : "—";

