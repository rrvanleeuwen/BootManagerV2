    /// <summary>
    /// Opent het modal voor reisvoltooiing
    /// </summary>
    private void OpenCompleteModal()
    {
        if (_selectedTrip == null) return;
        _showCompleteModal = true;
        // Zet aankomstmoment lokaal als dat nog niet bestaat
        _completeModalArrivalTimeLocal = _selectedTrip.ArrivalUtc.HasValue 
            ? BoordtijdHelper.NaarLokaal(_selectedTrip.ArrivalUtc.Value) 
            : BoordtijdHelper.NaarLokaal(DateTime.UtcNow);
    }

    /// <summary>
    /// Sluit het modal voor reisvoltooiing
    /// </summary>
    private void CloseCompleteModal()
    {
        _showCompleteModal = false;
        _completeModalArrivalTimeLocal = null;
        _completingTrip = false;
    }

    /// <summary>
    /// Bevestigt de reisvoltooiing
    /// </summary>
    private async Task ConfirmCompleteTrip()
    {
        if (_selectedTrip == null) return;
        try
        {
            _completingTrip = true;

            // Bepaal aankomstmoment: verplicht (moet ingevuld zijn in modal)
            DateTime arrivalUtc;
            if (_completeModalArrivalTimeLocal.HasValue)
            {
                arrivalUtc = BoordtijdHelper.NaarUtc(_completeModalArrivalTimeLocal.Value);
            }
            else
            {
                _foutmelding = "Aankomstmoment is verplicht voor het afronden van een reis.";
                _completingTrip = false;
                return;
            }

            // Roep service aan (arrivalUtc is nu verplicht)
            await LogbookService.CompleteTripAsync(_selectedTrip.Id, arrivalUtc);

            // Herlaad de gekozen reis
            var updated = await LogbookService.GetTripAsync(_selectedTrip.Id);
            if (updated != null)
            {
                _selectedTrip = updated;
                _tripForm = new TripFormModel(updated);
                var idx = _trips.FindIndex(t => t.Id == updated.Id);
                if (idx >= 0) _trips[idx] = updated;
            }
            _currentVesselProfile = await VesselProfileService.GetOrCreateVesselProfileAsync();

            _foutmelding = null;
            CloseCompleteModal();
        }
        catch (Exception ex)
        {
            _foutmelding = $"Reis afronden mislukt: {ex.Message}";
        }
        finally
        {
            _completingTrip = false;
        }
    }

