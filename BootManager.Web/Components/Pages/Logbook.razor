@page "/logbook"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Owner")]
@using BootManager.Application.Logbook.DTOs
@using BootManager.Application.Logbook.Services
@using BootManager.Core.Enums
@using BootManager.Web.Helpers
@inject ILogbookService LogbookService
@inject ILogbookMeasurementSuggestionService SuggestionService

<h2 class="mb-3">Scheepsdagboek</h2>

@if (_loading)
{
    <p>Laden…</p>
}
else
{
    <!-- Reisselectie en reisformulier -->
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Reis</span>
            <button class="btn btn-sm btn-outline-primary" @onclick="NieuweReis">+ Nieuwe reis</button>
        </div>
        <div class="card-body">
            @if (_trips.Count > 0)
            {
                <div class="mb-2">
                    <label class="form-label">Selecteer reis</label>
                    <select class="form-select form-select-sm" @onchange="OnTripSelected">
                        <option value="">— kies een reis —</option>
                        @foreach (var t in _trips)
                        {
                            <option value="@t.Id" selected="@(_selectedTrip?.Id == t.Id)">@t.Name (@t.DepartureUtc.ToString("dd-MM-yyyy"))</option>
                        }
                    </select>
                </div>
            }

            @if (_tripForm != null)
            {
                <EditForm Model="_tripForm" OnValidSubmit="OpslaanReis">
                    <DataAnnotationsValidator />
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label">Reisnaam *</label>
                            <InputText class="form-control form-control-sm" @bind-Value="_tripForm.Name" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Vertrek (UTC)</label>
                            <InputDate class="form-control form-control-sm" @bind-Value="_tripForm.DepartureUtc" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Aankomst (UTC)</label>
                            <InputDate class="form-control form-control-sm" @bind-Value="_tripForm.ArrivalUtcInput" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Vertrekhaven</label>
                            <InputText class="form-control form-control-sm" @bind-Value="_tripForm.DeparturePort" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Bestemming</label>
                            <InputText class="form-control form-control-sm" @bind-Value="_tripForm.DestinationPort" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Vaartuig</label>
                            <InputText class="form-control form-control-sm" @bind-Value="_tripForm.VesselName" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Bemanning</label>
                            <InputText class="form-control form-control-sm" @bind-Value="_tripForm.Crew" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Loginterval (min)</label>
                            <InputNumber class="form-control form-control-sm" @bind-Value="_tripForm.LogIntervalMinutes" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Notities</label>
                            <InputTextArea class="form-control form-control-sm" rows="2" @bind-Value="_tripForm.Notes" />
                        </div>
                    </div>

                    <!-- Reis-samenvatting -->
                    <div class="mt-3 mb-1 fw-semibold small text-secondary">Reis-samenvatting</div>
                    <div class="row g-2">
                        <div class="col-md-2">
                            <label class="form-label">Logstand start (nm)</label>
                            <InputNumber class="form-control form-control-sm" @bind-Value="_tripForm.LogstandStart" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Gelogde mijlen (nm)</label>
                            <InputNumber class="form-control form-control-sm" @bind-Value="_tripForm.LoggedMiles" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Motor uren start</label>
                            <InputNumber class="form-control form-control-sm" @bind-Value="_tripForm.EngineHoursStart" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Motor uren eind</label>
                            <InputNumber class="form-control form-control-sm" @bind-Value="_tripForm.EngineHoursEnd" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Brandstof</label>
                            <InputText class="form-control form-control-sm" @bind-Value="_tripForm.Fuel" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Totaal vaaruren</label>
                            <InputNumber class="form-control form-control-sm" @bind-Value="_tripForm.TotalSailingHours" />
                        </div>
                    </div>
                    <div class="mt-2">
                        <button type="submit" class="btn btn-sm btn-primary">Opslaan</button>
                        @if (_tripSaved)
                        {
                            <span class="text-success ms-2">✓ Opgeslagen</span>
                        }
                    </div>
                </EditForm>
            }
        </div>
    </div>

    <!-- Logboektabel -->
    @if (_selectedTrip != null)
    {
        <!-- Banner voor vermiste logmomenten -->
        @if (_missedLogMoments != null && _missedLogMoments.TotalCount > 0)
        {
            <div class="alert alert-warning alert-dismissible fade show mb-3" role="alert">
                <strong>⚠ Gemiste logmomenten:</strong>
                <span class="ms-1">@_missedLogMoments.TotalCount</span>

                @if (_missedLogMoments.MissedMoments.Count > 0)
                {
                    <span class="ms-1">(@string.Join(", ", _missedLogMoments.MissedMoments.Take(5).Select(m => BoordtijdHelper.NaarLokaal(m.EntryTimeUtc).ToString("HH:mm"))))</span>
                    @if (_missedLogMoments.MissedMoments.Count > 5)
                    {
                        <span class="ms-1">+ @(_missedLogMoments.MissedMoments.Count - 5) meer</span>
                    }
                }

                <button type="button" class="btn btn-sm btn-warning ms-2" @onclick="MaakMultipleDraftRegels" disabled="@_creatingDraftEntries">
                    @if (_creatingDraftEntries)
                    {
                        <span>Aanmaken…</span>
                    }
                    else
                    {
                        <span>Conceptregels aanmaken</span>
                    }
                </button>
                <button type="button" class="btn-close" @onclick="() => _missedLogMoments = null"></button>
            </div>
        }

        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Logboekregels — @_selectedTrip.Name</span>
                <div class="d-flex gap-2">
                    <a class="btn btn-sm btn-outline-secondary" href="/logbook/trips/@_selectedTrip.Id/print" target="_blank">🖨 Afdrukweergave</a>
                    <button class="btn btn-sm btn-outline-success" @onclick="NieuweRegel">+ Nieuwe regel</button>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm table-bordered table-hover mb-0 logbook-table">
                        <thead class="table-dark">
                            <tr>
                                <th>Tijd (lokaal)</th>
                                <th>Status</th>
                                <th>Baro</th>
                                <th>Log</th>
                                <th>Koers</th>
                                <th>Positie / zeilvoering / opmerkingen</th>
                                <th>Bijlagen</th>
                                <th>Wind</th>
                                <th>GPS</th>
                                <th>Lat.</th>
                                <th>Long.</th>
                                <th>Gem. SOG</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in GetDisplayEntries())
                            {
                                @if (_editingEntryId == entry.Id && _entryForm != null)
                                {
                                    <!-- Bewerkingsrij -->
                                    <tr class="table-warning">
                                        <td><InputDate Type="InputDateType.DateTimeLocal" class="form-control form-control-sm" @bind-Value="_entryForm.EntryTimeLocal" /></td>
                                        <td><span class="text-muted small">—</span></td>
                                        <td><InputNumber class="form-control form-control-sm" @bind-Value="_entryForm.BaroPressure" /></td>
                                        <td><InputNumber class="form-control form-control-sm" @bind-Value="_entryForm.LogValue" /></td>
                                        <td><InputNumber class="form-control form-control-sm" @bind-Value="_entryForm.Course" /></td>
                                        <td><InputText class="form-control form-control-sm" @bind-Value="_entryForm.Remarks" /></td>
                                        <td><span class="text-muted small">—</span></td>
                                        <td><InputText class="form-control form-control-sm" @bind-Value="_entryForm.WindDescription" /></td>
                                        <td><InputText class="form-control form-control-sm" @bind-Value="_entryForm.GpsStatus" /></td>
                                        <td><InputNumber class="form-control form-control-sm" @bind-Value="_entryForm.Latitude" /></td>
                                        <td><InputNumber class="form-control form-control-sm" @bind-Value="_entryForm.Longitude" /></td>
                                        <td><InputNumber class="form-control form-control-sm" @bind-Value="_entryForm.AverageSogKnots" /></td>
                                        <td>
                                            <button class="btn btn-xs btn-success" @onclick="() => OpslaanRegel(entry.Id)">✓</button>
                                            <button class="btn btn-xs btn-secondary" @onclick="AnnuleerBewerking">✕</button>
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    <tr class="@(entry.Status == LogbookEntryStatus.Draft ? "table-warning" : "")">
                                        <td>@BoordtijdHelper.NaarLokaal(entry.EntryTimeUtc).ToString("HH:mm")</td>
                                        <td>
                                            @if (entry.Status == LogbookEntryStatus.Draft)
                                            {
                                                <span class="badge bg-warning text-dark">Te accorderen</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">Definitief</span>
                                            }
                                        </td>
                                        <td>@(entry.BaroPressure.HasValue ? entry.BaroPressure.Value.ToString("F1") : "")</td>
                                        <td>@(entry.LogValue.HasValue ? entry.LogValue.Value.ToString("F1") : "")</td>
                                        <td>@(entry.Course.HasValue ? entry.Course.Value.ToString() + "°" : "")</td>
                                        <td>@entry.Remarks</td>
                                        <td><span class="text-muted small">—</span></td>
                                        <td>@entry.WindDescription</td>
                                        <td>@entry.GpsStatus</td>
                                        <td>@(entry.Latitude.HasValue ? entry.Latitude.Value.ToString("F4") : "")</td>
                                        <td>@(entry.Longitude.HasValue ? entry.Longitude.Value.ToString("F4") : "")</td>
                                        <td>@(entry.AverageSogKnots.HasValue ? entry.AverageSogKnots.Value.ToString("F1") + " kn" : "")</td>
                                        <td>
                                            <a class="btn btn-xs btn-outline-info" href="/logbook/entries/@entry.Id/details">Details</a>
                                            <button class="btn btn-xs btn-outline-secondary" @onclick="() => BewerkenRegel(entry)">✎</button>
                                            @if (entry.Status == LogbookEntryStatus.Draft)
                                            {
                                                <button class="btn btn-xs btn-outline-success" @onclick="() => AccorderenRegel(entry.Id)">✓ Accorderen</button>
                                            }
                                            <button class="btn btn-xs btn-outline-danger" @onclick="() => VerwijderRegel(entry)" title="Verwijderen">🗑</button>
                                        </td>
                                    </tr>
                                }
                            }

                            @if (_newEntryForm != null)
                            {
                                <!-- Nieuwe-regelrij onderaan -->
                                <tr class="table-success">
                                    <td><InputDate Type="InputDateType.DateTimeLocal" class="form-control form-control-sm" @bind-Value="_newEntryForm.EntryTimeLocal" /></td>
                                    <td><span class="text-muted small">—</span></td>
                                    <td><InputNumber class="form-control form-control-sm" @bind-Value="_newEntryForm.BaroPressure" /></td>
                                    <td><InputNumber class="form-control form-control-sm" @bind-Value="_newEntryForm.LogValue" /></td>
                                    <td><InputNumber class="form-control form-control-sm" @bind-Value="_newEntryForm.Course" /></td>
                                    <td><InputText class="form-control form-control-sm" @bind-Value="_newEntryForm.Remarks" /></td>
                                    <td><span class="text-muted small">—</span></td>
                                    <td><InputText class="form-control form-control-sm" @bind-Value="_newEntryForm.WindDescription" /></td>
                                    <td><InputText class="form-control form-control-sm" @bind-Value="_newEntryForm.GpsStatus" /></td>
                                    <td><InputNumber class="form-control form-control-sm" @bind-Value="_newEntryForm.Latitude" /></td>
                                    <td><InputNumber class="form-control form-control-sm" @bind-Value="_newEntryForm.Longitude" /></td>
                                    <td><InputNumber class="form-control form-control-sm" @bind-Value="_newEntryForm.AverageSogKnots" /></td>
                                    <td>
                                        <button class="btn btn-xs btn-info" title="Vul met laatste meetdata" @onclick="VulSuggestiesNieuweRegel">⊕</button>
                                        <button class="btn btn-xs btn-success" @onclick="OpslaanNieuweRegel">✓</button>
                                        <button class="btn btn-xs btn-secondary" @onclick="() => _newEntryForm = null">✕</button>
                                    </td>
                                </tr>
                            }

                            @if (!_entries.Any() && _newEntryForm == null)
                            {
                                <tr><td colspan="13" class="text-center text-muted">Nog geen logboekregels. Klik op "+&nbsp;Nieuwe regel" om te beginnen.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
}

@if (!string.IsNullOrEmpty(_foutmelding))
{
    <div class="alert alert-danger mt-3">@_foutmelding</div>
}

<!-- Verwijderingsbevestigingsmodaal -->
@if (_entryIdToDelete.HasValue)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.5);" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Regel verwijderen</h5>
                    <button type="button" class="btn-close" @onclick="AnnuleerVerwijdering"></button>
                </div>
                <div class="modal-body">
                    <p>Weet u zeker dat u de logboekregel van <strong>@_entryTimeToDelete</strong> wilt verwijderen?</p>
                    <p class="text-muted small">Dit kan niet ongedaan worden gemaakt.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="AnnuleerVerwijdering">Annuleren</button>
                    <button type="button" class="btn btn-danger" @onclick="BevestigVerwijdering">Verwijderen</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private string? _foutmelding;
    private bool _tripSaved;

    private List<LogbookTripDto> _trips = new();
    private LogbookTripDto? _selectedTrip;
    private TripFormModel? _tripForm;

    private List<LogbookEntryDto> _entries = new();
    private int? _editingEntryId;
    private EntryFormModel? _entryForm;
    private EntryFormModel? _newEntryForm;

    private MissedLogMomentsDto? _missedLogMoments;
    private bool _creatingDraftEntries;
    private bool _checkingMissedMoments;

    // Variabelen voor verwijderingsbevestiging
    private int? _entryIdToDelete;
    private string? _entryTimeToDelete;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _trips = (await LogbookService.GetAllTripsAsync()).ToList();
            if (_trips.Count > 0)
            {
                await SelecteerReis(_trips[0]);
            }
        }
        catch (Exception ex)
        {
            _foutmelding = $"Fout bij laden: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnTripSelected(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
        {
            var trip = _trips.FirstOrDefault(t => t.Id == id);
            if (trip != null) await SelecteerReis(trip);
        }
    }

    private async Task SelecteerReis(LogbookTripDto trip)
    {
        _selectedTrip = trip;
        _tripForm = new TripFormModel(trip);
        _entries = (await LogbookService.GetEntriesAsync(trip.Id)).ToList();
        _editingEntryId = null;
        _entryForm = null;
        _newEntryForm = null;
        _tripSaved = false;
        await BerekenVolgendeLogmoment();
    }

    private void NieuweReis()
    {
        _selectedTrip = null;
        _entries = new();
        _tripForm = new TripFormModel();
        _tripSaved = false;
    }

    private async Task OpslaanReis()
    {
        if (_tripForm == null) return;
        try
        {
            var dto = _tripForm.ToCreateDto();
            if (_selectedTrip == null)
            {
                var created = await LogbookService.CreateTripAsync(dto);
                _trips.Insert(0, created);
                _selectedTrip = created;
                _tripForm = new TripFormModel(created);
            }
            else
            {
                await LogbookService.UpdateTripAsync(_selectedTrip.Id, dto);
                var updated = await LogbookService.GetTripAsync(_selectedTrip.Id);
                if (updated != null)
                {
                    var idx = _trips.FindIndex(t => t.Id == updated.Id);
                    if (idx >= 0) _trips[idx] = updated;
                    _selectedTrip = updated;
                }
            }
            _tripSaved = true;
            _foutmelding = null;
        }
        catch (Exception ex)
        {
            _foutmelding = $"Opslaan mislukt: {ex.Message}";
        }
    }

    private void NieuweRegel()
    {
        _newEntryForm = new EntryFormModel();
        _editingEntryId = null;
        _entryForm = null;
    }

    private async Task VulSuggestiesNieuweRegel()
    {
        if (_newEntryForm == null || _selectedTrip == null) return;
        try
        {
            var suggesties = await SuggestionService.GetSuggestionsAsync(_selectedTrip.Id, BoordtijdHelper.NaarUtc(_newEntryForm.EntryTimeLocal));
            if (!_newEntryForm.Course.HasValue && suggesties.Course.HasValue)
                _newEntryForm.Course = suggesties.Course;
            if (string.IsNullOrWhiteSpace(_newEntryForm.WindDescription) && suggesties.WindDescription != null)
                _newEntryForm.WindDescription = suggesties.WindDescription;
            if (string.IsNullOrWhiteSpace(_newEntryForm.GpsStatus) && suggesties.GpsStatus != null)
                _newEntryForm.GpsStatus = suggesties.GpsStatus;
            if (!_newEntryForm.Latitude.HasValue && suggesties.Latitude.HasValue)
                _newEntryForm.Latitude = suggesties.Latitude;
            if (!_newEntryForm.Longitude.HasValue && suggesties.Longitude.HasValue)
                _newEntryForm.Longitude = suggesties.Longitude;
            if (!_newEntryForm.AverageSogKnots.HasValue && suggesties.AverageSogKnots.HasValue)
                _newEntryForm.AverageSogKnots = suggesties.AverageSogKnots;
        }
        catch (Exception ex)
        {
            _foutmelding = $"Suggesties ophalen mislukt: {ex.Message}";
        }
    }

    private async Task OpslaanNieuweRegel()
    {
        if (_newEntryForm == null || _selectedTrip == null) return;
        try
        {
            var entry = await LogbookService.CreateEntryAsync(_selectedTrip.Id, _newEntryForm.ToDto());
            _entries.Add(entry);
            _entries = _entries.OrderBy(e => e.EntryTimeUtc).ToList();
            _newEntryForm = null;
            _foutmelding = null;
            await BerekenVolgendeLogmoment();
        }
        catch (Exception ex)
        {
            _foutmelding = $"Opslaan mislukt: {ex.Message}";
        }
    }

    private void BewerkenRegel(LogbookEntryDto entry)
    {
        _editingEntryId = entry.Id;
        _entryForm = new EntryFormModel(entry);
        _newEntryForm = null;
    }

    private async Task OpslaanRegel(int entryId)
    {
        if (_entryForm == null) return;
        try
        {
            await LogbookService.UpdateEntryAsync(entryId, _entryForm.ToDto());
            var updated = _entries.FirstOrDefault(e => e.Id == entryId);
            if (updated != null)
            {
                var idx = _entries.IndexOf(updated);
                var dto = _entryForm.ToDto();
                _entries[idx] = new LogbookEntryDto
                {
                    Id = entryId,
                    LogbookTripId = updated.LogbookTripId,
                    EntryTimeUtc = dto.EntryTimeUtc,
                    BaroPressure = dto.BaroPressure,
                    LogValue = dto.LogValue,
                    Course = dto.Course,
                    Remarks = dto.Remarks,
                    WindDescription = dto.WindDescription,
                    GpsStatus = dto.GpsStatus,
                    Latitude = dto.Latitude,
                    Longitude = dto.Longitude,
                    AverageSogKnots = dto.AverageSogKnots,
                    Status = updated.Status,
                    UpdatedAtUtc = DateTime.UtcNow
                };
                _entries = _entries.OrderBy(e => e.EntryTimeUtc).ToList();
            }
            _editingEntryId = null;
            _entryForm = null;
            _foutmelding = null;
            // Herbereken het volgende verwachte logmoment, omdat de gebruiker
            // mogelijk de tijd van een regel heeft gewijzigd.
            await BerekenVolgendeLogmoment();
        }
        catch (Exception ex)
        {
            _foutmelding = $"Opslaan mislukt: {ex.Message}";
        }
    }

    private void AnnuleerBewerking()
    {
        _editingEntryId = null;
        _entryForm = null;
    }

    private async Task AccorderenRegel(int entryId)
    {
        try
        {
            await LogbookService.ConfirmEntryAsync(entryId);
            var idx = _entries.FindIndex(e => e.Id == entryId);
            if (idx >= 0)
            {
                var e = _entries[idx];
                _entries[idx] = new LogbookEntryDto
                {
                    Id = e.Id,
                    LogbookTripId = e.LogbookTripId,
                    EntryTimeUtc = e.EntryTimeUtc,
                    BaroPressure = e.BaroPressure,
                    LogValue = e.LogValue,
                    Course = e.Course,
                    Remarks = e.Remarks,
                    WindDescription = e.WindDescription,
                    GpsStatus = e.GpsStatus,
                    Latitude = e.Latitude,
                    Longitude = e.Longitude,
                    AverageSogKnots = e.AverageSogKnots,
                    Status = LogbookEntryStatus.Confirmed,
                    UpdatedAtUtc = DateTime.UtcNow
                };
            }
            _foutmelding = null;
        }
        catch (Exception ex)
        {
            _foutmelding = $"Accorderen mislukt: {ex.Message}";
        }
    }

    private async Task BerekenVolgendeLogmoment()
    {
        if (_selectedTrip == null || _checkingMissedMoments) return;
        try
        {
            _checkingMissedMoments = true;
            _missedLogMoments = await LogbookService.GetMissedLogMomentsAsync(_selectedTrip.Id);
        }
        catch (Exception ex)
        {
            _foutmelding = $"Fout bij berekening gemiste logmomenten: {ex.Message}";
        }
        finally
        {
            _checkingMissedMoments = false;
        }
    }

    /// <summary>
    /// Retourneert logboekregels in omgekeerde volgorde (nieuw naar oud) voor display.
    /// De interne _entries lijst blijft chronologisch oplopend voor berekeningen.
    /// </summary>
    private IEnumerable<LogbookEntryDto> GetDisplayEntries()
    {
        return _entries.AsEnumerable().Reverse();
    }

    private async Task MaakMultipleDraftRegels()
    {
        if (_selectedTrip == null) return;
        try
        {
            _creatingDraftEntries = true;
            var createdCount = await LogbookService.CreateMultipleDraftEntriesAsync(_selectedTrip.Id, 24);

            // Herlaad de entries
            _entries = (await LogbookService.GetEntriesAsync(_selectedTrip.Id)).ToList();

            // Herbereken gemiste logmomenten
            await BerekenVolgendeLogmoment();

            _foutmelding = null;
        }
        catch (Exception ex)
        {
            _foutmelding = $"Aanmaken Draft-regels mislukt: {ex.Message}";
        }
        finally
        {
            _creatingDraftEntries = false;
        }
    }

    private void VerwijderRegel(LogbookEntryDto entry)
    {
        _entryIdToDelete = entry.Id;
        _entryTimeToDelete = BoordtijdHelper.NaarLokaal(entry.EntryTimeUtc).ToString("HH:mm");
    }

    private async Task BevestigVerwijdering()
    {
        if (_entryIdToDelete == null || _selectedTrip == null) return;
        try
        {
            await LogbookService.DeleteEntryAsync(_entryIdToDelete.Value);

            // Verwijder uit lokale lijst
            _entries = _entries.Where(e => e.Id != _entryIdToDelete.Value).ToList();

            // Herbereken gemiste logmomenten
            await BerekenVolgendeLogmoment();

            _foutmelding = null;
        }
        catch (Exception ex)
        {
            _foutmelding = $"Verwijdering mislukt: {ex.Message}";
        }
        finally
        {
            _entryIdToDelete = null;
            _entryTimeToDelete = null;
        }
    }

    private void AnnuleerVerwijdering()
    {
        _entryIdToDelete = null;
        _entryTimeToDelete = null;
    }

