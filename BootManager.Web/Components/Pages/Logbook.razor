@page "/logbook"
@implements IAsyncDisposable
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Owner")]
@using BootManager.Application.Logbook.DTOs
@using BootManager.Application.Logbook.Services
@using BootManager.Application.OperationalSettings.DTOs
@using BootManager.Application.OperationalSettings.Services
@using BootManager.Application.VesselProfile.DTOs
@using BootManager.Core.Enums
@using BootManager.Web.Helpers
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using BootManager.Application.VesselProfile.Services
@inject ILogbookService LogbookService
@inject ILogbookMeasurementSuggestionService SuggestionService
@inject ILogbookAttachmentService AttachmentService
@inject IOperationalSettingsService OperationalSettingsService
@inject IVesselProfileService VesselProfileService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<h2 class="mb-3">Scheepsdagboek</h2>

@if (_operationalSettings != null && !_operationalSettings.IngestProcessingEnabled)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        <strong>⚠️ Ingest-verwerking uitgeschakeld</strong>
        <p class="mb-0">Automatische gegevensverzameling is momenteel uitgeschakeld. Meetgegevens worden niet opgeslagen in het logboek. Zet ingest-verwerking aan op het dashboard om normale werking te hervatten.</p>
    </div>
}

@if (_loading)
{
    <p>Laden…</p>
}
else
{
    <!-- Reisselectie en reisformulier -->
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Reis</span>
            <button class="btn btn-sm btn-outline-primary" @onclick="NieuweReis">+ Nieuwe reis</button>
        </div>
        <div class="card-body">
            @if (_trips.Count > 0)
            {
                <div class="mb-2">
                    <label class="form-label">Selecteer reis</label>
                    <select class="form-select form-select-sm" @onchange="OnTripSelected">
                        <option value="">— kies een reis —</option>
                        @foreach (var t in _trips)
                        {
                            <option value="@t.Id" selected="@(_selectedTrip?.Id == t.Id)">@t.Name (@BoordtijdHelper.NaarLokaal(t.DepartureUtc).ToString("dd-MM-yyyy HH:mm"))</option>
                        }
                    </select>
                </div>
            }

            @if (_tripForm != null)
            {
                <EditForm Model="_tripForm" OnValidSubmit="OpslaanReis">
                    <DataAnnotationsValidator />
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label">Reisnaam *</label>
                            <InputText class="form-control form-control-sm" @bind-Value="_tripForm.Name" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Vertrek</label>
                            <InputDate Type="InputDateType.DateTimeLocal" class="form-control form-control-sm" @bind-Value="_tripForm.DepartureDateTimeLocal" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Aankomst</label>
                            <InputDate Type="InputDateType.DateTimeLocal" class="form-control form-control-sm" @bind-Value="_tripForm.ArrivalDateTimeLocal" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Vertrekhaven</label>
                            <InputText class="form-control form-control-sm" @bind-Value="_tripForm.DeparturePort" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Bestemming</label>
                            <InputText class="form-control form-control-sm" @bind-Value="_tripForm.DestinationPort" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Vaartuig</label>
                            <InputText class="form-control form-control-sm" @bind-Value="_tripForm.VesselName" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Bemanning</label>
                            <InputText class="form-control form-control-sm" @bind-Value="_tripForm.Crew" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Loginterval (min)</label>
                            <InputNumber class="form-control form-control-sm" @bind-Value="_tripForm.LogIntervalMinutes" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Notities</label>
                            <InputTextArea class="form-control form-control-sm" rows="2" @bind-Value="_tripForm.Notes" />
                        </div>
                    </div>

                    <!-- Reis-samenvatting -->
                    <div class="mt-3 mb-1 fw-semibold small text-secondary">Reis-samenvatting</div>
                    <div class="row g-2">
                        <div class="col-md-2">
                            <label class="form-label">Logstand start (nm)</label>
                            <div class="input-group input-group-sm">
                                <InputNumber class="form-control" @bind-Value="_tripForm.LogstandStart" />
                                <button type="button"
                                        class="btn btn-outline-secondary"
                                        @onclick="CopyLogstandFromProfile"
                                        disabled="@(!CanCopyLogstand)"
                                        title="@LogstandCopyTitle">
                                    📋
                                </button>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Logstand eind (nm)</label>
                            <InputNumber class="form-control form-control-sm" @bind-Value="_tripForm.LogstandEnd" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Gelogde mijlen</label>
                            <input class="form-control form-control-sm"
                                   value="@FormatNauticalMiles(_tripForm.CalculatedLoggedMiles)"
                                   readonly />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Motor uren start</label>
                            <div class="input-group input-group-sm">
                                <InputNumber class="form-control" @bind-Value="_tripForm.EngineHoursStart" />
                                <button type="button"
                                        class="btn btn-outline-secondary"
                                        @onclick="CopyEngineHoursFromProfile"
                                        disabled="@(!CanCopyEngineHours)"
                                        title="@EngineHoursCopyTitle">
                                    📋
                                </button>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Motor uren eind</label>
                            <InputNumber class="form-control form-control-sm" @bind-Value="_tripForm.EngineHoursEnd" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Brandstof</label>
                            <InputText class="form-control form-control-sm" @bind-Value="_tripForm.Fuel" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Totaal vaaruren</label>
                            <InputNumber class="form-control form-control-sm" @bind-Value="_tripForm.TotalSailingHours" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Reisduur</label>
                            <input class="form-control form-control-sm"
                                   value="@FormatTripDuration(_tripForm.TotalTripDuration)"
                                   readonly />
                        </div>
                    </div>
                    <div class="mt-2">
                        <button type="submit" class="btn btn-sm btn-primary">Opslaan</button>
                        @if (_tripSaved)
                        {
                            <span class="text-success ms-2">✓ Opgeslagen</span>
                        }
                    </div>
                </EditForm>
            }
        </div>
    </div>

    <!-- Logboektabel -->
    @if (_selectedTrip != null)
    {
        <!-- Banner voor vermiste logmomenten -->
        @if (_missedLogMoments != null && _missedLogMoments.TotalCount > 0)
        {
            <div class="alert alert-warning alert-dismissible fade show mb-3" role="alert">
                <strong>⚠ Gemiste logmomenten:</strong>
                <span class="ms-1">@_missedLogMoments.TotalCount</span>

                @if (_missedLogMoments.MissedMoments.Count > 0)
                {
                    <span class="ms-1">(@string.Join(", ", _missedLogMoments.MissedMoments.Take(5).Select(m => BoordtijdHelper.NaarLokaal(m.EntryTimeUtc).ToString("HH:mm"))))</span>
                    @if (_missedLogMoments.MissedMoments.Count > 5)
                    {
                        <span class="ms-1">+ @(_missedLogMoments.MissedMoments.Count - 5) meer</span>
                    }
                }

                <button type="button" class="btn btn-sm btn-warning ms-2" @onclick="MaakMultipleDraftRegels" disabled="@_creatingDraftEntries">
                    @if (_creatingDraftEntries)
                    {
                        <span>Aanmaken…</span>
                    }
                    else
                    {
                        <span>Conceptregels aanmaken</span>
                    }
                </button>
                <button type="button" class="btn-close" @onclick="() => _missedLogMoments = null"></button>
            </div>
        }

        <!-- Filter UI -->
        <div class="card mb-3">
            <div class="card-body py-3">
                <div class="row g-2 align-items-end">
                    <!-- Status filter -->
                    <div class="col-12 col-sm-6 col-md-3">
                        <label class="form-label form-label-sm mb-1" for="statusFilter">Status</label>
                        <select id="statusFilter" class="form-select form-select-sm" @onchange="OnStatusFilterChanged" value="@_statusFilter">
                            <option value="all">Alle</option>
                            <option value="draft">Concept / Te accorderen</option>
                            <option value="confirmed">Definitief</option>
                        </select>
                    </div>

                    <!-- Attachment filter -->
                    <div class="col-12 col-sm-6 col-md-3">
                        <label class="form-label form-label-sm mb-1" for="attachmentFilter">Bijlagen</label>
                        <select id="attachmentFilter" class="form-select form-select-sm" @onchange="OnAttachmentFilterChanged" value="@_attachmentFilter">
                            <option value="all">Alle</option>
                            <option value="with">Met bijlagen</option>
                            <option value="without">Zonder bijlagen</option>
                        </select>
                    </div>

                    <!-- Search filter -->
                    <div class="col-12 col-md-4">
                        <label class="form-label form-label-sm mb-1" for="searchFilter">Zoeken</label>
                        <input id="searchFilter" type="text" class="form-control form-control-sm" placeholder="Opmerkingen, wind, GPS…" @onchange="OnSearchFilterChanged" value="@_searchFilter" />
                    </div>

                    <!-- Date range filters (optional) -->
                    <div class="col-12 col-sm-6 col-md-2 d-md-none">
                        <label class="form-label form-label-sm mb-1">Datumfilter</label>
                        <button type="button" class="btn btn-sm btn-outline-secondary w-100" data-bs-toggle="modal" data-bs-target="#dateFilterModal">
                            📅 Filter
                        </button>
                    </div>

                    <!-- Reset button -->
                    <div class="col-12 col-sm-6 col-md-auto">
                        <button type="button" class="btn btn-sm btn-outline-secondary w-100 w-md-auto" @onclick="ResetFilters">
                            ⟳ Reset
                        </button>
                    </div>
                </div>

                <!-- Desktop date range (shown only on md and larger) -->
                <div class="row g-2 align-items-end mt-2 d-none d-md-flex">
                    <div class="col-auto">
                        <small class="text-muted">Periode:</small>
                    </div>
                    <div class="col-auto">
                        <input type="date" class="form-control form-control-sm" style="width: 130px;" @onchange="OnDateFilterStartChanged" value="@_dateFilterStart?.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-auto">
                        <span class="text-muted small">tot</span>
                    </div>
                    <div class="col-auto">
                        <input type="date" class="form-control form-control-sm" style="width: 130px;" @onchange="OnDateFilterEndChanged" value="@_dateFilterEnd?.ToString("yyyy-MM-dd")" />
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Logboekregels — @_selectedTrip.Name</span>
                <div class="d-flex gap-2">
                    @if (_selectedTrip.Status == LogbookTripStatus.Open)
                    {
                        <button class="btn btn-sm btn-danger" @onclick="OpenCompleteModal" title="Reis afronden bij aankomst">
                            ⊗ Beëindig reis
                        </button>
                        <a class="btn btn-sm btn-outline-secondary" href="/logbook/trips/@_selectedTrip.Id/print" target="_blank">🖨 Afdrukweergave</a>
                        <button class="btn btn-sm btn-outline-success" @onclick="NieuweRegel">+ Nieuwe regel</button>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Afgesloten</span>
                        <a class="btn btn-sm btn-outline-secondary" href="/logbook/trips/@_selectedTrip.Id/print" target="_blank">🖨 Afdrukweergave</a>
                    }
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive logbook-table-wrapper">
                    <table class="table table-sm table-bordered table-hover mb-0 logbook-table">
                        <thead class="table-dark">
                            <tr>
                                <th>Tijd (lokaal)</th>
                                <th>Status</th>
                                <th>Baro</th>
                                <th>Log</th>
                                <th>Koers</th>
                                <th>Positie / zeilvoering / opmerkingen</th>
                                <th>Bijlagen</th>
                                <th>Wind</th>
                                <th>GPS</th>
                                <th>Lat.</th>
                                <th>Long.</th>
                                <th>Gem. SOG</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in GetFilteredAndSortedEntries())
                            {
                                @if (_editingEntryId == entry.Id && _entryForm != null)
                                {
                                    <!-- Bewerkingsrij -->
                                    <tr class="table-warning">
                                        <td><InputDate Type="InputDateType.DateTimeLocal" class="form-control form-control-sm" @bind-Value="_entryForm.EntryTimeLocal" /></td>
                                        <td><span class="text-muted small">—</span></td>
                                        <td><InputNumber class="form-control form-control-sm" @bind-Value="_entryForm.BaroPressure" /></td>
                                        <td><InputNumber class="form-control form-control-sm" @bind-Value="_entryForm.LogValue" /></td>
                                        <td><InputNumber class="form-control form-control-sm" @bind-Value="_entryForm.Course" /></td>
                                        <td><InputText class="form-control form-control-sm" @bind-Value="_entryForm.Remarks" /></td>
                                        <td><span class="text-muted small">—</span></td>
                                        <td><InputText class="form-control form-control-sm" @bind-Value="_entryForm.WindDescription" /></td>
                                        <td><InputText class="form-control form-control-sm" @bind-Value="_entryForm.GpsStatus" /></td>
                                        <td><InputNumber class="form-control form-control-sm" @bind-Value="_entryForm.Latitude" /></td>
                                        <td><InputNumber class="form-control form-control-sm" @bind-Value="_entryForm.Longitude" /></td>
                                        <td><InputNumber class="form-control form-control-sm" @bind-Value="_entryForm.AverageSogKnots" /></td>
                                        <td>
                                            <button class="btn btn-xs btn-success" @onclick="() => OpslaanRegel(entry.Id)">✓</button>
                                            <button class="btn btn-xs btn-secondary" @onclick="AnnuleerBewerking">✕</button>
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    <tr class="@(entry.Status == LogbookEntryStatus.Draft ? "table-warning" : "")">
                                        <td>@BoordtijdHelper.NaarLokaal(entry.EntryTimeUtc).ToString("HH:mm")</td>
                                        <td>
                                            @if (entry.Status == LogbookEntryStatus.Draft)
                                            {
                                                <span class="badge bg-warning text-dark">Te accorderen</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">Definitief</span>
                                            }
                                        </td>
                                        <td>@(entry.BaroPressure.HasValue ? entry.BaroPressure.Value.ToString("F1") : "")</td>
                                        <td>@(entry.LogValue.HasValue ? entry.LogValue.Value.ToString("F1") : "")</td>
                                        <td>@(entry.Course.HasValue ? entry.Course.Value.ToString() + "°" : "")</td>
                                        <td>@entry.Remarks</td>
                                        <td>
                                            <div class="btn-group btn-group-sm" role="group">
                                                @if (entry.AttachmentCount > 0)
                                                {
                                                    <a href="@($"/logbook/entries/{entry.Id}/details")" class="badge bg-info text-decoration-none" title="Bijlagen beheren">📎 @entry.AttachmentCount</a>
                                                }
                                                else
                                                {
                                                    <span class="text-muted small">—</span>
                                                }
                                                <button class="btn btn-outline-primary btn-sm" @onclick="() => OpenUploadModal(entry.Id)" title="Bijlage toevoegen">📎+</button>
                                            </div>
                                        </td>
                                        <td>@entry.WindDescription</td>
                                        <td>@entry.GpsStatus</td>
                                        <td>@(entry.Latitude.HasValue ? entry.Latitude.Value.ToString("F4") : "")</td>
                                        <td>@(entry.Longitude.HasValue ? entry.Longitude.Value.ToString("F4") : "")</td>
                                        <td>@(entry.AverageSogKnots.HasValue ? entry.AverageSogKnots.Value.ToString("F1") + " kn" : "")</td>
                                        <td>
                                            <a class="btn btn-xs btn-outline-info" href="/logbook/entries/@entry.Id/details">Details</a>
                                            <button class="btn btn-xs btn-outline-secondary" @onclick="() => BewerkenRegel(entry)">✎</button>
                                            @if (entry.Status == LogbookEntryStatus.Draft)
                                            {
                                                <button class="btn btn-xs btn-outline-success" @onclick="() => AccorderenRegel(entry.Id)">✓ Accorderen</button>
                                            }
                                            <button class="btn btn-xs btn-outline-danger" @onclick="() => VerwijderRegel(entry)" title="Verwijderen">🗑</button>
                                        </td>
                                    </tr>
                                }
                            }

                            @if (_newEntryForm != null)
                            {
                                <!-- Nieuwe-regelrij onderaan -->
                                <tr class="table-success">
                                    <td><InputDate Type="InputDateType.DateTimeLocal" class="form-control form-control-sm" @bind-Value="_newEntryForm.EntryTimeLocal" /></td>
                                    <td><span class="text-muted small">—</span></td>
                                    <td><InputNumber class="form-control form-control-sm" @bind-Value="_newEntryForm.BaroPressure" /></td>
                                    <td><InputNumber class="form-control form-control-sm" @bind-Value="_newEntryForm.LogValue" /></td>
                                    <td><InputNumber class="form-control form-control-sm" @bind-Value="_newEntryForm.Course" /></td>
                                    <td><InputText class="form-control form-control-sm" @bind-Value="_newEntryForm.Remarks" /></td>
                                    <td><span class="text-muted small">—</span></td>
                                    <td><InputText class="form-control form-control-sm" @bind-Value="_newEntryForm.WindDescription" /></td>
                                    <td><InputText class="form-control form-control-sm" @bind-Value="_newEntryForm.GpsStatus" /></td>
                                    <td><InputNumber class="form-control form-control-sm" @bind-Value="_newEntryForm.Latitude" /></td>
                                    <td><InputNumber class="form-control form-control-sm" @bind-Value="_newEntryForm.Longitude" /></td>
                                    <td><InputNumber class="form-control form-control-sm" @bind-Value="_newEntryForm.AverageSogKnots" /></td>
                                    <td>
                                        <button class="btn btn-xs btn-info" title="Vul met laatste meetdata" @onclick="VulSuggestiesNieuweRegel">⊕</button>
                                        <button class="btn btn-xs btn-success" @onclick="OpslaanNieuweRegel">✓</button>
                                        <button class="btn btn-xs btn-secondary" @onclick="() => _newEntryForm = null">✕</button>
                                    </td>
                                </tr>
                            }

                            @if (!GetFilteredAndSortedEntries().Any() && _newEntryForm == null)
                            {
                                <tr><td colspan="13" class="text-center text-muted">@GetEmptyEntriesMessage()</td></tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Responsive card view for mobile/tablet -->
                <div class="logbook-cards-wrapper px-2 py-2" id="cardScrollContainer">
                    @if (!GetFilteredAndSortedEntries().Any())
                    {
                        <div class="text-center text-muted py-4">
                            @GetEmptyEntriesMessage()
                        </div>
                    }
                    else
                    {
                        @foreach (var entry in _displayedEntries)
                        {
                            @if (_editingEntryId != entry.Id)
                            {
                                <div class="logbook-card @(entry.Status == LogbookEntryStatus.Draft ? "draft" : "")">
                                <div class="logbook-card-header">
                                    <div>
                                        <div class="logbook-card-header-time">@BoordtijdHelper.NaarLokaal(entry.EntryTimeUtc).ToString("HH:mm")</div>
                                    </div>
                                    <div class="logbook-card-header-badges">
                                        @if (entry.Status == LogbookEntryStatus.Draft)
                                        {
                                            <span class="badge bg-warning text-dark">Concept</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Definitief</span>
                                        }
                                        @if (entry.AttachmentCount > 0)
                                        {
                                            <span class="badge bg-info">📎 @entry.AttachmentCount</span>
                                        }
                                    </div>
                                </div>

                                <div class="logbook-card-body">
                                    @if (!string.IsNullOrWhiteSpace(entry.Remarks))
                                    {
                                        <div class="logbook-card-remarks">
                                            <strong>@entry.Remarks</strong>
                                        </div>
                                    }

                                    <div class="logbook-card-data">
                                        @if (entry.BaroPressure.HasValue)
                                        {
                                            <div class="logbook-data-item">
                                                <span class="logbook-data-label">Baro</span>
                                                <span class="logbook-data-value">@entry.BaroPressure.Value.ToString("F1") hPa</span>
                                            </div>
                                        }
                                        @if (entry.LogValue.HasValue)
                                        {
                                            <div class="logbook-data-item">
                                                <span class="logbook-data-label">Log</span>
                                                <span class="logbook-data-value">@entry.LogValue.Value.ToString("F1") nm</span>
                                            </div>
                                        }
                                        @if (entry.Course.HasValue)
                                        {
                                            <div class="logbook-data-item">
                                                <span class="logbook-data-label">Koers</span>
                                                <span class="logbook-data-value">@entry.Course.Value°</span>
                                            </div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(entry.WindDescription))
                                        {
                                            <div class="logbook-data-item">
                                                <span class="logbook-data-label">Wind</span>
                                                <span class="logbook-data-value">@entry.WindDescription</span>
                                            </div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(entry.GpsStatus))
                                        {
                                            <div class="logbook-data-item">
                                                <span class="logbook-data-label">GPS</span>
                                                <span class="logbook-data-value">@entry.GpsStatus</span>
                                            </div>
                                        }
                                        @if (entry.Latitude.HasValue)
                                        {
                                            <div class="logbook-data-item">
                                                <span class="logbook-data-label">Lat</span>
                                                <span class="logbook-data-value">@entry.Latitude.Value.ToString("F4")</span>
                                            </div>
                                        }
                                        @if (entry.Longitude.HasValue)
                                        {
                                            <div class="logbook-data-item">
                                                <span class="logbook-data-label">Long</span>
                                                <span class="logbook-data-value">@entry.Longitude.Value.ToString("F4")</span>
                                            </div>
                                        }
                                        @if (entry.AverageSogKnots.HasValue)
                                        {
                                            <div class="logbook-data-item">
                                                <span class="logbook-data-label">Gem. SOG</span>
                                                <span class="logbook-data-value">@entry.AverageSogKnots.Value.ToString("F1") kn</span>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <div class="logbook-card-actions">
                                    <a class="btn btn-sm btn-outline-info" href="/logbook/entries/@entry.Id/details">Details</a>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => BewerkenRegel(entry)">Bewerken</button>
                                    @if (entry.Status == LogbookEntryStatus.Draft)
                                    {
                                        <button class="btn btn-sm btn-outline-success" @onclick="() => AccorderenRegel(entry.Id)">Accorderen</button>
                                    }
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => VerwijderRegel(entry)">Verwijderen</button>
                                    @if (entry.AttachmentCount > 0)
                                    {
                                        <a href="@($"/logbook/entries/{entry.Id}/details")" class="btn btn-sm btn-outline-info" title="Bijlagen beheren">Bijlagen</a>
                                    }
                                    else
                                    {
