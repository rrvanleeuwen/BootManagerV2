    private class TripFormModel
    {
        public string Name { get; set; } = string.Empty;

        /// <summary>
        /// Vertrek: lokale boordtijd voor weergave en invoer. Wordt bij opslaan naar UTC geconverteerd.
        /// </summary>
        public DateTime DepartureDateTimeLocal { get; set; } = BoordtijdHelper.NaarLokaal(DateTime.UtcNow).Date;

        /// <summary>
        /// Aankomst: lokale boordtijd voor weergave en invoer. Null als reis nog loopt. Wordt bij opslaan naar UTC geconverteerd.
        /// </summary>
        public DateTime? ArrivalDateTimeLocal { get; set; }

        // Interne UTC-opslag (niet direct gebonden in formulier)
        public DateTime DepartureUtc { get; set; } = DateTime.UtcNow.Date;
        public DateTime? ArrivalUtcInput { get; set; }

        public string? DeparturePort { get; set; }
        public string? DestinationPort { get; set; }
        public string? VesselName { get; set; }
        public string? Crew { get; set; }
        public string? Notes { get; set; }
        public decimal? LogstandStart { get; set; }
        public decimal? LogstandEnd { get; set; }
        public decimal? CalculatedLoggedMiles =>
            LogstandStart.HasValue && LogstandEnd.HasValue && LogstandEnd.Value >= LogstandStart.Value
                ? LogstandEnd.Value - LogstandStart.Value
                : null;
        public decimal? EngineHoursStart { get; set; }
        public decimal? EngineHoursEnd { get; set; }
        public string? Fuel { get; set; }
        public decimal? TotalSailingHours { get; set; }
        public decimal? TotalTripDuration { get; set; }
        public int LogIntervalMinutes { get; set; } = 60;

        public TripFormModel() 
        {
            DepartureDateTimeLocal = BoordtijdHelper.NaarLokaal(DateTime.UtcNow).Date;
            DepartureUtc = DateTime.UtcNow.Date;
        }

        public TripFormModel(LogbookTripDto dto)
        {
            Name = dto.Name;

            // Converteer UTC naar lokale boordtijd voor weergave
            DepartureDateTimeLocal = BoordtijdHelper.NaarLokaal(dto.DepartureUtc);
            DepartureUtc = dto.DepartureUtc;

            // Converteer ArrivalUtc naar lokaal als het bestaat
            if (dto.ArrivalUtc.HasValue)
            {
                ArrivalDateTimeLocal = BoordtijdHelper.NaarLokaal(dto.ArrivalUtc.Value);
            }
            ArrivalUtcInput = dto.ArrivalUtc;

            DeparturePort = dto.DeparturePort;
            DestinationPort = dto.DestinationPort;
            VesselName = dto.VesselName;
            Crew = dto.Crew;
            Notes = dto.Notes;
            LogstandStart = dto.LogstandStart;
            LogstandEnd = dto.LogstandEnd;
            EngineHoursStart = dto.EngineHoursStart;
            EngineHoursEnd = dto.EngineHoursEnd;
            Fuel = dto.Fuel;
            TotalSailingHours = dto.TotalSailingHours;
            TotalTripDuration = dto.TotalTripDuration;
            LogIntervalMinutes = dto.LogIntervalMinutes;
        }

        public CreateLogbookTripDto ToCreateDto() => new()
        {
            Name = Name,
            DepartureUtc = BoordtijdHelper.NaarUtc(DepartureDateTimeLocal),
            ArrivalUtc = ArrivalDateTimeLocal.HasValue 
                ? BoordtijdHelper.NaarUtc(ArrivalDateTimeLocal.Value)
                : null,
            DeparturePort = DeparturePort,
            DestinationPort = DestinationPort,
            VesselName = VesselName,
            Crew = Crew,
            Notes = Notes,
            LogstandStart = LogstandStart,
            LogstandEnd = LogstandEnd,
            EngineHoursStart = EngineHoursStart,
            EngineHoursEnd = EngineHoursEnd,
            Fuel = Fuel,
            TotalSailingHours = TotalSailingHours,
            LogIntervalMinutes = LogIntervalMinutes
        };
    }

