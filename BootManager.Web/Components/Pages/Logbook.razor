    /// <summary>
    /// Cleanup voor JavaScript interop
    /// </summary>
    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        if (_infiniteScrollModule is not null)
        {
            try
            {
                await _infiniteScrollModule.InvokeVoidAsync("disconnectInfiniteScroll");
                await _infiniteScrollModule.DisposeAsync();
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"Error disposing infinite scroll: {ex.Message}");
            }
        }
    }
