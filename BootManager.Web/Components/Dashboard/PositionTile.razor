@using System.Globalization

<DashboardTile Title="Positie" OnHideCallback="OnHideCallback">
    <p class="gauge-value position-text">@Latitude°</p>
    <p class="gauge-value position-text">@Longitude°</p>
    <small class="gauge-timestamp">@Timestamp</small>
</DashboardTile>

@code {
    /// <summary>
    /// Latitude (formatted).
    /// </summary>
    [Parameter]
    public string Latitude { get; set; } = "";

    /// <summary>
    /// Longitude (formatted).
    /// </summary>
    [Parameter]
    public string Longitude { get; set; } = "";

    /// <summary>
    /// Timestamp (formatted).
    /// </summary>
    [Parameter]
    public string Timestamp { get; set; } = "";

    /// <summary>
    /// Callback voor hide-knop.
    /// </summary>
    [Parameter]
    public EventCallback OnHideCallback { get; set; }
}
