@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Nav

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }
    private bool _checked;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _checked) return;

        _checked = true;

        // Bootstrap guarantees that a local Owner exists. The startup gate therefore
        // only decides where the site root should lead and must not call legacy
        // OwnerProfile registration services.
        var relative = Nav.ToBaseRelativePath(Nav.Uri).Trim('/');
        if (!string.IsNullOrEmpty(relative))
            return;

        var auth = AuthenticationStateTask is null ? null : await AuthenticationStateTask;
        var isAuthenticated = auth?.User?.Identity?.IsAuthenticated == true;
        if (!isAuthenticated)
        {
            Nav.NavigateTo("/login", replace: true);
        }
    }
}
