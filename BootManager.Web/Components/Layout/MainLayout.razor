@inherits LayoutComponentBase
@implements IAsyncDisposable
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Routing

@using Microsoft.Extensions.Logging
@inject NavigationManager Nav
@inject IJSRuntime Js
@inject ILogger<MainLayout> Logger

<!-- SB Admin 2 theme and FontAwesome -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/startbootstrap-sb-admin-2@4.1.4/css/sb-admin-2.min.css" rel="stylesheet" />
<link href="/css/site.css" rel="stylesheet" />

@if (!string.IsNullOrEmpty(_logoutError))
{
    <div class="alert alert-danger" style="position: fixed; top: 4.5rem; right: 1rem; z-index: 1200; min-width: 250px;" role="alert">
        @_logoutError
        <button type="button" class="close ml-2" @onclick="@(() => _logoutError = null)" aria-label="Sluiten">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

<div class="navbar navbar-expand-lg navbar-light bg-white topbar mb-4 static-top shadow site-header">
    <div class="container-fluid">
        <a class="navbar-brand" href="/">BootManager</a>
        <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#topNavbarSupportedContent" aria-controls="topNavbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
            <span class="fa fa-bars"></span>
        </button>

        <NavMenu />

        <ul class="navbar-nav ml-auto">
            <li class="nav-item dropdown no-arrow" style="position: relative;">
                <AuthorizeView>
                    <Authorized Context="authState">
                        <button class="btn btn-link nav-link d-flex align-items-center"
                                @onclick="ToggleMenu"
                                id="userDropdown"
                                aria-haspopup="true"
                                aria-expanded="@_menuOpen.ToString().ToLower()"
                                title="Accountmenu">
                            <span class="mr-2 d-none d-lg-inline text-gray-600 small">Ingelogd als @GetDisplayName(authState)</span>
                            <i class="fas fa-user-circle fa-lg"></i>
                        </button>
                        @if (_menuOpen)
                        {
                            <!-- Transparante overlay: klik buiten dropdown sluit hem -->
                            <div style="position: fixed; inset: 0; z-index: 1040;" @onclick="CloseMenu" aria-hidden="true"></div>
                            <div class="dropdown-menu dropdown-menu-right shadow animated--grow-in show"
                                 style="z-index: 1050; display: block;"
                                 aria-labelledby="userDropdown">
                                <a class="dropdown-item" href="/account" @onclick="CloseMenu">Mijn account</a>
                                <AuthorizeView Roles="Owner">
                                    <Authorized>
                                        <div class="dropdown-divider"></div>
                                        <a class="dropdown-item" href="/settings" @onclick="CloseMenu">Instellingen</a>
                                    </Authorized>
                                </AuthorizeView>
                                <div class="dropdown-divider"></div>
                                <button class="dropdown-item" @onclick="Logout" disabled="@_logoutBusy">@(_logoutBusy ? "Uitloggen..." : "Uitloggen")</button>
                            </div>
                        }
                    </Authorized>
                    <NotAuthorized>
                        <a class="nav-link" href="/login">Inloggen</a>
                    </NotAuthorized>
                </AuthorizeView>
            </li>
        </ul>
    </div>
</div>

<div class="container-fluid">
    <main>
        <article class="content p-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

<!-- SB Admin 2 scripts -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/startbootstrap-sb-admin-2@4.1.4/js/sb-admin-2.min.js"></script>
<script src="/js/ui.js"></script>

@code {
    private IJSObjectReference? _authModule;
    private bool _logoutBusy;
    private string? _logoutError;
    private bool _menuOpen;

    /// <summary>
    /// Importeert de auth-JavaScript-helper en stelt auto-collapse in voor het mobiele menu.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _authModule = await Js.InvokeAsync<IJSObjectReference>("import", "/js/authClient.js");
            }
            catch (JSDisconnectedException) { }
            catch (JSException ex)
            {
                _logoutError = "Navigatiemodule kon niet worden geladen. Ververs de pagina.";
                Logger.LogError(ex, "MainLayout: module-import (/js/authClient.js) mislukt.");
                StateHasChanged();
            }
            try
            {
                await Js.InvokeVoidAsync("setupAutoCollapse", "topNavbarSupportedContent", null);
            }
            catch (JSDisconnectedException) { }
            catch (JSException ex)
            {
                Logger.LogWarning(ex, "MainLayout: setupAutoCollapse mislukt; navbar-animatie niet beschikbaar.");
            }
        }
    }

    private void ToggleMenu()
    {
        _menuOpen = !_menuOpen;
    }

    private void CloseMenu()
    {
        _menuOpen = false;
    }

    /// <summary>
    /// Geeft de displaynaam terug die in de header wordt getoond.
    /// </summary>
    private string GetDisplayName(AuthenticationState authState)
    {
        return authState.User.Identity?.Name ?? "Owner";
    }

    /// <summary>
    /// Roept het logout-endpoint aan via de JS-helper zodat de cookie in de browsersessie wordt gewist,
    /// sluit daarna de dropdown en navigeert naar /login.
    /// </summary>
    private async Task Logout()
    {
        _menuOpen = false;

        if (_authModule is null)
        {
            _logoutError = "Actie mislukt. Probeer opnieuw.";
            return;
        }

        try
        {
            _logoutBusy = true;
            _logoutError = null;
            var result = await _authModule.InvokeAsync<FetchResult>("postJson", "/auth/logout", new { });
            if (result.Ok)
            {
                Nav.NavigateTo("/login", forceLoad: true);
            }
            else
            {
                _logoutError = "Uitloggen mislukt.";
            }
        }
        catch (JSException ex)
        {
            _logoutError = $"Uitloggen mislukt: {ex.Message}";
        }
        finally
        {
            _logoutBusy = false;
        }
    }

    /// <summary>
    /// Ruimt de geïmporteerde JS-module op. JSDisconnectedException wordt genegeerd: het circuit is al weg.
    /// </summary>
    public async ValueTask DisposeAsync()
    {
        if (_authModule is not null)
        {
            try { await _authModule.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }

    private sealed class FetchResult
    {
        public bool Ok { get; set; }
        public int Status { get; set; }
        public string? Body { get; set; }
    }
}
