@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing

<!-- Top navigation items rendered as horizontal navbar links. Intended to be placed inside the topbar. -->
<div class="collapse navbar-collapse" id="topNavbarSupportedContent">
    <ul class="navbar-nav mr-auto">
        <li class="nav-item">
            <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">
                <i class="fas fa-home"></i>
                <span class="ml-2">Home</span>
            </NavLink>
        </li>

        <AuthorizeView Context="authContext">
            <Authorized>
                <!-- Shared features for all authenticated users -->
                <li class="nav-item">
                    <NavLink class="nav-link" href="scan">
                        <i class="fas fa-qrcode"></i>
                        <span class="ml-2">Scannen</span>
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="logbook">
                        <i class="fas fa-book"></i>
                        <span class="ml-2">Logboek</span>
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="dashboard">
                        <i class="fas fa-tachometer-alt"></i>
                        <span class="ml-2">Dashboard</span>
                    </NavLink>
                </li>

                <!-- Owner and Crew features -->
                <AuthorizeView Roles="Owner,Crew" Context="inventoryContext">
                    <Authorized>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="inventoryDropdown" role="button" @onclick="ToggleInventoryDropdown" @onclick:preventDefault>
                                <i class="fas fa-warehouse"></i>
                                <span class="ml-2">Voorraadbeheer</span>
                            </a>
                            <ul class="dropdown-menu" id="inventoryMenu" style="display: @(_inventoryDropdownOpen ? "block" : "none");">
                                <li>
                                    <NavLink class="dropdown-item" href="inventory/products" @onclick="CloseInventoryDropdown">
                                        Producten
                                    </NavLink>
                                </li>
                                <li>
                                    <NavLink class="dropdown-item" href="inventory/categories" @onclick="CloseInventoryDropdown">
                                        Categorieen
                                    </NavLink>
                                </li>
                                <li>
                                    <NavLink class="dropdown-item" href="inventory/units" @onclick="CloseInventoryDropdown">
                                        Eenheden
                                    </NavLink>
                                </li>
                            </ul>
                        </li>
                    </Authorized>
                </AuthorizeView>

                <!-- Storage navigation for Owner and Crew -->
                <AuthorizeView Roles="Owner,Crew" Context="storageContext">
                    <Authorized>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="storageDropdown" role="button" @onclick="ToggleStorageDropdown" @onclick:preventDefault>
                                <i class="fas fa-cube"></i>
                                <span class="ml-2">Opslag</span>
                            </a>
                            <ul class="dropdown-menu" id="storageMenu" style="display: @(_storageDropdownOpen ? "block" : "none");">
                                <li>
                                    <NavLink class="dropdown-item" href="storage/locations" @onclick="CloseStorageDropdown">
                                        Locaties
                                    </NavLink>
                                </li>
                                @if (storageContext.User.IsInRole("Owner"))
                                {
                                    <li>
                                        <NavLink class="dropdown-item" href="storage/tag-overview" @onclick="CloseStorageDropdown">
                                            Tagoverzicht
                                        </NavLink>
                                    </li>
                                }
                            </ul>
                        </li>
                    </Authorized>
                </AuthorizeView>

                <!-- Owner-only features -->
                <AuthorizeView Roles="Owner" Context="ownerContext">
                    <Authorized>
                        <li class="nav-item">
                            <NavLink class="nav-link" href="analysis">
                                <i class="fas fa-chart-line"></i>
                                <span class="ml-2">Beheerder</span>
                            </NavLink>
                        </li>
                        <li class="nav-item">
                            <NavLink class="nav-link" href="settings">
                                <i class="fas fa-cogs"></i>
                                <span class="ml-2">Instellingen</span>
                            </NavLink>
                        </li>
                    </Authorized>
                </AuthorizeView>

            </Authorized>
            <NotAuthorized>
            </NotAuthorized>
        </AuthorizeView>
    </ul>
</div>

@code {
    private bool _storageDropdownOpen = false;
    private bool _inventoryDropdownOpen = false;

    private void ToggleStorageDropdown()
    {
        _storageDropdownOpen = !_storageDropdownOpen;
    }

    private void CloseStorageDropdown()
    {
        _storageDropdownOpen = false;
    }

    private void ToggleInventoryDropdown()
    {
        _inventoryDropdownOpen = !_inventoryDropdownOpen;
    }

    private void CloseInventoryDropdown()
    {
        _inventoryDropdownOpen = false;
    }
}
